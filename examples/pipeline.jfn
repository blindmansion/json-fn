// A tiny typed pipeline: fold a stream of transforms over a list of numbers.
// Exercises the .jfn type syntax (docs/type-syntax-spec.md) — a discriminated
// union, refinements, array + function types, and curried / rest / object-
// pattern signatures — next to the language's lambdas, `if`/`cond`/`match`,
// `where`, and template strings.
type Nat = integer & min(0)

// Discriminated union: closed objects sharing a `tag`.
type Op =
    { tag: "push",  value: number }
  | { tag: "scale", by: number }
  | { tag: "keep",  above: number }
  | { tag: "clamp", lo: number, hi: number }
  | { tag: "take",  n: Nat }
  | { tag: "sort" }

// Curried return type + object-pattern parameter: a reusable clamp closure.
clampTo: ({ lo, hi }: { lo: number, hi: number }) -> (number) -> number =>
  (x) => if x < lo then lo else if x > hi then hi else x

// `match` arms narrow the union, so `op.value` / `op.by` / … resolve per case.
step: (xs: number[], op: Op) -> number[] => match op.tag {
  "push":  concat(xs, [op.value]),
  "scale": map((x) => x * op.by, xs),
  "keep":  filter((x) => x > op.above, xs),
  "clamp": map((x) => clampTo({ lo: op.lo, hi: op.hi })(x), xs),
  "take":  slice(xs, 0, op.n),
  else:    sort((a, b) => a - b, xs)
}

run:   (ops: Op[]) -> number[] => reduce((xs, op) => step(xs, op), [], ops)
total: (xs: number[]) -> number => reduce((a, x) => a + x, 0, xs)

// `match` on the discriminant: the arms need no variant-specific fields.
label: (op: Op) -> string => match op.tag {
  "push":  "push",
  "scale": "scale",
  "keep":  "keep",
  "clamp": "clamp",
  "take":  "take",
  else:    "sort"
}

// Rest parameter: fold any number of trailing lines into one block.
report: (title: string, ...lines: string[]) -> string =>
  join(concat([title], lines), "\n")

summary: (ops: Op[]) -> string =>
  report(header,
         `steps: ${join(map((op) => label(op), ops), " -> ")}`,
         `out:   [${join(map((x) => str(x), out), ", ")}]`,
         `sum:   ${str(total(out))}`) where {
    out:    run(ops),
    header: `pipeline of ${str(length(ops))} op(s):`
  }

demo: () -> { result: number[], sum: number, report: string } => {
  result: run(ops),
  sum:    total(run(ops)),
  report: summary(ops)
} where {
  ops: [
    { tag: "push",  value: 3 },
    { tag: "push",  value: 10 },
    { tag: "push",  value: 7 },
    { tag: "push",  value: 1 },
    { tag: "scale", by: 2 },
    { tag: "keep",  above: 5 },
    { tag: "clamp", lo: 0, hi: 15 },
    { tag: "sort" },
    { tag: "take",  n: 3 }
  ]
}
