{
  // ---- The map: plain JSON all the way down ------------------------------
  // Rooms are inert data. Nothing here knows how to *do* anything; behavior
  // lives entirely in the functions below, so the world could be loaded,
  // diffed, or generated like any other JSON value.

  world: raw {
    "cell": {
      "name": "Damp Cell",
      "blurb": "Moss, straw, and a door someone forgot to lock properly.",
      "exits": { "north": "hall" },
      "item": "rusty key"
    },
    "hall": {
      "name": "Torchlit Hall",
      "blurb": "Portraits of jailers past glare down at you.",
      "exits": { "south": "cell", "east": "gate" },
      "item": "old boot"
    },
    "gate": {
      "name": "Iron Gate",
      "blurb": "Beyond the bars: weather. Freedom smells like rain.",
      "exits": { "west": "hall" },
      "item": null
    }
  },

  // ---- Pure game logic ----------------------------------------------------
  // Player state is a record { at, held }; every turn returns a fresh
  // { state, message, done } — no mutation anywhere.

  roomOf: (st) => world[st.at],

  look: (st) => `${room.name} — ${room.blurb}${note}` where {
    room: roomOf(st),
    seen: !isNull(room.item) && !includes(st.held, room.item),
    note: if seen then ` You see a ${room.item}.` else ""
  },

  stay: (st, msg) => { state: st, message: msg, done: false },

  move: (st, dir) => cond {
    isNull(dir)  -> stay(st, "Go where? Try \"go north\"."),
    isNull(dest) -> stay(st, `There is no exit "${dir}".`),
    else         -> stay(next, look(next))
  } where {
    dest: roomOf(st).exits[dir],
    next: { at: dest, held: st.held }
  },

  take: (st) => (if isNull(item) || includes(st.held, item)
    then stay(st, "There is nothing here worth taking.")
    else stay(richer, `You pocket the ${item}.`)) where {
    item: roomOf(st).item,
    richer: { at: st.at, held: concat(st.held, [item]) }
  },

  unlock: (st) => cond {
    st.at != "gate" -> stay(st, "Nothing here is locked."),
    includes(st.held, "rusty key") ->
      { state: st, message: "The key grinds, the gate swings wide. You are free!", done: true },
    else -> stay(st, "The gate is locked. A key would help.")
  },

  // One command -> one turn. The verb is data, dispatched by `match`;
  // tokenizing mirrors the calculator's whitespace-splitting trick.
  step: (st, cmd) => match verb {
    "look"   -> stay(st, look(st)),
    "go"     -> move(st, parts[1]),
    "take"   -> take(st),
    "unlock" -> unlock(st),
    else     -> stay(st, `You try to "${verb}", but the dungeon is unimpressed.`)
  } where {
    parts: filter((w) => w != "", reSplit("\\s+", cmd)),
    verb: parts[0]
  },

  // ---- IO as a capability record -------------------------------------------
  // The loop never touches `perform` by name for input/output; it holds this
  // narrow interface, which an outer handler is free to interpret however it
  // likes (a terminal, a test script, a chat bot...).

  io: () => {
    ask: () => perform("input", []),
    say: (msg) => perform("print", [msg])
  },

  // ---- The game loop: straight-line do-notation ----------------------------

  play: (st) => do {
    _   <- io().say(look(st)),
    cmd <- io().ask(),
    if isNull(cmd)
      then pure("The narrator ran out of script mid-dungeon.")
      else playTurn(st, cmd)
  },

  playTurn: (st, cmd) => do {
    _ <- io().say(turn.message),
    if turn.done then pure(turn.message) else play(turn.state)
  } where {
    turn: step(st, cmd)
  },

  // ---- A bidirectional scripted handler -------------------------------------
  // One handler, two effects, one threaded state record: `input` consumes the
  // pending script, `print` appends to the transcript. Same function-awaiting-
  // state trick as `withState`, just with a record instead of a bare value.

  runScript: (cmds, task) => (handle task with {
    input: (resume) => (s) => (resume(cmd))(rest) where {
      empty: length(s.pending) == 0,
      cmd:   if empty then null else head(s.pending),
      rest:  { pending: if empty then [] else tail(s.pending), transcript: s.transcript }
    },
    print: (msg, resume) => (s) =>
      (resume(null))({ pending: s.pending, transcript: concat(s.transcript, [msg]) }),
    return: (v) => (s) => { ending: v, transcript: s.transcript }
  })({ pending: cmds, transcript: [] }),

  // ---- Demos -----------------------------------------------------------------

  // A full playthrough, including one wrong turn and one pointless verb.
  demoEscape: () => runScript(script, play(start)) where {
    start: { at: "cell", held: [] },
    script: [
      "take",          // rusty key
      "go up",         // no such exit
      "go north",      // hall
      "sing",          // the dungeon is unimpressed
      "take",          // old boot, why not
      "go east",       // gate
      "unlock"         // freedom
    ]
  },

  // The same game, starved of input: the loop ends gracefully via the
  // handler's `null` sentinel instead of crashing.
  demoSilence: () => runScript([], play({ at: "cell", held: [] })),

  // Dry-run flavor: count how chatty a playthrough is without caring what it
  // says — a wildcard handler that only tallies `print`s and feeds `input`
  // from a closed-over script would go here; left as an exercise for the
  // hypothetical reader of this hypothetical language.

  demo: () => {
    escape:  demoEscape(),
    silence: demoSilence()
  }
}
