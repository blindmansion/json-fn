{
  otherPlayer: (player) => if player == "X" then "O" else "X",
  validMove: (board, pos) => isNull(board[pos]),
  makeMove: (board, pos, player) => setAt(board, pos, player),
  checkLine: (board, player, line) => every((pos) => board[pos] == player, line),
  checkWin: (board, player) => some((line) => checkLine(board, player, line), lines) where {
    lines: raw [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]
  },
  isBoardFull: (board) => !includes(board, null),
  getStatus: (board) => cond {
    xWins -> "X",
    oWins -> "O",
    full -> "draw",
    else -> "playing"
  } where {
    xWins: checkWin(board, "X"),
    oWins: checkWin(board, "O"),
    full: isBoardFull(board)
  },
  playMove: (state, pos) => (if canMove then {
    board: newBoard,
    turn: nextTurn,
    status: newStatus
  } else state) where {
    board: state.board,
    turn: state.turn,
    currentStatus: state.status,
    stillPlaying: currentStatus == "playing",
    valid: validMove(board, pos),
    canMove: and(stillPlaying, valid),
    newBoard: makeMove(board, pos, turn),
    newStatus: getStatus(newBoard),
    nextTurn: otherPlayer(turn)
  },
  minimax: (board, depth, isMaximizing, aiPlayer) => cond {
    aiWins -> 10 - depth,
    opponentWins -> depth - 10,
    gameOver -> 0,
    isMaximizing -> maxScore,
    else -> minScore
  } where {
    opponent: otherPlayer(aiPlayer),
    status: getStatus(board),
    gameOver: status != "playing",
    aiWins: and(gameOver, status == aiPlayer),
    opponentWins: and(gameOver, status == opponent),
    currentPlayer: if isMaximizing then aiPlayer else opponent,
    emptyPos: filter((pos) => validMove(board, pos), range(9)),
    scores: map((pos) => minimax(makeMove(board, pos, currentPlayer), depth + 1, !isMaximizing, aiPlayer), emptyPos),
    maxScore: max(scores),
    minScore: min(scores)
  },
  bestMove: (board, aiPlayer) => best.pos where {
    emptyPos: filter((pos) => validMove(board, pos), range(9)),
    best: reduce((acc, pos) => (if score > bestScore then {
      score: score,
      pos: pos
    } else acc) where {
      newBoard: makeMove(board, pos, aiPlayer),
      score: minimax(newBoard, 1, false, aiPlayer),
      bestScore: acc.score
    }, {
      score: -100,
      pos: -1
    }, emptyPos)
  }
}
