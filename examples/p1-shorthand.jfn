// p1-shorthand.jfn — exercises the two P1 items from docs/shorthand-action-items.md.
//
// P1a: function-valued parameter calls — `f(x)` where `f` is a param/local.
// P1b: expression-level `where` — `expr where { ... }` attached to binding
//      values, cond/match arms, and if/then/else branches (not just fn bodies).
//
// Run with: bun run typescript/examples/p1-shorthand.ts

{
  inc: (n) => n + 1,
  dbl: (n) => n * 2,

  // ---- P1a: function-valued parameter calls ----

  // The canonical combinators from the doc.
  twice:   (f) => (x) => f(f(x)),
  compose: (f, g) => (x) => f(g(x)),

  twiceInc:    () => twice(inc)(5),          // inc(inc(5)) = 7
  composeTest: () => compose(dbl, inc)(5),   // dbl(inc(5)) = 12

  // A param called directly, nested inside another combinator.
  applyTo:  (f, x) => f(x),
  applyToTest: () => applyTo(dbl, 21),       // 42

  // ---- P1b: expression-level `where` ----

  // where attached to a binding VALUE (nested where in a where-binding).
  nestedWhere: (n) => r where {
    r: (a * 2) where { a: n + 1 }            // (n+1)*2
  },
  nestedWhereTest: () => nestedWhere(3),     // (3+1)*2 = 8

  // where as a function body (multiple locals, free var `n` captured).
  valueWhere: (n) => (a * b) where { a: n + 1, b: n + 2 },
  valueWhereTest: () => valueWhere(3),       // 4*5 = 20

  // where inside a parenthesized grouping (used as one operand of `+`).
  parenWhere: (n) => 1 + ((a * b) where { a: n + 1, b: n + 2 }),
  parenWhereTest: () => parenWhere(3),       // 1 + 4*5 = 21

  // where attached to an if/then/else branch.
  ifBranchWhere: (n) => if n > 0
    then (base + 1) where { base: n * 10 }
    else 0,
  ifBranchWhereTest: () => ifBranchWhere(4), // 4*10 + 1 = 41

  // where attached to a cond arm result.
  condArmWhere: (n) => cond {
    n > 10 -> (big * 2) where { big: n + 100 },
    else   -> 0
  },
  condArmWhereTest: () => condArmWhere(11)   // (11+100)*2 = 222
}
