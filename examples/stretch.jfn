{
  adder: (a) => (b) => a + b,
  curryPartial: () => adder(10),
  curryFull: () => adder(10)(5),
  chainedCall: () => adder(3)(4),
  twice: (f) => (x) => f(f(x)),
  applyTwice: () => twice((n) => n + 1)(0),
  iife: () => ((x) => x * x)(9),
  compose: (f, g) => (x) => f(g(x)),
  composed: () => compose((n) => n + 1, (n) => n * 2)(10),
  dbl: (n) => n * 2,
  bareRef: (xs) => map(dbl, xs),
  partialMapper: (xs) => map(adder(1), xs),
  mapIndexed: (xs) => map((x, i) => [i, x], xs),

  keepEvens: (xs) => filter((x) => x % 2 == 0, xs),
  total: (xs) => reduce((acc, x) => acc + x, 0, xs),
  everyPos: (xs) => every((x) => x > 0, xs),
  findBig: (xs) => find((x) => x > 100, xs),
  sumOf: (xs) => sum(xs),
  maxOf: (xs) => max(xs),
  minOf: (xs) => min(xs),
  absOf: (n) => abs(n),
  roundOf: (x) => round(x),
  sqrtOf: (x) => sqrt(x),
  powOf: (a, b) => pow(a, b),
  sortOf: (xs) => sort(xs),
  sortByAge: (xs) => sortBy((x) => x.age, xs),
  uniqueOf: (xs) => unique(xs),
  flattenOf: (xss) => flatten(xss),
  zipOf: (a, b) => zip(a, b),
  takeOf: (xs, n) => take(xs, n),
  dropOf: (xs, n) => drop(xs, n),
  headOf: (xs) => head(xs),
  tailOf: (xs) => tail(xs),
  lastOf: (xs) => last(xs),
  countOf: (xs) => count((x) => x > 0, xs),

  splitWords: (s) => split(s, " "),
  replaceOf: (s) => replace(s, "a", "b"),
  padOf: (n) => padStart(str(n), 3, "0"),
  repeatOf: (s, n) => repeat(s, n),
  startsOf: (s) => startsWith(s, "http"),
  charAtOf: (s, i) => s[i],
  strPlus: (a, b) => a + b,
  strIncludes: (s) => includes(s, "x"),

  keysOf: (obj) => keys(obj),
  valuesOf: (obj) => values(obj),
  entriesOf: (obj) => entries(obj),
  dynGet: (obj, k) => obj[k],
  missingKey: (obj) => obj.nope,
  deepEq: (a, b) => a == b,
  sameArr: () => [1, 2, 3] == [1, 2, 3],

  orDefault: (a, b) => if a then a else b,
  notOf: (x) => !x,
  halfOf: (n) => n / 2,
  negMod: (a, b) => a % b,

  matchVar: (x, y) => match x {
    y -> "matched y",
    else -> "no match"
  },
  matchNum: (n) => match n {
    1 -> "one",
    2 -> "two",
    else -> "many"
  },
  matchBool: (b) => match b {
    true -> "yes",
    false -> "no",
    else -> "other"
  },
  condNoElse: (n) => cond {
    n > 0 -> "positive"
  },

  namespace: {
    inc: (n) => n + 1,
    dec: (n) => n - 1
  },
  useNamespace: (n) => namespace.inc(n),

  shadowTest: (n) => inner where {
    adder: (x) => x - 100,
    inner: adder(n)
  },
  mutualLocal: (n) => isEvenLocal(n) where {
    isEvenLocal: (k) => if k == 0 then true else isOddLocal(k - 1),
    isOddLocal: (k) => if k == 0 then false else isEvenLocal(k - 1)
  },
  letInWhere: (n) => compute(n) where {
    compute: (m) => (a * b) where { a: m + 1, b: m + 2 }
  },
  whereAfterLet: (n) => (base + extra) where {
    base: n * 2,
    extra: 7
  }
}
