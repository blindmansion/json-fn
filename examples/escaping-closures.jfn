// escaping-closures.jfn — closures that stay callable after leaving the scope
// that defined the local functions they call.
//
// A json-fn closure is just a returned function body with its free variables
// substituted in. When that body calls an enclosing *local* function by name —
// recursion, mutual recursion, or a sibling `where`-local — capture re-attaches
// that function's closed-over definition onto the returned body. The closure is
// therefore self-contained: it keeps working once it escapes, and it round-trips
// through shorthand as a plain, callable `.jfn` function literal.
//
// Run an entry (returns a concrete value):
//   bun run typescript/src/cli.ts eval --file examples/escaping-closures.jfn --entry sumTo10
// Print a *produced closure* as shorthand (see how capture attaches the locals):
//   bun run typescript/src/cli.ts eval --file examples/escaping-closures.jfn --entry showCountdown --shorthand

{
  // 1. Recursive-closure factory. `makeCountdown` curries the base case; the
  //    returned closure carries its own `go`, so it recurses on its own.
  makeCountdown: (base) => go where {
    go: (x) => if x <= 0 then base else go(x - 1)
  },
  countdownFrom42: () => makeCountdown(42)(3),               // 42
  showCountdown: () => makeCountdown(42),                    // the closure value

  // 2. Mutually-recursive pair returned as one closure, capturing a threshold.
  //    Both `isEven` and `isOdd` travel together (the returned body is `isEven`,
  //    which calls `isOdd`, which calls `isEven`).
  makeParity: (limit) => isEven where {
    isEven: (n) => if n == 0 then true else if n > limit then "too big" else isOdd(n - 1),
    isOdd: (n) => if n == 0 then false else isEven(n - 1)
  },
  isTenEven: () => makeParity(100)(10),                      // true
  isSevenEven: () => makeParity(100)(7),                     // false
  overLimit: () => makeParity(5)(9),                         // "too big"
  showParity: () => makeParity(100),                         // the closure value

  // 3. `map` building a list of *distinct* recursive closures — each bakes in
  //    its own multiplier `k` and its own copy of `scale`.
  scalers: () => map((k) => (n) => scale(n) where {
    scale: (x) => if x <= 0 then 0 else k + scale(x - 1)
  }, [2, 10, 100]),                                          // list of 3 closures
  runScalers: () => map((f) => f(3), scalers()),             // [6, 30, 300]

  // 4. Three enclosing scopes, all captured into one recursive closure.
  triScope: (a) => (b) => (c) => walk where {
    walk: (n) => if n <= 0 then a + b + c else walk(n - 1)
  },
  triScopeResult: () => triScope(1)(20)(300)(4),             // 321
  showTriScope: () => triScope(1)(20)(300),                  // the closure value

  // 5. Deferred recursion — a closure that returns a recursive closure two
  //    levels down. The recursion (`countUp`) only materializes at the inner
  //    lambda, capturing `seed` along the way.
  makeCounter: (seed) => (step) => countUp where {
    countUp: (n) => if n >= seed then [] else concat([n], countUp(n + step))
  },
  countBy2: () => makeCounter(10)(2)(0),                     // [0, 2, 4, 6, 8]
  showCounter: () => makeCounter(10)(2),                     // the closure value

  // 6. Higher-order recursion — a `foldr` closed over a captured operator and
  //    identity. In shorthand, `&add` in argument position evaluates to the
  //    name `add`, which travels into the closure and prints back as `+`.
  makeFold: (op, init) => (xs) => foldr(xs) where {
    foldr: (ys) => if length(ys) == 0 then init else op(head(ys), foldr(tail(ys)))
  },
  sumTo10: () => makeFold(add, 0)([1, 2, 3, 4]),             // 10
  productTo120: () => makeFold(mul, 1)([1, 2, 3, 4, 5]),     // 120
  showFold: () => makeFold(add, 0)                           // the closure value
}
