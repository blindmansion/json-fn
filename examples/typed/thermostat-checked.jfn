// The checkable cousin of examples/typed/thermostat.jfn — same thermostat controller,
// same runtime behavior, but massaged to pass `jfn check` cleanly *today*.
//
// The goal file is written the way the type syntax *wants* to be used; this one
// keeps every construct the checker already handles well and works around the
// gaps it still hits (all catalogued in todo/typecheck-findings.md). The domain
// is fully typed — `Config`/`Reading`/`State`/`Mode` records, the `Action`/`Fault`
// discriminated unions, a typed `Device` capability record — and, now that the
// effect kernel carries `Task`-typed floors (`perform`/`pure`/`raise`/`bind` all
// return `Task`), the effect boundary is typed too: `-> Task` on the `Device`
// methods, `dev`, `actuate`, and `loop`. Three deltas from the goal remain, one
// per still-open gap:
//
//   1. `match` doesn't narrow a discriminated union (only `if`/`cond` do), so
//      `apply`/`describe`/`actuate` dispatch with `cond` on `.tag` — which then
//      lets `describe` read the shared `act.fault.tag` directly (no helper).
//   2. A `do`-block with a local `let` binding erases to `any` (the inline scope
//      it lowers to loses its `$return` type), so `onReading` hoists its `action`
//      let into a `where`, leaving a let-free `do` that keeps its `Task` type.
//   3. `handle` erases to `any` (its result is handler-dependent), so `runScript`
//      returns the bare `any` keyword rather than a named `Report`.
//
// Behavior is identical to the goal — same transcript, same fault ending:
//   bun run typescript/src/cli.ts eval --file examples/typed/thermostat-checked.jfn --entry demo
//   bun run typescript/src/cli.ts check --file examples/typed/thermostat-checked.jfn
{
  // ----- domain types -------------------------------------------------------
  type Celsius = number,
  type Percent = integer & min(0) & max(100),
  type Mode    = "heat" | "cool" | "off",

  type Config  = { target: Celsius, tolerance: number },
  type Reading = { temp: Celsius, battery: Percent },
  type State   = { config: Config, mode: Mode },

  type Fault =
      { tag: "OutOfRange", temp: Celsius }
    | { tag: "LowBattery" },

  type Action =
      { tag: "hold" }
    | { tag: "switch", to: Mode }
    | { tag: "alarm",  fault: Fault },

  // An opaque effect description (`$defs/Task`: a tagged `@task` object).
  // `perform`/`pure`/`raise` now carry this as their return type, so a function
  // whose body is directly one of them can be annotated `-> Task`.
  type Task = { "@task": string, ... },

  // ----- pure control logic -------------------------------------------------

  // One reading -> one action. `cond` arms guard the sensor first (dead battery,
  // implausible temperature), then steer toward `target` within `tolerance`.
  decide: (cfg: Config, mode: Mode, reading: Reading) -> Action => cond {
    reading.battery == 0                        -> { tag: "alarm", fault: { tag: "LowBattery" } },
    reading.temp < -40 || reading.temp > 60     -> { tag: "alarm", fault: { tag: "OutOfRange", temp: reading.temp } },
    reading.temp < cfg.target - cfg.tolerance   -> if mode == "heat" then { tag: "hold" } else { tag: "switch", to: "heat" },
    reading.temp > cfg.target + cfg.tolerance   -> if mode == "cool" then { tag: "hold" } else { tag: "switch", to: "cool" },
    mode != "off"                               -> { tag: "switch", to: "off" },
    else                                        -> { tag: "hold" }
  },

  // Fold an action into the state. `cond` on `.tag` narrows the union so the
  // `switch` arm can read `act.to`; `match` would leave it `any` (gap #1).
  apply: (st: State, act: Action) -> State => cond {
    act.tag == "switch" -> { config: st.config, mode: act.to },
    else                -> st
  },

  // A human-readable transcript line for one action + the reading behind it.
  // The `cond` narrows `act` per arm, so reading the shared discriminant off the
  // narrowed `Fault` union (`act.fault.tag`) now projects to its literal union.
  describe: (act: Action, reading: Reading) -> string => cond {
    act.tag == "switch" -> `${str(reading.temp)}C bat${str(reading.battery)}% -> ${act.to}`,
    act.tag == "alarm"  -> `${str(reading.temp)}C bat${str(reading.battery)}% -> ALARM ${act.fault.tag}`,
    else                -> `${str(reading.temp)}C bat${str(reading.battery)}% -> hold`
  },

  // ----- IO as a typed capability record ------------------------------------
  // The loop never names `perform`; it holds this narrow `Device` interface,
  // which an outer handler is free to interpret however it likes.
  dev: () -> Device => {
    read: () -> Task => perform("sensor.read", []),
    set:  (mode: Mode) -> Task => perform("hvac.set", [mode]),
    log:  (msg: string) -> Task => perform("log", [msg])
  },

  // A typed capability record. Its methods return `Task` (their bodies are bare
  // `perform` calls). Only `bind`/`handle`-bodied functions still fall to `any`.
  type Device = {
    read: () -> Task,
    set:  (Mode) -> Task,
    log:  (string) -> Task
  },

  // Turn an action into its effect. `alarm` escalates as a typed `raise`, so an
  // outer handler decides recovery; everything else pokes the HVAC (or nothing).
  actuate: (action: Action) -> Task => cond {
    action.tag == "switch" -> dev().set(action.to),
    action.tag == "alarm"  -> raise(action.fault),
    else                   -> pure(null)
  },

  // ----- the control loop: straight-line do-notation ------------------------

  // `action` is bound in a `where`, not as a `do`-local: a `do` with a `let`
  // binding lowers to an inline scope-call that erases to `any` (gap #2), so the
  // `do` is kept let-free to preserve its `Task` type.
  onReading: (st: State, reading: Reading) -> Task => do {
    _ <- dev().log(describe(action, reading)),
    _ <- actuate(action),
    pure(apply(st, action))
  } where { action: decide(st.config, st.mode, reading) },

  // Read the sensor up to `fuel` times. A `null` reading (the sensor is out of
  // data) ends the run gracefully with the final state.
  loop: (st: State, fuel: integer) -> Task =>
    if fuel <= 0
      then pure(st)
      else bind(dev().read(), (reading) =>
        if isNull(reading)
          then pure(st)
          else bind(onReading(st, reading), (next) => loop(next, fuel - 1))),

  // ----- a scripted, in-language handler ------------------------------------
  // One handler, three effects, one threaded record: `sensor.read` consumes the
  // pending readings, `hvac.set`/`log` append to the transcript, `raise` ends
  // the run with the fault tag. `handle` erases to `any` (its result is genuinely
  // handler-dependent), so `runScript`'s return can't be a named `Report` yet;
  // the `task` param, though, is now the concrete `Task` that `loop` returns.
  runScript: (readings: Reading[], task: Task) -> any => (handle task with {
    "sensor.read": (resume) => (s) => (resume(next))(rest) where {
      empty: length(s.pending) == 0,
      next:  if empty then null else head(s.pending),
      rest:  { pending: if empty then [] else tail(s.pending), out: s.out }
    },
    "hvac.set": (mode, resume) => (s) =>
      (resume(null))({ pending: s.pending, out: concat(s.out, [`hvac := ${mode}`]) }),
    "log": (msg, resume) => (s) =>
      (resume(null))({ pending: s.pending, out: concat(s.out, [msg]) }),
    raise: (fault, resume) => (s) => { ending: fault.tag, out: s.out },
    return: (v) => (s) => { ending: v, out: s.out }
  })({ pending: readings, out: [] }),

  // ----- demos --------------------------------------------------------------

  // A full run: cold -> heat, settle -> off, hot -> cool, settle -> off.
  demoRun: () => runScript(script, loop(start, 10)) where {
    start: { config: { target: 21, tolerance: 1.5 }, mode: "off" },
    script: [
      { temp: 18, battery: 90 },
      { temp: 20, battery: 88 },
      { temp: 24, battery: 85 },
      { temp: 21, battery: 84 }
    ]
  },

  // A run that trips a fault: an implausible reading `raise`s OutOfRange, which
  // the handler turns into a fault-tagged ending instead of a state.
  demoFault: () => runScript(
    [{ temp: 99, battery: 50 }],
    loop({ config: { target: 21, tolerance: 1.5 }, mode: "off" }, 10)
  ),

  demo: () => {
    run:   demoRun(),
    fault: demoFault()
  }
}
