{
  "name": "json-fn",
  "bin": {
    "jfn": "src/cli.ts"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "cli": "bun run src/cli.ts",
    "perf": "bun run perf/run.ts",
    "check": "bunx tsc --noEmit && oxlint && oxfmt --check && bun run format:spec-cases:check",
    "fix": "bun run fix:typescript && bun run format:spec-cases",
    "fix:typescript": "bunx tsc --noEmit && oxlint --fix && oxfmt",
    "generate:builtins-doc": "bun run scripts/generate-builtin-doc.ts",
    "generate:hash-cases": "bun run scripts/generate-hash-cases.ts && bun run format:spec-cases",
    "generate:parse-depth-cases": "bun run scripts/generate-parse-depth-cases.ts",
    "instrument:durable": "bun run scripts/instrument-durable.ts",
    "format:spec-cases": "cd .. && bun run typescript/scripts/collapse-json-whitespace.ts 'spec/cases/**/*.json' && ./typescript/node_modules/.bin/oxfmt 'spec/cases/**/*.json' '!spec/cases/parse/structural-depth.json'",
    "format:spec-cases:check": "cd .. && bun -e 'JSON.parse(await Bun.file(\"spec/cases/parse/structural-depth.json\").text())' && ./typescript/node_modules/.bin/oxfmt --check 'spec/cases/**/*.json' '!spec/cases/parse/structural-depth.json'"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
