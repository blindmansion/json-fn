{
  "description": "program shape (shorthand spec section 9)",
  "mode": "module",
  "cases": [
    {
      "description": "registry object of named functions",
      "source": "otherColor: (color) => if color == \"w\" then \"b\" else \"w\",\npieceType:  (piece) => upper(piece)",
      "expected": {
        "otherColor": {
          "$params": ["color"],
          "$return": {
            "$if": { "$call": "eq", "$args": [{ "$var": "color" }, "w"] },
            "$then": "b",
            "$else": "w"
          }
        },
        "pieceType": {
          "$params": ["piece"],
          "$return": { "$call": "upper", "$args": [{ "$var": "piece" }] }
        }
      }
    }
  ]
}
