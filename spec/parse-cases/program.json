{
  "description": "program shape (shorthand spec section 9)",
  "cases": [
    {
      "description": "registry object of named functions",
      "source": "{\n  otherColor: (color) => if color == \"w\" then \"b\" else \"w\",\n  pieceType:  (piece) => upper(piece)\n}",
      "expected": {
        "otherColor": {
          "$params": ["color"],
          "$return": { "$if": { "$eq": [{ "$var": "color" }, "w"] }, "$then": "b", "$else": "w" }
        },
        "pieceType": {
          "$params": ["piece"],
          "$return": { "$call": "upper", "$args": [{ "$var": "piece" }] }
        }
      }
    }
  ]
}
