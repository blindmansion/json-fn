{
  "description": "operators and precedence (shorthand spec section 6)",
  "cases": [
    {
      "description": "arithmetic precedence (* binds tighter than +)",
      "source": "row * 8 + col",
      "expected": {
        "$call": "add",
        "$args": [{ "$call": "mul", "$args": [{ "$var": "row" }, 8] }, { "$var": "col" }]
      }
    },
    {
      "description": "unary not",
      "source": "!done",
      "expected": { "$call": "not", "$args": [{ "$var": "done" }] }
    },
    {
      "description": "unary negation of variable",
      "source": "-x",
      "expected": { "$call": "neg", "$args": [{ "$var": "x" }] }
    },
    {
      "description": "unary negation of literal folds to negative number",
      "source": "-5",
      "expected": -5
    },
    {
      "description": "logical and flattens across comparisons",
      "source": "x > 0 && x < 100",
      "expected": {
        "$and": [
          { "$call": "gt", "$args": [{ "$var": "x" }, 0] },
          { "$call": "lt", "$args": [{ "$var": "x" }, 100] }
        ]
      }
    },
    {
      "description": "logical and flattens chained operands",
      "source": "a && b && c",
      "expected": { "$and": [{ "$var": "a" }, { "$var": "b" }, { "$var": "c" }] }
    },
    {
      "description": "logical or",
      "source": "cached || compute(x)",
      "expected": {
        "$or": [{ "$var": "cached" }, { "$call": "compute", "$args": [{ "$var": "x" }] }]
      }
    },
    { "description": "comparisons are non-associative", "source": "a < b < c", "error": true },
    {
      "description": "concat operator flattens",
      "source": "a ++ b ++ c",
      "expected": {
        "$call": "strcat",
        "$args": [{ "$var": "a" }, { "$var": "b" }, { "$var": "c" }]
      }
    },
    {
      "description": "template with leading text",
      "source": "`Illegal move: ${moveDesc}`",
      "expected": { "$call": "strcat", "$args": ["Illegal move: ", { "$var": "moveDesc" }] }
    },
    {
      "description": "template with interleaved literals",
      "source": "`${firstName} ${lastName}`",
      "expected": {
        "$call": "strcat",
        "$args": [{ "$var": "firstName" }, " ", { "$var": "lastName" }]
      }
    },
    {
      "description": "template with single interpolation normalizes away strcat",
      "source": "`${x}`",
      "expected": { "$var": "x" }
    },
    {
      "description": "template with no interpolation normalizes to a string",
      "source": "`hello`",
      "expected": "hello"
    }
  ]
}
