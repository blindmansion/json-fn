{
  "description": "variables and property access (shorthand spec section 5)",
  "cases": [
    { "description": "bare variable", "source": "x", "expected": { "$var": "x" } },
    {
      "description": "single dotted access",
      "source": "a.b",
      "expected": { "$var": "a", "$get": "b" }
    },
    {
      "description": "chained dotted access",
      "source": "a.b.c",
      "expected": { "$var": "a", "$get": ["b", "c"] }
    },
    {
      "description": "numeric index",
      "source": "a[0]",
      "expected": { "$var": "a", "$get": 0 }
    },
    {
      "description": "dynamic index",
      "source": "a[i]",
      "expected": { "$var": "a", "$get": { "$var": "i" } }
    },
    {
      "description": "access off a call result uses $from",
      "source": "f(x).b",
      "expected": { "$get": "b", "$from": { "$fn": ["f", { "$var": "x" }] } }
    },
    {
      "description": "mixed dotted and numeric access collapses",
      "source": "a.b[0].c",
      "expected": { "$var": "a", "$get": ["b", 0, "c"] }
    },
    {
      "description": "dynamic index after dotted access uses $from",
      "source": "a.b[i]",
      "expected": { "$get": { "$var": "i" }, "$from": { "$var": "a", "$get": "b" } }
    }
  ]
}
