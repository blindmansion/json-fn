{
  "description": "calls and references (shorthand spec section 4)",
  "cases": [
    {
      "description": "named call",
      "source": "add(3, 4)",
      "expected": { "$call": "add", "$args": [3, 4] }
    },
    { "description": "nullary call", "source": "f()", "expected": { "$call": "f", "$args": [] } },
    {
      "description": "call target from parenthesized variable",
      "source": "(fnName)(3, 4)",
      "expected": { "$call": { "$var": "fnName" }, "$args": [3, 4] }
    },
    {
      "description": "immediately-invoked function literal",
      "source": "((x) => x * x)(5)",
      "expected": {
        "$call": {
          "$params": ["x"],
          "$return": { "$call": "mul", "$args": [{ "$var": "x" }, { "$var": "x" }] }
        },
        "$args": [5]
      }
    },
    {
      "description": "function reference by name",
      "source": "&double",
      "expected": { "$fn": "double" }
    },
    {
      "description": "function reference as argument",
      "source": "map(&double, nums)",
      "expected": { "$call": "map", "$args": [{ "$fn": "double" }, { "$var": "nums" }] }
    },
    {
      "description": "function reference from parenthesized expression",
      "source": "&(expr)",
      "expected": { "$fn": { "$var": "expr" } }
    },
    {
      "description": "method call: access chain in call position is a call on the evaluated callee",
      "source": "caps.db.query(sql)",
      "expected": {
        "$call": { "$get": ["db", "query"], "$from": { "$var": "caps" } },
        "$args": [{ "$var": "sql" }]
      }
    },
    {
      "description": "zero-arg method call",
      "source": "io.readLine()",
      "expected": { "$call": { "$get": "readLine", "$from": { "$var": "io" } }, "$args": [] }
    },
    {
      "description": "single-dot method call",
      "source": "obj.method(x)",
      "expected": {
        "$call": { "$get": "method", "$from": { "$var": "obj" } },
        "$args": [{ "$var": "x" }]
      }
    },
    {
      "description": "computed-key method call",
      "source": "caps[name](x)",
      "expected": {
        "$call": { "$get": { "$var": "name" }, "$from": { "$var": "caps" } },
        "$args": [{ "$var": "x" }]
      }
    },
    {
      "description": "method call on a call result uses $from callee",
      "source": "f(x).method(y)",
      "expected": {
        "$call": { "$get": "method", "$from": { "$call": "f", "$args": [{ "$var": "x" }] } },
        "$args": [{ "$var": "y" }]
      }
    },
    {
      "description": "chained application: a call in call position calls its result",
      "source": "makeCountdown(42)(3)",
      "expected": { "$call": { "$call": "makeCountdown", "$args": [42] }, "$args": [3] }
    }
  ]
}
