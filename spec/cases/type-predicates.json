{
  "description": "type predicates",
  "cases": [
    {
      "description": "isBool: true for true",
      "body": { "$return": { "$fn": ["isBool", true] } },
      "expected": true
    },
    {
      "description": "isBool: true for false",
      "body": { "$return": { "$fn": ["isBool", false] } },
      "expected": true
    },
    {
      "description": "isBool: false for number",
      "body": { "$return": { "$fn": ["isBool", 42] } },
      "expected": false
    },
    {
      "description": "isBool: false for string",
      "body": { "$return": { "$fn": ["isBool", "hello"] } },
      "expected": false
    },
    {
      "description": "isBool: false for null",
      "body": { "$return": { "$fn": ["isBool", null] } },
      "expected": false
    },
    {
      "description": "isBool: false for array",
      "body": {
        "$return": { "$fn": ["isBool", [1, 2]] }
      },
      "expected": false
    },
    {
      "description": "isBool: false for object",
      "body": {
        "$return": { "$fn": ["isBool", { "a": 1 }] }
      },
      "expected": false
    },
    {
      "description": "isNumber: true for integer",
      "body": { "$return": { "$fn": ["isNumber", 42] } },
      "expected": true
    },
    {
      "description": "isNumber: true for decimal",
      "body": { "$return": { "$fn": ["isNumber", 3.14] } },
      "expected": true
    },
    {
      "description": "isNumber: true for zero",
      "body": { "$return": { "$fn": ["isNumber", 0] } },
      "expected": true
    },
    {
      "description": "isNumber: true for negative",
      "body": { "$return": { "$fn": ["isNumber", -7] } },
      "expected": true
    },
    {
      "description": "isNumber: false for string",
      "body": { "$return": { "$fn": ["isNumber", "42"] } },
      "expected": false
    },
    {
      "description": "isNumber: false for boolean",
      "body": { "$return": { "$fn": ["isNumber", true] } },
      "expected": false
    },
    {
      "description": "isNumber: false for null",
      "body": { "$return": { "$fn": ["isNumber", null] } },
      "expected": false
    },
    {
      "description": "isString: true for non-empty string",
      "body": { "$return": { "$fn": ["isString", "hello"] } },
      "expected": true
    },
    {
      "description": "isString: true for empty string",
      "body": { "$return": { "$fn": ["isString", ""] } },
      "expected": true
    },
    {
      "description": "isString: false for number",
      "body": { "$return": { "$fn": ["isString", 42] } },
      "expected": false
    },
    {
      "description": "isString: false for boolean",
      "body": { "$return": { "$fn": ["isString", true] } },
      "expected": false
    },
    {
      "description": "isString: false for null",
      "body": { "$return": { "$fn": ["isString", null] } },
      "expected": false
    },
    {
      "description": "isString: false for array",
      "body": {
        "$return": { "$fn": ["isString", ["a", "b"]] }
      },
      "expected": false
    },
    {
      "description": "isArray: true for non-empty array",
      "body": {
        "$return": { "$fn": ["isArray", [1, 2, 3]] }
      },
      "expected": true
    },
    {
      "description": "isArray: true for empty array",
      "body": {
        "$return": { "$fn": ["isArray", []] }
      },
      "expected": true
    },
    {
      "description": "isArray: false for object",
      "body": {
        "$return": { "$fn": ["isArray", { "a": 1 }] }
      },
      "expected": false
    },
    {
      "description": "isArray: false for string",
      "body": { "$return": { "$fn": ["isArray", "hello"] } },
      "expected": false
    },
    {
      "description": "isArray: false for number",
      "body": { "$return": { "$fn": ["isArray", 42] } },
      "expected": false
    },
    {
      "description": "isArray: false for null",
      "body": { "$return": { "$fn": ["isArray", null] } },
      "expected": false
    },
    {
      "description": "isArray: false for boolean",
      "body": { "$return": { "$fn": ["isArray", true] } },
      "expected": false
    },
    {
      "description": "type predicates: combined dispatch",
      "body": {
        "val": 42,
        "$return": {
          "$if": { "$fn": ["isNumber", { "$var": "val" }] },
          "$then": "number",
          "$else": {
            "$if": { "$fn": ["isString", { "$var": "val" }] },
            "$then": "string",
            "$else": "other"
          }
        }
      },
      "expected": "number"
    }
  ]
}
