{
  "description": "type predicates",
  "cases": [
    {
      "description": "isBool: true for true",
      "body": {
        "$return": {
          "$call": "isBool",
          "$args": [true]
        }
      },
      "expected": true
    },
    {
      "description": "isBool: true for false",
      "body": {
        "$return": {
          "$call": "isBool",
          "$args": [false]
        }
      },
      "expected": true
    },
    {
      "description": "isBool: false for number",
      "body": {
        "$return": {
          "$call": "isBool",
          "$args": [42]
        }
      },
      "expected": false
    },
    {
      "description": "isBool: false for string",
      "body": {
        "$return": {
          "$call": "isBool",
          "$args": ["hello"]
        }
      },
      "expected": false
    },
    {
      "description": "isBool: false for null",
      "body": {
        "$return": {
          "$call": "isBool",
          "$args": [null]
        }
      },
      "expected": false
    },
    {
      "description": "isBool: false for array",
      "body": {
        "$return": {
          "$call": "isBool",
          "$args": [[1, 2]]
        }
      },
      "expected": false
    },
    {
      "description": "isBool: false for object",
      "body": {
        "$return": {
          "$call": "isBool",
          "$args": [
            {
              "a": 1
            }
          ]
        }
      },
      "expected": false
    },
    {
      "description": "isNumber: true for integer",
      "body": {
        "$return": {
          "$call": "isNumber",
          "$args": [42]
        }
      },
      "expected": true
    },
    {
      "description": "isNumber: true for decimal",
      "body": {
        "$return": {
          "$call": "isNumber",
          "$args": [3.14]
        }
      },
      "expected": true
    },
    {
      "description": "isNumber: true for zero",
      "body": {
        "$return": {
          "$call": "isNumber",
          "$args": [0]
        }
      },
      "expected": true
    },
    {
      "description": "isNumber: true for negative",
      "body": {
        "$return": {
          "$call": "isNumber",
          "$args": [-7]
        }
      },
      "expected": true
    },
    {
      "description": "isNumber: false for string",
      "body": {
        "$return": {
          "$call": "isNumber",
          "$args": ["42"]
        }
      },
      "expected": false
    },
    {
      "description": "isNumber: false for boolean",
      "body": {
        "$return": {
          "$call": "isNumber",
          "$args": [true]
        }
      },
      "expected": false
    },
    {
      "description": "isNumber: false for null",
      "body": {
        "$return": {
          "$call": "isNumber",
          "$args": [null]
        }
      },
      "expected": false
    },
    {
      "description": "isString: true for non-empty string",
      "body": {
        "$return": {
          "$call": "isString",
          "$args": ["hello"]
        }
      },
      "expected": true
    },
    {
      "description": "isString: true for empty string",
      "body": {
        "$return": {
          "$call": "isString",
          "$args": [""]
        }
      },
      "expected": true
    },
    {
      "description": "isString: false for number",
      "body": {
        "$return": {
          "$call": "isString",
          "$args": [42]
        }
      },
      "expected": false
    },
    {
      "description": "isString: false for boolean",
      "body": {
        "$return": {
          "$call": "isString",
          "$args": [true]
        }
      },
      "expected": false
    },
    {
      "description": "isString: false for null",
      "body": {
        "$return": {
          "$call": "isString",
          "$args": [null]
        }
      },
      "expected": false
    },
    {
      "description": "isString: false for array",
      "body": {
        "$return": {
          "$call": "isString",
          "$args": [["a", "b"]]
        }
      },
      "expected": false
    },
    {
      "description": "isArray: true for non-empty array",
      "body": {
        "$return": {
          "$call": "isArray",
          "$args": [[1, 2, 3]]
        }
      },
      "expected": true
    },
    {
      "description": "isArray: true for empty array",
      "body": {
        "$return": {
          "$call": "isArray",
          "$args": [[]]
        }
      },
      "expected": true
    },
    {
      "description": "isArray: false for object",
      "body": {
        "$return": {
          "$call": "isArray",
          "$args": [
            {
              "a": 1
            }
          ]
        }
      },
      "expected": false
    },
    {
      "description": "isArray: false for string",
      "body": {
        "$return": {
          "$call": "isArray",
          "$args": ["hello"]
        }
      },
      "expected": false
    },
    {
      "description": "isArray: false for number",
      "body": {
        "$return": {
          "$call": "isArray",
          "$args": [42]
        }
      },
      "expected": false
    },
    {
      "description": "isArray: false for null",
      "body": {
        "$return": {
          "$call": "isArray",
          "$args": [null]
        }
      },
      "expected": false
    },
    {
      "description": "isArray: false for boolean",
      "body": {
        "$return": {
          "$call": "isArray",
          "$args": [true]
        }
      },
      "expected": false
    },
    {
      "description": "type predicates: combined dispatch",
      "body": {
        "$return": {
          "$let": {
            "val": 42
          },
          "$in": {
            "$if": {
              "$call": "isNumber",
              "$args": [
                {
                  "$var": "val"
                }
              ]
            },
            "$then": "number",
            "$else": {
              "$if": {
                "$call": "isString",
                "$args": [
                  {
                    "$var": "val"
                  }
                ]
              },
              "$then": "string",
              "$else": "other"
            }
          }
        }
      },
      "expected": "number"
    }
  ]
}
