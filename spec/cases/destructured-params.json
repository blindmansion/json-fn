{
  "description": "destructured (object-pattern) parameters — $fields (plans/destructured-params.md)",
  "functions": {
    "move": {
      "$params": [{ "$fields": ["from", "to"] }],
      "$return": { "$fn": ["sub", { "$var": "to" }, { "$var": "from" }] }
    }
  },
  "cases": [
    {
      "description": "binds named fields from an object argument",
      "body": {
        "$params": [{ "$fields": ["from", "to"] }],
        "$return": { "$fn": ["sub", { "$var": "to" }, { "$var": "from" }] }
      },
      "args": [{ "from": 3, "to": 7 }],
      "expected": 4
    },
    {
      "description": "called in-language with a data object is an ordinary positional call",
      "body": { "$return": { "$fn": ["move", { "from": 3, "to": 7 }] } },
      "expected": 4
    },
    {
      "description": "single field pattern",
      "body": {
        "$params": [{ "$fields": ["x"] }],
        "$return": { "$fn": ["mul", { "$var": "x" }, 2] }
      },
      "args": [{ "x": 21 }],
      "expected": 42
    },
    {
      "description": "absent key binds to null",
      "body": {
        "$params": [{ "$fields": ["from", "to"] }],
        "$return": { "$var": "to" }
      },
      "args": [{ "from": 5 }],
      "expected": null
    },
    {
      "description": "extra keys are ignored",
      "body": {
        "$params": [{ "$fields": ["from", "to"] }],
        "$return": { "$fn": ["add", { "$var": "from" }, { "$var": "to" }] }
      },
      "args": [{ "from": 1, "to": 2, "extra": 99 }],
      "expected": 3
    },
    {
      "description": "non-object argument (number) binds all fields to null",
      "body": {
        "$params": [{ "$fields": ["a"] }],
        "$return": { "$fn": ["isNull", { "$var": "a" }] }
      },
      "args": [5],
      "expected": true
    },
    {
      "description": "missing argument entirely binds all fields to null",
      "body": {
        "$params": [{ "$fields": ["a", "b"] }],
        "$return": { "$fn": ["isNull", { "$var": "b" }] }
      },
      "expected": true
    },
    {
      "description": "null argument binds all fields to null",
      "body": {
        "$params": [{ "$fields": ["a"] }],
        "$return": { "$fn": ["isNull", { "$var": "a" }] }
      },
      "args": [null],
      "expected": true
    },
    {
      "description": "array argument is not a plain object, so fields bind to null",
      "body": {
        "$params": [{ "$fields": ["a"] }],
        "$return": { "$fn": ["isNull", { "$var": "a" }] }
      },
      "args": [[1, 2, 3]],
      "expected": true
    },
    {
      "description": "mixed positional and pattern slots",
      "body": {
        "$params": ["label", { "$fields": ["x", "y"] }],
        "$return": {
          "label": { "$var": "label" },
          "sum": { "$fn": ["add", { "$var": "x" }, { "$var": "y" }] }
        }
      },
      "args": ["p", { "x": 1, "y": 2 }],
      "expected": { "label": "p", "sum": 3 }
    },
    {
      "description": "pattern slot followed by a rest parameter",
      "body": {
        "$params": [{ "$fields": ["x"] }, "...rest"],
        "$return": {
          "x": { "$var": "x" },
          "rest": { "$var": "rest" }
        }
      },
      "args": [{ "x": 1 }, 2, 3],
      "expected": { "x": 1, "rest": [2, 3] }
    },
    {
      "description": "multiple pattern slots each destructure their own argument",
      "body": {
        "$params": [{ "$fields": ["a"] }, { "$fields": ["b"] }],
        "$return": { "$fn": ["add", { "$var": "a" }, { "$var": "b" }] }
      },
      "args": [{ "a": 1 }, { "b": 2 }],
      "expected": 3
    },
    {
      "description": "fields are visible to lazy locals",
      "body": {
        "$params": [{ "$fields": ["n"] }],
        "twice": { "$fn": ["mul", { "$var": "n" }, 2] },
        "$return": { "$var": "twice" }
      },
      "args": [{ "n": 21 }],
      "expected": 42
    },
    {
      "description": "fields are visible inside a nested inline function call",
      "body": {
        "$params": [{ "$fields": ["x"] }],
        "$return": {
          "$fn": [
            {
              "$params": ["y"],
              "$return": { "$fn": ["add", { "$var": "x" }, { "$var": "y" }] }
            },
            5
          ]
        }
      },
      "args": [{ "x": 10 }],
      "expected": 15
    },
    {
      "description": "an inner parameter shadows an outer field of the same name",
      "body": {
        "$params": [{ "$fields": ["x"] }],
        "$return": {
          "$fn": [{ "$params": ["x"], "$return": { "$var": "x" } }, 99]
        }
      },
      "args": [{ "x": 1 }],
      "expected": 99
    },
    {
      "description": "arity counts a pattern slot as one parameter",
      "body": {
        "$return": { "$fn": ["arity", { "$var": "fn" }] },
        "fn": { "$params": [{ "$fields": ["from", "to"] }], "$return": { "$var": "from" } }
      },
      "expected": 1
    },
    {
      "description": "arity counts positional plus pattern slots",
      "body": {
        "$return": { "$fn": ["arity", { "$var": "fn" }] },
        "fn": { "$params": ["a", { "$fields": ["x", "y"] }], "$return": { "$var": "a" } }
      },
      "expected": 2
    },
    {
      "description": "arity excludes the rest parameter after a pattern slot",
      "body": {
        "$return": { "$fn": ["arity", { "$var": "fn" }] },
        "fn": { "$params": [{ "$fields": ["x"] }, "...rest"], "$return": { "$var": "x" } }
      },
      "expected": 1
    }
  ]
}
