{
  "description": "conditionals",
  "functions": {
    "classify": {
      "$params": ["n"],
      "$return": {
        "$cond": [
          [
            {
              "$fn": [
                "lt",
                {
                  "$var": "n"
                },
                0
              ]
            },
            "negative"
          ],
          [
            {
              "$fn": [
                "eq",
                {
                  "$var": "n"
                },
                0
              ]
            },
            "zero"
          ],
          [true, "positive"]
        ]
      }
    },
    "fizzbuzz": {
      "$params": ["n"],
      "divBy3": {
        "$fn": [
          "eq",
          {
            "$fn": [
              "mod",
              {
                "$var": "n"
              },
              3
            ]
          },
          0
        ]
      },
      "divBy5": {
        "$fn": [
          "eq",
          {
            "$fn": [
              "mod",
              {
                "$var": "n"
              },
              5
            ]
          },
          0
        ]
      },
      "divBy15": {
        "$fn": [
          "and",
          {
            "$var": "divBy3"
          },
          {
            "$var": "divBy5"
          }
        ]
      },
      "$return": {
        "$cond": [
          [
            {
              "$var": "divBy15"
            },
            "FizzBuzz"
          ],
          [
            {
              "$var": "divBy3"
            },
            "Fizz"
          ],
          [
            {
              "$var": "divBy5"
            },
            "Buzz"
          ],
          [
            true,
            {
              "$var": "n"
            }
          ]
        ]
      }
    }
  },
  "cases": [
    {
      "description": "$if: truthy condition returns $then",
      "body": {
        "$return": {
          "$if": {
            "$fn": ["gt", 10, 5]
          },
          "$then": "ten is greater",
          "$else": "five is greater"
        }
      },
      "expected": "ten is greater"
    },
    {
      "description": "$if: falsy condition returns $else",
      "body": {
        "$return": {
          "$if": {
            "$fn": ["gt", 3, 5]
          },
          "$then": "three is greater",
          "$else": "five is greater"
        }
      },
      "expected": "five is greater"
    },
    {
      "description": "$cond: classify negative",
      "body": {
        "$return": {
          "$fn": ["classify", -5]
        }
      },
      "expected": "negative"
    },
    {
      "description": "$cond: classify zero",
      "body": {
        "$return": {
          "$fn": ["classify", 0]
        }
      },
      "expected": "zero"
    },
    {
      "description": "$cond: classify positive",
      "body": {
        "$return": {
          "$fn": ["classify", 42]
        }
      },
      "expected": "positive"
    },
    {
      "description": "$cond: fizzbuzz(15) → FizzBuzz",
      "body": {
        "$return": {
          "$fn": ["fizzbuzz", 15]
        }
      },
      "expected": "FizzBuzz"
    },
    {
      "description": "$cond: fizzbuzz(9) → Fizz",
      "body": {
        "$return": {
          "$fn": ["fizzbuzz", 9]
        }
      },
      "expected": "Fizz"
    },
    {
      "description": "$cond: fizzbuzz(10) → Buzz",
      "body": {
        "$return": {
          "$fn": ["fizzbuzz", 10]
        }
      },
      "expected": "Buzz"
    },
    {
      "description": "$cond: fizzbuzz(7) → 7 (number passthrough)",
      "body": {
        "$return": {
          "$fn": ["fizzbuzz", 7]
        }
      },
      "expected": 7
    },
    {
      "description": "$cond: inline letter grade",
      "body": {
        "$params": ["score"],
        "$return": {
          "$cond": [
            [
              {
                "$fn": [
                  "gte",
                  {
                    "$var": "score"
                  },
                  90
                ]
              },
              "A"
            ],
            [
              {
                "$fn": [
                  "gte",
                  {
                    "$var": "score"
                  },
                  80
                ]
              },
              "B"
            ],
            [
              {
                "$fn": [
                  "gte",
                  {
                    "$var": "score"
                  },
                  70
                ]
              },
              "C"
            ],
            [
              {
                "$fn": [
                  "gte",
                  {
                    "$var": "score"
                  },
                  60
                ]
              },
              "D"
            ],
            [true, "F"]
          ]
        }
      },
      "args": [85],
      "expected": "B"
    },
    {
      "description": "$cond: short-circuits (only first matching branch evaluates)",
      "body": {
        "$return": {
          "$cond": [
            [
              false,
              {
                "$fn": ["add", 1, 2]
              }
            ],
            [true, "matched second"],
            [true, "never reached"]
          ]
        }
      },
      "expected": "matched second"
    },
    {
      "description": "$cond: single pair works as a guard",
      "body": {
        "$return": {
          "$cond": [[true, "always this"]]
        }
      },
      "expected": "always this"
    },
    {
      "description": "$and: all truthy returns last value",
      "body": {
        "$return": { "$and": [1, "hello", true] }
      },
      "expected": true
    },
    {
      "description": "$and: short-circuits on first falsy",
      "body": {
        "$return": { "$and": [1, 0, { "$fn": ["div", 1, 0] }] }
      },
      "expected": 0
    },
    {
      "description": "$and: empty array returns true",
      "body": {
        "$return": { "$and": [] }
      },
      "expected": true
    },
    {
      "description": "$and: single falsy element",
      "body": {
        "$return": { "$and": [null] }
      },
      "expected": null
    },
    {
      "description": "$and: single truthy element",
      "body": {
        "$return": { "$and": ["yes"] }
      },
      "expected": "yes"
    },
    {
      "description": "$and: returns the falsy value, not boolean",
      "body": {
        "$return": { "$and": [true, "", "unreached"] }
      },
      "expected": ""
    },
    {
      "description": "$or: all falsy returns last value",
      "body": {
        "$return": { "$or": [false, 0, null] }
      },
      "expected": null
    },
    {
      "description": "$or: short-circuits on first truthy",
      "body": {
        "$return": { "$or": [false, "found", { "$fn": ["div", 1, 0] }] }
      },
      "expected": "found"
    },
    {
      "description": "$or: empty array returns false",
      "body": {
        "$return": { "$or": [] }
      },
      "expected": false
    },
    {
      "description": "$or: single truthy element",
      "body": {
        "$return": { "$or": [42] }
      },
      "expected": 42
    },
    {
      "description": "$or: returns the truthy value, not boolean",
      "body": {
        "$return": { "$or": [null, 0, "winner", "unreached"] }
      },
      "expected": "winner"
    },
    {
      "description": "$and/$or: nested composition",
      "body": {
        "$params": ["x"],
        "$return": {
          "$and": [
            { "$fn": ["gt", { "$var": "x" }, 0] },
            { "$or": [{ "$fn": ["eq", { "$var": "x" }, 42] }, "positive"] }
          ]
        }
      },
      "args": [10],
      "expected": "positive"
    }
  ]
}
