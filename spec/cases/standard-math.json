{
  "description": "standard math functions",
  "cases": [
    {
      "description": "exp: zero returns one",
      "body": { "$return": { "$call": "exp", "$args": [0] } },
      "expected": 1
    },
    {
      "description": "exp: one returns Euler's number",
      "body": { "$return": { "$call": "exp", "$args": [1] } },
      "expected": 2.718281828459045
    },
    {
      "description": "exp: rejects overflow",
      "body": { "$return": { "$call": "exp", "$args": [1000] } },
      "error": "result must be a finite number"
    },
    {
      "description": "log: one returns zero",
      "body": { "$return": { "$call": "log", "$args": [1] } },
      "expected": 0
    },
    {
      "description": "log: Euler's number returns one",
      "body": { "$return": { "$call": "log", "$args": [2.718281828459045] } },
      "expected": 1
    },
    {
      "description": "log: rejects zero",
      "body": { "$return": { "$call": "log", "$args": [0] } },
      "error": "result must be a finite number"
    },
    {
      "description": "log: rejects negative inputs",
      "body": { "$return": { "$call": "log", "$args": [-1] } },
      "error": "result must be a finite number"
    },
    {
      "description": "log10: computes a base-10 logarithm",
      "body": { "$return": { "$call": "log10", "$args": [1000] } },
      "expected": 3
    },
    {
      "description": "log10: rejects zero",
      "body": { "$return": { "$call": "log10", "$args": [0] } },
      "error": "result must be a finite number"
    },
    {
      "description": "sin: zero returns zero",
      "body": { "$return": { "$call": "sin", "$args": [0] } },
      "expected": 0
    },
    {
      "description": "sin: pi over two returns one",
      "body": { "$return": { "$call": "sin", "$args": [1.5707963267948966] } },
      "expected": 1
    },
    {
      "description": "cos: zero returns one",
      "body": { "$return": { "$call": "cos", "$args": [0] } },
      "expected": 1
    },
    {
      "description": "cos: pi returns negative one",
      "body": { "$return": { "$call": "cos", "$args": [3.141592653589793] } },
      "expected": -1
    },
    {
      "description": "tan: zero returns zero",
      "body": { "$return": { "$call": "tan", "$args": [0] } },
      "expected": 0
    },
    {
      "description": "atan2: positive x-axis returns zero",
      "body": { "$return": { "$call": "atan2", "$args": [0, 1] } },
      "expected": 0
    },
    {
      "description": "atan2: positive y-axis returns pi over two",
      "body": { "$return": { "$call": "atan2", "$args": [1, 0] } },
      "expected": 1.5707963267948966
    }
  ]
}
