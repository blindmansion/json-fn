{
  "description": "local function recursion via scoped registry",
  "cases": [
    {
      "description": "self-recursive local factorial via string dispatch",
      "body": {
        "$params": ["n"],
        "fact": {
          "$params": ["x"],
          "$return": {
            "$if": { "$fn": ["lte", { "$var": "x" }, 1] },
            "$then": 1,
            "$else": {
              "$fn": [
                "mul",
                { "$var": "x" },
                {
                  "$fn": ["fact", { "$fn": ["sub", { "$var": "x" }, 1] }]
                }
              ]
            }
          }
        },
        "$return": { "$fn": ["fact", { "$var": "n" }] }
      },
      "args": [5],
      "expected": 120
    },
    {
      "description": "self-recursive local fibonacci",
      "body": {
        "$params": ["n"],
        "fib": {
          "$params": ["x"],
          "$return": {
            "$if": { "$fn": ["lte", { "$var": "x" }, 1] },
            "$then": { "$var": "x" },
            "$else": {
              "$fn": [
                "add",
                {
                  "$fn": ["fib", { "$fn": ["sub", { "$var": "x" }, 1] }]
                },
                {
                  "$fn": ["fib", { "$fn": ["sub", { "$var": "x" }, 2] }]
                }
              ]
            }
          }
        },
        "$return": { "$fn": ["fib", { "$var": "n" }] }
      },
      "args": [10],
      "expected": 55
    },
    {
      "description": "base case: local factorial(0) = 1",
      "body": {
        "fact": {
          "$params": ["n"],
          "$return": {
            "$if": { "$fn": ["lte", { "$var": "n" }, 1] },
            "$then": 1,
            "$else": {
              "$fn": [
                "mul",
                { "$var": "n" },
                {
                  "$fn": ["fact", { "$fn": ["sub", { "$var": "n" }, 1] }]
                }
              ]
            }
          }
        },
        "$return": { "$fn": ["fact", 0] }
      },
      "expected": 1
    },
    {
      "description": "mutual recursion between local isEven and isOdd",
      "body": {
        "$params": ["n"],
        "myIsEven": {
          "$params": ["x"],
          "$return": {
            "$if": { "$fn": ["eq", { "$var": "x" }, 0] },
            "$then": true,
            "$else": {
              "$fn": ["myIsOdd", { "$fn": ["sub", { "$var": "x" }, 1] }]
            }
          }
        },
        "myIsOdd": {
          "$params": ["x"],
          "$return": {
            "$if": { "$fn": ["eq", { "$var": "x" }, 0] },
            "$then": false,
            "$else": {
              "$fn": ["myIsEven", { "$fn": ["sub", { "$var": "x" }, 1] }]
            }
          }
        },
        "$return": [
          { "$fn": ["myIsEven", { "$var": "n" }] },
          { "$fn": ["myIsOdd", { "$var": "n" }] }
        ]
      },
      "args": [4],
      "expected": [true, false]
    },
    {
      "description": "mutual recursion: odd number",
      "body": {
        "$params": ["n"],
        "myIsEven": {
          "$params": ["x"],
          "$return": {
            "$if": { "$fn": ["eq", { "$var": "x" }, 0] },
            "$then": true,
            "$else": {
              "$fn": ["myIsOdd", { "$fn": ["sub", { "$var": "x" }, 1] }]
            }
          }
        },
        "myIsOdd": {
          "$params": ["x"],
          "$return": {
            "$if": { "$fn": ["eq", { "$var": "x" }, 0] },
            "$then": false,
            "$else": {
              "$fn": ["myIsEven", { "$fn": ["sub", { "$var": "x" }, 1] }]
            }
          }
        },
        "$return": [
          { "$fn": ["myIsEven", { "$var": "n" }] },
          { "$fn": ["myIsOdd", { "$var": "n" }] }
        ]
      },
      "args": [5],
      "expected": [false, true]
    },
    {
      "description": "local recursive fn can also call stdlib functions",
      "body": {
        "sumTo": {
          "$params": ["n"],
          "$return": {
            "$if": { "$fn": ["lte", { "$var": "n" }, 0] },
            "$then": 0,
            "$else": {
              "$fn": [
                "add",
                { "$var": "n" },
                {
                  "$fn": ["sumTo", { "$fn": ["sub", { "$var": "n" }, 1] }]
                }
              ]
            }
          }
        },
        "$return": { "$fn": ["sumTo", 10] }
      },
      "expected": 55
    },
    {
      "description": "local recursive fn coexists with non-recursive local variable",
      "body": {
        "$params": ["n"],
        "threshold": 1,
        "fact": {
          "$params": ["x"],
          "$return": {
            "$if": { "$fn": ["lte", { "$var": "x" }, { "$var": "threshold" }] },
            "$then": 1,
            "$else": {
              "$fn": [
                "mul",
                { "$var": "x" },
                {
                  "$fn": ["fact", { "$fn": ["sub", { "$var": "x" }, 1] }]
                }
              ]
            }
          }
        },
        "$return": { "$fn": ["fact", { "$var": "n" }] }
      },
      "args": [5],
      "expected": 120
    },
    {
      "description": "non-recursive local calling a recursive local",
      "body": {
        "fact": {
          "$params": ["n"],
          "$return": {
            "$if": { "$fn": ["lte", { "$var": "n" }, 1] },
            "$then": 1,
            "$else": {
              "$fn": [
                "mul",
                { "$var": "n" },
                {
                  "$fn": ["fact", { "$fn": ["sub", { "$var": "n" }, 1] }]
                }
              ]
            }
          }
        },
        "doubleFactorial": {
          "$fn": ["mul", { "$fn": ["fact", 5] }, 2]
        },
        "$return": { "$var": "doubleFactorial" }
      },
      "expected": 240
    },
    {
      "description": "local function body shadows a global registry function of the same name",
      "body": {
        "double": {
          "$params": ["x"],
          "$return": { "$fn": ["mul", { "$var": "x" }, 3] }
        },
        "$return": { "$fn": ["double", 5] }
      },
      "functions": {
        "double": {
          "$params": ["x"],
          "$return": { "$fn": ["mul", { "$var": "x" }, 2] }
        }
      },
      "expected": 15
    },
    {
      "description": "local recursive fn used with map (HOF callback by string name)",
      "body": {
        "fact": {
          "$params": ["n"],
          "$return": {
            "$if": { "$fn": ["lte", { "$var": "n" }, 1] },
            "$then": 1,
            "$else": {
              "$fn": [
                "mul",
                { "$var": "n" },
                {
                  "$fn": ["fact", { "$fn": ["sub", { "$var": "n" }, 1] }]
                }
              ]
            }
          }
        },
        "$return": { "$fn": ["map", { "$fn": "fact" }, [1, 2, 3, 4, 5]] }
      },
      "expected": [1, 2, 6, 24, 120]
    },
    {
      "description": "local recursive fn called with named args",
      "body": {
        "fact": {
          "$params": ["n"],
          "$return": {
            "$if": { "$fn": ["lte", { "$var": "n" }, 1] },
            "$then": 1,
            "$else": {
              "$fn": [
                "mul",
                { "$var": "n" },
                {
                  "$fn": ["fact", { "$fn": ["sub", { "$var": "n" }, 1] }]
                }
              ]
            }
          }
        },
        "$return": { "$fn": ["fact", 6] }
      },
      "expected": 720
    },
    {
      "description": "recursive local with rest params",
      "body": {
        "sumAll": {
          "$params": ["first", "...rest"],
          "$return": {
            "$if": {
              "$fn": ["eq", { "$fn": ["length", { "$var": "rest" }] }, 0]
            },
            "$then": { "$var": "first" },
            "$else": {
              "$fn": [
                "add",
                { "$var": "first" },
                { "$fn": ["apply", "sumAll", { "$var": "rest" }] }
              ]
            }
          }
        },
        "$return": { "$fn": ["sumAll", 1, 2, 3, 4, 5] }
      },
      "expected": 15
    },
    {
      "description": "nested scope: inner function body has its own local recursive fn",
      "body": {
        "$params": ["n"],
        "$return": {
          "$fn": [
            {
              "fact": {
                "$params": ["x"],
                "$return": {
                  "$if": { "$fn": ["lte", { "$var": "x" }, 1] },
                  "$then": 1,
                  "$else": {
                    "$fn": [
                      "mul",
                      { "$var": "x" },
                      {
                        "$fn": ["fact", { "$fn": ["sub", { "$var": "x" }, 1] }]
                      }
                    ]
                  }
                }
              },
              "$return": { "$fn": ["fact", { "$var": "n" }] }
            }
          ]
        }
      },
      "args": [6],
      "expected": 720
    },
    {
      "description": "local recursive fn does not leak into sibling scope",
      "body": {
        "wrapper": {
          "fact": {
            "$params": ["n"],
            "$return": {
              "$if": { "$fn": ["lte", { "$var": "n" }, 1] },
              "$then": 1,
              "$else": {
                "$fn": [
                  "mul",
                  { "$var": "n" },
                  {
                    "$fn": ["fact", { "$fn": ["sub", { "$var": "n" }, 1] }]
                  }
                ]
              }
            }
          },
          "$return": { "$fn": ["fact", 5] }
        },
        "$return": { "$fn": ["fact", 3] }
      },
      "error": "Function fact not found"
    },
    {
      "description": "returned closure re-attaches the local fn it calls, so it works outside its defining scope",
      "body": {
        "closure": {
          "$fn": [
            {
              "helper": {
                "$params": ["x"],
                "$return": { "$fn": ["mul", { "$var": "x" }, 2] }
              },
              "$return": {
                "$params": ["y"],
                "$return": { "$fn": ["helper", { "$var": "y" }] }
              }
            }
          ]
        },
        "$return": { "$fn": [{ "$var": "closure" }, 5] }
      },
      "expected": 10
    }
  ]
}
