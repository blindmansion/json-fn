{
  "description": "Safety limits",
  "cases": [
    {
      "description": "detects self-referential variable",
      "body": { "x": { "$var": "x" }, "$return": { "$var": "x" } },
      "error": "Circular variable dependency detected: x -> x"
    },
    {
      "description": "detects mutual variable cycle (a -> b -> a)",
      "body": { "a": { "$var": "b" }, "b": { "$var": "a" }, "$return": { "$var": "a" } },
      "error": "Circular variable dependency detected: a -> b -> a"
    },
    {
      "description": "detects longer variable cycle (a -> b -> c -> a)",
      "body": {
        "a": { "$var": "b" },
        "b": { "$var": "c" },
        "c": { "$var": "a" },
        "$return": { "$var": "a" }
      },
      "error": "Circular variable dependency detected: a -> b -> c -> a"
    },
    {
      "description": "detects cycle not starting from first variable",
      "body": {
        "x": 10,
        "a": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "b" }] },
        "b": { "$var": "c" },
        "c": { "$var": "b" },
        "$return": { "$var": "a" }
      },
      "error": "Circular variable dependency detected: b -> c -> b"
    },
    {
      "description": "enforces maximum call depth",
      "body": { "$return": { "$call": "loop", "$args": [] } },
      "functions": { "loop": { "$return": { "$call": "loop", "$args": [] } } },
      "limits": { "maxCallDepth": 10 },
      "error": "Maximum call depth of 10 exceeded"
    },
    {
      "description": "enforces maximum call depth with mutual recursion",
      "body": { "$return": { "$call": "ping", "$args": [] } },
      "functions": {
        "ping": { "$return": { "$call": "pong", "$args": [] } },
        "pong": { "$return": { "$call": "ping", "$args": [] } }
      },
      "limits": { "maxCallDepth": 10 },
      "error": "Maximum call depth of 10 exceeded"
    },
    {
      "description": "allows recursion within configured limits",
      "body": { "$return": { "$call": "sum_to", "$args": [5] } },
      "functions": {
        "sum_to": {
          "$params": ["n"],
          "$return": {
            "$if": { "$call": "lte", "$args": [{ "$var": "n" }, 0] },
            "$then": 0,
            "$else": {
              "$call": "add",
              "$args": [
                { "$var": "n" },
                { "$call": "sum_to", "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }] }
              ]
            }
          }
        }
      },
      "limits": { "maxCallDepth": 100 },
      "expected": 15
    },
    {
      "description": "non-circular variable chain resolves correctly",
      "body": {
        "a": 1,
        "b": { "$call": "add", "$args": [{ "$var": "a" }, 2] },
        "c": { "$call": "add", "$args": [{ "$var": "b" }, 3] },
        "$return": { "$var": "c" }
      },
      "expected": 6
    },
    {
      "description": "enforces maximum fuel limit",
      "body": { "$return": { "$call": "fib", "$args": [10] } },
      "functions": {
        "fib": {
          "$params": ["n"],
          "$return": {
            "$if": { "$call": "lte", "$args": [{ "$var": "n" }, 1] },
            "$then": { "$var": "n" },
            "$else": {
              "$call": "add",
              "$args": [
                { "$call": "fib", "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }] },
                { "$call": "fib", "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 2] }] }
              ]
            }
          }
        }
      },
      "limits": { "maxFuel": 50 },
      "error": "Maximum fuel limit of 50 exceeded"
    },
    {
      "description": "allows execution within fuel limit",
      "body": { "$return": { "$call": "add", "$args": [{ "$call": "mul", "$args": [3, 4] }, 5] } },
      "limits": { "maxFuel": 100 },
      "expected": 17
    },
    {
      "description": "fuel limit catches expensive non-deep computation",
      "body": {
        "$return": {
          "$call": "reduce",
          "$args": [
            "add",
            0,
            {
              "$call": "map",
              "$args": [
                {
                  "$params": ["x"],
                  "$return": { "$call": "mul", "$args": [{ "$var": "x" }, { "$var": "x" }] }
                },
                { "$call": "range", "$args": [100] }
              ]
            }
          ]
        }
      },
      "limits": { "maxFuel": 50 },
      "error": "Maximum fuel limit of 50 exceeded"
    }
  ]
}
