{
  "$schema": "../../builtin.schema.json",
  "builtin": "entries",
  "description": "Return an object's key-value pairs.",
  "cases": [
    {
      "description": "returns key-value pairs in object order",
      "args": [{ "a": 1, "b": 2, "c": 3 }],
      "outcome": {
        "returns": [
          ["a", 1],
          ["b", 2],
          ["c", 3]
        ]
      }
    },
    {
      "description": "returns an empty array for an empty object",
      "args": [{}],
      "outcome": { "returns": [] }
    },
    {
      "description": "rejects an array",
      "args": [[1, 2]],
      "outcome": { "throws": { "messageIncludes": "argument must be an object" } }
    }
  ]
}
