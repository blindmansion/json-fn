{
  "$schema": "../../builtin.schema.json",
  "builtin": "setAt",
  "description": "Return arrays with one element replaced.",
  "cases": [
    {
      "description": "replaces an element at a given index",
      "args": [["a", "b", "c"], 1, "X"],
      "outcome": { "returns": ["a", "X", "c"] }
    },
    {
      "description": "replaces the first element",
      "args": [[10, 20, 30], 0, 99],
      "outcome": { "returns": [99, 20, 30] }
    },
    {
      "description": "replaces the last element",
      "args": [[10, 20, 30], 2, 99],
      "outcome": { "returns": [10, 20, 99] }
    },
    {
      "description": "can replace an element with null",
      "args": [["a", "b", "c"], 0, null],
      "outcome": { "returns": [null, "b", "c"] }
    },
    {
      "description": "rejects an index above the array bounds",
      "args": [[1, 2, 3], 5, 99],
      "outcome": { "throws": { "messageIncludes": "out of bounds" } }
    },
    {
      "description": "rejects a negative index",
      "args": [[1, 2, 3], -1, 99],
      "outcome": { "throws": { "messageIncludes": "out of bounds" } }
    },
    {
      "description": "rejects a non-array first argument",
      "args": ["abc", 1, "X"],
      "outcome": { "throws": { "messageIncludes": "first argument must be an array" } }
    },
    {
      "description": "rejects a non-integer index",
      "args": [[1, 2, 3], 1.5, 99],
      "outcome": { "throws": { "messageIncludes": "second argument must be an integer" } }
    }
  ]
}
