{
  "$schema": "../../builtin.schema.json",
  "builtin": "drop",
  "description": "Return an array without a requested prefix.",
  "cases": [
    {
      "description": "removes the requested prefix",
      "args": [[1, 2, 3, 4], 2],
      "outcome": { "returns": [3, 4] }
    },
    {
      "description": "returns an empty array when the count exceeds its length",
      "args": [[1, 2, 3], 10],
      "outcome": { "returns": [] }
    },
    {
      "description": "returns the whole array for a zero count",
      "args": [[1, 2, 3], 0],
      "outcome": { "returns": [1, 2, 3] }
    },
    {
      "description": "returns the whole array for a negative count",
      "args": [[1, 2, 3], -2],
      "outcome": { "returns": [1, 2, 3] }
    }
  ]
}
