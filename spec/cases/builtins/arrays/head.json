{
  "$schema": "../../builtin.schema.json",
  "builtin": "head",
  "description": "Return the first array element or null when empty.",
  "cases": [
    {
      "description": "returns the first element",
      "args": [[10, 20, 30]],
      "outcome": { "returns": 10 }
    },
    {
      "description": "returns null for an empty array",
      "args": [[]],
      "outcome": { "returns": null }
    },
    {
      "description": "returns the element of a single-element array",
      "args": [[42]],
      "outcome": { "returns": 42 }
    },
    {
      "description": "works with mixed element types",
      "args": [["hello", 2, true]],
      "outcome": { "returns": "hello" }
    },
    {
      "description": "decodes a literal fixture nested in an array",
      "args": [[{ "$literal": { "$builtin": "add" } }]],
      "outcome": { "returns": { "$builtin": "add" } }
    },
    {
      "description": "does not decode fixtures inside ordinary objects",
      "args": [[{ "nested": { "$builtin": "add" } }]],
      "outcome": { "returns": { "nested": { "$builtin": "add" } } }
    },
    {
      "description": "treats reserved-looking objects with extra keys as literals",
      "args": [[{ "$builtin": "add", "metadata": true }]],
      "outcome": { "returns": { "$builtin": "add", "metadata": true } }
    },
    {
      "description": "rejects a non-array argument",
      "args": ["abc"],
      "outcome": { "throws": { "messageIncludes": "argument must be an array" } }
    }
  ]
}
