{
  "$schema": "../../builtin.schema.json",
  "builtin": "someIndexed",
  "description": "Test for a match with callbacks that also receive each index.",
  "cases": [
    {
      "description": "passes values and indices and short-circuits after a match",
      "args": [
        {
          "$callback": {
            "steps": [
              { "args": ["a", 0], "outcome": { "returns": false } },
              { "args": ["b", 1], "outcome": { "returns": false } },
              { "args": ["c", 2], "outcome": { "returns": true } }
            ]
          }
        },
        ["a", "b", "c"]
      ],
      "outcome": { "returns": true },
      "observations": { "meter": { "charged": 3 } }
    }
  ]
}
