{
  "description": "array builtin evaluator integration",
  "cases": [
    {
      "description": "head and last: compose through bindings and arithmetic",
      "body": {
        "$return": {
          "$let": {
            "arr": [10, 20, 30, 40, 50],
            "first": { "$call": "head", "$args": [{ "$var": "arr" }] },
            "end": { "$call": "last", "$args": [{ "$var": "arr" }] }
          },
          "$in": { "$call": "add", "$args": [{ "$var": "first" }, { "$var": "end" }] }
        }
      },
      "expected": 60
    },
    {
      "description": "range: can be passed directly as a unary map callback",
      "body": { "$return": { "$call": "map", "$args": ["range", [0, 2, 3]] } },
      "expected": [[], [0, 1], [0, 1, 2]]
    }
  ]
}
