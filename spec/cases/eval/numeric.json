{
  "description": "numeric evaluator integration",
  "cases": [
    {
      "description": "floor and ceil: bracket a decimal",
      "body": {
        "$return": {
          "$let": {
            "val": 3.7,
            "lo": { "$call": "floor", "$args": [{ "$var": "val" }] },
            "hi": { "$call": "ceil", "$args": [{ "$var": "val" }] }
          },
          "$in": [{ "$var": "lo" }, { "$var": "hi" }]
        }
      },
      "expected": [3, 4]
    },
    {
      "description": "max and min: range of array",
      "body": {
        "$return": {
          "$let": {
            "arr": [5, 2, 8, 1, 9, 3],
            "hi": { "$call": "max", "$args": [{ "$var": "arr" }] },
            "lo": { "$call": "min", "$args": [{ "$var": "arr" }] }
          },
          "$in": { "$call": "sub", "$args": [{ "$var": "hi" }, { "$var": "lo" }] }
        }
      },
      "expected": 8
    }
  ]
}
