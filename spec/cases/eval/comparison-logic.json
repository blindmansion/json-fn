{
  "description": "comparison and logic evaluator integration",
  "cases": [
    {
      "description": "neq: can be used as a filter predicate",
      "body": {
        "$return": {
          "$call": "filter",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "neq", "$args": [{ "$var": "x" }, 0] } },
            [0, 1, 0, 2, 0, 3]
          ]
        }
      },
      "expected": [1, 2, 3]
    },
    {
      "description": "not: can invert filter logic",
      "body": {
        "$return": {
          "$call": "filter",
          "$args": [
            {
              "$params": ["x"],
              "$return": {
                "$call": "not",
                "$args": [{ "$call": "gt", "$args": [{ "$var": "x" }, 3] }]
              }
            },
            [1, 2, 3, 4, 5]
          ]
        }
      },
      "expected": [1, 2, 3]
    },
    {
      "description": "eq: compares evaluated nested call results",
      "body": { "$return": { "$call": "eq", "$args": [{ "$call": "add", "$args": [1, 1] }, 2] } },
      "expected": true
    },
    {
      "description": "comparisons compose through the $and language form",
      "body": {
        "$return": {
          "$and": [
            { "$call": "lt", "$args": [1, 2] },
            { "$call": "lte", "$args": [2, 2] },
            { "$call": "gt", "$args": [3, 2] },
            { "$call": "gte", "$args": [3, 3] }
          ]
        }
      },
      "expected": true
    },
    {
      "description": "eq: can be used directly in conditionals",
      "body": {
        "$params": ["cmd"],
        "$return": {
          "$if": { "$call": "eq", "$args": [{ "$var": "cmd" }, "show"] },
          "$then": "display",
          "$else": "move"
        }
      },
      "args": ["show"],
      "expected": "display"
    }
  ]
}
