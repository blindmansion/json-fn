{
  "description": "objects",
  "cases": [
    {
      "description": "entries → fromEntries roundtrip",
      "body": {
        "$return": {
          "$let": { "pairs": { "$call": "entries", "$args": [{ "name": "alice", "age": 30 }] } },
          "$in": { "$call": "fromEntries", "$args": [{ "$var": "pairs" }] }
        }
      },
      "expected": { "name": "alice", "age": 30 }
    },
    {
      "description": "entries → filter → fromEntries (filter object by value)",
      "body": {
        "$return": {
          "$let": {
            "pairs": { "$call": "entries", "$args": [{ "a": 1, "b": 5, "c": 2, "d": 8 }] },
            "big": {
              "$call": "filter",
              "$args": [
                {
                  "$params": ["pair"],
                  "$return": {
                    "$let": { "value": { "$get": 1, "$from": { "$var": "pair" } } },
                    "$in": { "$call": "gt", "$args": [{ "$var": "value" }, 3] }
                  }
                },
                { "$var": "pairs" }
              ]
            }
          },
          "$in": { "$call": "fromEntries", "$args": [{ "$var": "big" }] }
        }
      },
      "expected": { "b": 5, "d": 8 }
    },
    {
      "description": "entries → map → fromEntries (transform keys)",
      "body": {
        "$return": {
          "$let": {
            "pairs": { "$call": "entries", "$args": [{ "hello": 1, "world": 2 }] },
            "uppered": {
              "$call": "map",
              "$args": [
                {
                  "$params": ["pair"],
                  "$return": {
                    "$let": {
                      "k": {
                        "$call": "upper",
                        "$args": [{ "$get": 0, "$from": { "$var": "pair" } }]
                      },
                      "v": { "$get": 1, "$from": { "$var": "pair" } }
                    },
                    "$in": [{ "$var": "k" }, { "$var": "v" }]
                  }
                },
                { "$var": "pairs" }
              ]
            }
          },
          "$in": { "$call": "fromEntries", "$args": [{ "$var": "uppered" }] }
        }
      },
      "expected": { "HELLO": 1, "WORLD": 2 }
    },
    {
      "description": "merge chain for state update",
      "body": {
        "$return": {
          "$let": { "state": { "score": 0, "lives": 3, "level": 1 } },
          "$in": { "$call": "merge", "$args": [{ "$var": "state" }, { "score": 100, "level": 2 }] }
        }
      },
      "expected": { "score": 100, "lives": 3, "level": 2 }
    }
  ]
}
