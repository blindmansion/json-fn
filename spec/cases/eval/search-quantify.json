{
  "description": "search, quantify, and sort",
  "cases": [
    {
      "description": "find + findIndex: consistent results",
      "body": {
        "$return": {
          "$let": {
            "arr": [10, 20, 30, 40, 50],
            "pred": {
              "$params": ["x"],
              "$return": { "$call": "gte", "$args": [{ "$var": "x" }, 30] }
            },
            "found": { "$call": "find", "$args": [{ "$var": "pred" }, { "$var": "arr" }] },
            "idx": { "$call": "findIndex", "$args": [{ "$var": "pred" }, { "$var": "arr" }] }
          },
          "$in": [{ "$var": "found" }, { "$var": "idx" }]
        }
      },
      "expected": [30, 2]
    }
  ]
}
