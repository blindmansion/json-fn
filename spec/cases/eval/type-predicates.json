{
  "description": "type predicate integration",
  "cases": [
    {
      "description": "type predicates: combined dispatch",
      "body": {
        "$return": {
          "$let": { "val": 42 },
          "$in": {
            "$if": { "$call": "isNumber", "$args": [{ "$var": "val" }] },
            "$then": "number",
            "$else": {
              "$if": { "$call": "isString", "$args": [{ "$var": "val" }] },
              "$then": "string",
              "$else": "other"
            }
          }
        }
      },
      "expected": "number"
    }
  ]
}
