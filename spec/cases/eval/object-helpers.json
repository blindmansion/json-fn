{
  "description": "object helper evaluator integration",
  "cases": [
    {
      "description": "keys: multiple keys sorted for deterministic comparison",
      "body": {
        "$return": {
          "$let": { "ks": { "$call": "keys", "$args": [{ "c": 3, "a": 1, "b": 2 }] } },
          "$in": {
            "$call": "sortBy",
            "$args": [{ "$params": ["x"], "$return": { "$var": "x" } }, { "$var": "ks" }]
          }
        }
      },
      "expected": ["a", "b", "c"]
    },
    {
      "description": "keys: count matches number of keys",
      "body": {
        "$return": {
          "$call": "length",
          "$args": [{ "$call": "keys", "$args": [{ "x": 1, "y": 2, "z": 3 }] }]
        }
      },
      "expected": 3
    },
    {
      "description": "values: multiple values sorted for deterministic comparison",
      "body": {
        "$return": {
          "$let": { "vs": { "$call": "values", "$args": [{ "a": 30, "b": 10, "c": 20 }] } },
          "$in": {
            "$call": "sortBy",
            "$args": [{ "$params": ["x"], "$return": { "$var": "x" } }, { "$var": "vs" }]
          }
        }
      },
      "expected": [10, 20, 30]
    },
    {
      "description": "keys and values: same length",
      "body": {
        "$return": {
          "$let": {
            "obj": { "x": 10, "y": 20, "z": 30 },
            "kLen": {
              "$call": "length",
              "$args": [{ "$call": "keys", "$args": [{ "$var": "obj" }] }]
            },
            "vLen": {
              "$call": "length",
              "$args": [{ "$call": "values", "$args": [{ "$var": "obj" }] }]
            }
          },
          "$in": { "$call": "eq", "$args": [{ "$var": "kLen" }, { "$var": "vLen" }] }
        }
      },
      "expected": true
    },
    {
      "description": "keys: used with includes to check key existence",
      "body": {
        "$return": {
          "$let": { "ks": { "$call": "keys", "$args": [{ "name": "alice", "age": 30 }] } },
          "$in": { "$call": "includes", "$args": [{ "$var": "ks" }, "name"] }
        }
      },
      "expected": true
    },
    {
      "description": "hasKey: accepts an explicitly stringified numeric key",
      "body": {
        "$return": {
          "$call": "hasKey",
          "$args": [{ "1": "one" }, { "$call": "str", "$args": [1] }]
        }
      },
      "expected": true
    },
    {
      "description": "pick: accepts an explicitly stringified numeric key",
      "body": {
        "$return": {
          "$call": "pick",
          "$args": [{ "1": "one" }, [{ "$call": "str", "$args": [1] }]]
        }
      },
      "expected": { "1": "one" }
    },
    {
      "description": "omit: accepts an explicitly stringified numeric key",
      "body": {
        "$return": {
          "$call": "omit",
          "$args": [{ "1": "one", "2": "two" }, [{ "$call": "str", "$args": [1] }]]
        }
      },
      "expected": { "2": "two" }
    }
  ]
}
