{
  "description": "inline (anonymous) functions",
  "cases": [
    {
      "description": "inline square(5)",
      "body": {
        "$return": {
          "$call": {
            "$params": ["x"],
            "$return": { "$call": "mul", "$args": [{ "$var": "x" }, { "$var": "x" }] }
          },
          "$args": [5]
        }
      },
      "expected": 25
    },
    {
      "description": "nested inline: sumThenSquare(3, 4)",
      "body": {
        "$return": {
          "$call": {
            "$params": ["a", "b"],
            "$return": {
              "$call": {
                "$params": ["sum"],
                "$return": { "$call": "mul", "$args": [{ "$var": "sum" }, { "$var": "sum" }] }
              },
              "$args": [{ "$call": "add", "$args": [{ "$var": "a" }, { "$var": "b" }] }]
            }
          },
          "$args": [3, 4]
        }
      },
      "expected": 49
    }
  ]
}
