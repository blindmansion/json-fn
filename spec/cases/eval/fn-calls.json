{
  "description": "function calls",
  "cases": [
    {
      "description": "add(3, 4)",
      "body": { "$return": { "$call": "add", "$args": [3, 4] } },
      "expected": 7
    },
    {
      "description": "upper('hello')",
      "body": { "$return": { "$call": "upper", "$args": ["hello"] } },
      "expected": "HELLO"
    },
    {
      "description": "nested calls: mul(add(2,3), sub(10,4))",
      "body": {
        "$return": {
          "$call": "mul",
          "$args": [
            { "$call": "add", "$args": [2, 3] },
            { "$call": "sub", "$args": [10, 4] }
          ]
        }
      },
      "expected": 30
    },
    {
      "description": "$params binds arguments by name",
      "body": {
        "$params": ["a", "b"],
        "$return": { "$call": "add", "$args": [{ "$var": "a" }, { "$var": "b" }] }
      },
      "args": [10, 20],
      "expected": 30
    }
  ]
}
