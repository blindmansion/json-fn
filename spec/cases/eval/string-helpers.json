{
  "description": "string helper integration",
  "cases": [
    {
      "description": "trim then split pipeline",
      "body": {
        "$return": {
          "$let": { "trimmed": { "$call": "trim", "$args": ["  one two three  "] } },
          "$in": { "$call": "split", "$args": [{ "$var": "trimmed" }, " "] }
        }
      },
      "expected": ["one", "two", "three"]
    }
  ]
}
