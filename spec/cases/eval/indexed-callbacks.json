{
  "description": "ordinary and indexed array callbacks",
  "cases": [
    {
      "description": "map and mapIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "map",
            "$args": [
              {
                "$params": ["item"],
                "$return": { "$call": "mul", "$args": [{ "$var": "item" }, 2] }
              },
              [1, 2, 3]
            ]
          },
          {
            "$call": "mapIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": { "$call": "add", "$args": [{ "$var": "item" }, { "$var": "index" }] }
              },
              [1, 2, 3]
            ]
          }
        ]
      },
      "expected": [
        [2, 4, 6],
        [1, 3, 5]
      ]
    },
    {
      "description": "filter and filterIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "filter",
            "$args": [
              {
                "$params": ["item"],
                "$return": { "$call": "gt", "$args": [{ "$var": "item" }, 1] }
              },
              [1, 2, 3]
            ]
          },
          {
            "$call": "filterIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": { "$call": "gt", "$args": [{ "$var": "index" }, 0] }
              },
              [1, 2, 3]
            ]
          }
        ]
      },
      "expected": [
        [2, 3],
        [2, 3]
      ]
    },
    {
      "description": "reduce and reduceIndexed use binary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "reduce",
            "$args": [
              {
                "$params": ["acc", "item"],
                "$return": { "$call": "add", "$args": [{ "$var": "acc" }, { "$var": "item" }] }
              },
              0,
              [1, 2, 3]
            ]
          },
          {
            "$call": "reduceIndexed",
            "$args": [
              {
                "$params": ["acc", "item", "index"],
                "$return": { "$call": "add", "$args": [{ "$var": "acc" }, { "$var": "index" }] }
              },
              0,
              [10, 20, 30]
            ]
          }
        ]
      },
      "expected": [6, 3]
    },
    {
      "description": "find and findIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "find",
            "$args": [
              {
                "$params": ["item"],
                "$return": { "$call": "gt", "$args": [{ "$var": "item" }, 2] }
              },
              [1, 2, 3, 4]
            ]
          },
          {
            "$call": "findIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": { "$call": "eq", "$args": [{ "$var": "index" }, 1] }
              },
              [10, 20, 30]
            ]
          }
        ]
      },
      "expected": [3, 20]
    },
    {
      "description": "findIndex and findIndexIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "findIndex",
            "$args": [
              {
                "$params": ["item"],
                "$return": { "$call": "gt", "$args": [{ "$var": "item" }, 2] }
              },
              [1, 2, 3, 4]
            ]
          },
          {
            "$call": "findIndexIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": { "$call": "eq", "$args": [{ "$var": "index" }, 1] }
              },
              [10, 20, 30]
            ]
          }
        ]
      },
      "expected": [2, 1]
    },
    {
      "description": "some and someIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "some",
            "$args": [
              {
                "$params": ["item"],
                "$return": { "$call": "gt", "$args": [{ "$var": "item" }, 2] }
              },
              [1, 2, 3]
            ]
          },
          {
            "$call": "someIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": { "$call": "eq", "$args": [{ "$var": "index" }, 2] }
              },
              ["a", "b", "c"]
            ]
          }
        ]
      },
      "expected": [true, true]
    },
    {
      "description": "every and everyIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "every",
            "$args": [
              {
                "$params": ["item"],
                "$return": { "$call": "gt", "$args": [{ "$var": "item" }, 0] }
              },
              [1, 2, 3]
            ]
          },
          {
            "$call": "everyIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": { "$call": "lt", "$args": [{ "$var": "index" }, 3] }
              },
              ["a", "b", "c"]
            ]
          }
        ]
      },
      "expected": [true, true]
    },
    {
      "description": "count and countIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "count",
            "$args": [
              {
                "$params": ["item"],
                "$return": { "$call": "gt", "$args": [{ "$var": "item" }, 1] }
              },
              [1, 2, 3]
            ]
          },
          {
            "$call": "countIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": { "$call": "gte", "$args": [{ "$var": "index" }, 1] }
              },
              ["a", "b", "c"]
            ]
          }
        ]
      },
      "expected": [2, 2]
    },
    {
      "description": "flatMap and flatMapIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "flatMap",
            "$args": [
              { "$params": ["item"], "$return": [{ "$var": "item" }, { "$var": "item" }] },
              [1, 2]
            ]
          },
          {
            "$call": "flatMapIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": [{ "$var": "item" }, { "$var": "index" }]
              },
              ["a", "b"]
            ]
          }
        ]
      },
      "expected": [
        [1, 1, 2, 2],
        ["a", 0, "b", 1]
      ]
    },
    {
      "description": "groupBy and groupByIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "groupBy",
            "$args": [
              {
                "$params": ["item"],
                "$return": { "$call": "mod", "$args": [{ "$var": "item" }, 2] }
              },
              [1, 2, 3, 4]
            ]
          },
          {
            "$call": "groupByIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": { "$call": "mod", "$args": [{ "$var": "index" }, 2] }
              },
              ["a", "b", "c", "d"]
            ]
          }
        ]
      },
      "expected": [
        { "0": [2, 4], "1": [1, 3] },
        { "0": ["a", "c"], "1": ["b", "d"] }
      ]
    },
    {
      "description": "sortBy and sortByIndexed use unary and indexed callbacks",
      "body": {
        "$return": [
          {
            "$call": "sortBy",
            "$args": [
              { "$params": ["item"], "$return": { "$call": "abs", "$args": [{ "$var": "item" }] } },
              [-3, 1, -2]
            ]
          },
          {
            "$call": "sortByIndexed",
            "$args": [
              {
                "$params": ["item", "index"],
                "$return": { "$call": "neg", "$args": [{ "$var": "index" }] }
              },
              ["a", "b", "c"]
            ]
          }
        ]
      },
      "expected": [
        [1, -2, -3],
        ["c", "b", "a"]
      ]
    },
    {
      "description": "ordinary callbacks reject the old indexed shape",
      "body": {
        "$return": {
          "$call": "map",
          "$args": [{ "$params": ["item", "index"], "$return": { "$var": "item" } }, [1]]
        }
      },
      "error": "Missing required argument at parameter position 2"
    },
    {
      "description": "indexed callbacks reject the ordinary shape",
      "body": {
        "$return": {
          "$call": "mapIndexed",
          "$args": [{ "$params": ["item"], "$return": { "$var": "item" } }, [1]]
        }
      },
      "error": "Expected exactly 1 argument, received 2"
    },
    {
      "description": "ordinary reduce rejects the old indexed shape",
      "body": {
        "$return": {
          "$call": "reduce",
          "$args": [{ "$params": ["acc", "item", "index"], "$return": { "$var": "acc" } }, 0, [1]]
        }
      },
      "error": "Missing required argument at parameter position 3"
    },
    {
      "description": "reduceIndexed rejects the ordinary shape",
      "body": {
        "$return": {
          "$call": "reduceIndexed",
          "$args": [{ "$params": ["acc", "item"], "$return": { "$var": "acc" } }, 0, [1]]
        }
      },
      "error": "Expected exactly 2 arguments, received 3"
    }
  ]
}
