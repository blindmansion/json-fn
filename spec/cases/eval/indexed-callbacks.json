{
  "description": "ordinary and indexed callback arity integration",
  "cases": [
    {
      "description": "ordinary callbacks reject the old indexed shape",
      "body": {
        "$return": {
          "$call": "map",
          "$args": [{ "$params": ["item", "index"], "$return": { "$var": "item" } }, [1]]
        }
      },
      "error": "Missing required argument at parameter position 2"
    },
    {
      "description": "indexed callbacks reject the ordinary shape",
      "body": {
        "$return": {
          "$call": "mapIndexed",
          "$args": [{ "$params": ["item"], "$return": { "$var": "item" } }, [1]]
        }
      },
      "error": "Expected exactly 1 argument, received 2"
    },
    {
      "description": "ordinary reduce rejects the old indexed shape",
      "body": {
        "$return": {
          "$call": "reduce",
          "$args": [{ "$params": ["acc", "item", "index"], "$return": { "$var": "acc" } }, 0, [1]]
        }
      },
      "error": "Missing required argument at parameter position 3"
    },
    {
      "description": "reduceIndexed rejects the ordinary shape",
      "body": {
        "$return": {
          "$call": "reduceIndexed",
          "$args": [{ "$params": ["acc", "item"], "$return": { "$var": "acc" } }, 0, [1]]
        }
      },
      "error": "Expected exactly 2 arguments, received 3"
    }
  ]
}
