{
  "description": "higher-order evaluator integration across callback references and nested calls",
  "cases": [
    {
      "description": "flatten: can be passed directly as a unary callback",
      "body": {
        "$return": {
          "$call": "map",
          "$args": [
            "flatten",
            [
              [[1], [2, 3]],
              [[4, 5], [6]]
            ]
          ]
        }
      },
      "expected": [
        [1, 2, 3],
        [4, 5, 6]
      ]
    },
    {
      "description": "setAt: nested calls replace multiple positions",
      "body": {
        "$return": {
          "$call": "setAt",
          "$args": [{ "$call": "setAt", "$args": [[0, 0, 0, 0, 0], 1, "X"] }, 3, "Y"]
        }
      },
      "expected": [0, "X", 0, "Y", 0]
    },
    {
      "description": "groupBy: works with named function",
      "body": { "$return": { "$call": "groupBy", "$args": [{ "$fn": "parity" }, [1, 2, 3, 4]] } },
      "functions": {
        "parity": {
          "$params": ["n"],
          "$return": {
            "$if": {
              "$call": "eq",
              "$args": [{ "$call": "mod", "$args": [{ "$var": "n" }, 2] }, 0]
            },
            "$then": "even",
            "$else": "odd"
          }
        }
      },
      "expected": { "odd": [1, 3], "even": [2, 4] }
    },
    {
      "description": "pipe: works with inline functions",
      "body": {
        "$return": {
          "$call": "pipe",
          "$args": [
            [
              { "$params": ["x"], "$return": { "$call": "mul", "$args": [{ "$var": "x" }, 2] } },
              { "$params": ["x"], "$return": { "$call": "add", "$args": [{ "$var": "x" }, 1] } }
            ],
            5
          ]
        }
      },
      "expected": 11
    },
    {
      "description": "pipe: works with named functions",
      "body": {
        "$return": { "$call": "pipe", "$args": [[{ "$fn": "double" }, { "$fn": "addTen" }], 3] }
      },
      "functions": {
        "double": {
          "$params": ["x"],
          "$return": { "$call": "mul", "$args": [{ "$var": "x" }, 2] }
        },
        "addTen": {
          "$params": ["x"],
          "$return": { "$call": "add", "$args": [{ "$var": "x" }, 10] }
        }
      },
      "expected": 16
    },
    {
      "description": "pipe: mixes named and inline functions",
      "body": {
        "$return": {
          "$call": "pipe",
          "$args": [
            [
              { "$fn": "neg" },
              {
                "$params": ["x"],
                "$return": { "$call": "mul", "$args": [{ "$var": "x" }, { "$var": "x" }] }
              },
              { "$fn": "str" }
            ],
            3
          ]
        }
      },
      "expected": "9"
    },
    {
      "description": "pipe: composes string splitting and array length",
      "body": {
        "$return": {
          "$call": "pipe",
          "$args": [
            [
              {
                "$params": ["s"],
                "$return": { "$call": "split", "$args": [{ "$var": "s" }, " "] }
              },
              { "$fn": "length" }
            ],
            "hello world foo"
          ]
        }
      },
      "expected": 3
    }
  ]
}
