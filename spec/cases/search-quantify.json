{
  "description": "search, quantify, and sort",
  "cases": [
    {
      "description": "find: returns first matching element",
      "body": {
        "$return": {
          "$call": "find",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "gt", "$args": [{ "$var": "x" }, 3] } },
            [1, 2, 3, 4, 5]
          ]
        }
      },
      "expected": 4
    },
    {
      "description": "find: returns null when no match",
      "body": {
        "$return": {
          "$call": "find",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "gt", "$args": [{ "$var": "x" }, 100] } },
            [1, 2, 3]
          ]
        }
      },
      "expected": null
    },
    {
      "description": "find: returns first of multiple matches",
      "body": {
        "$return": {
          "$call": "find",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "gt", "$args": [{ "$var": "x" }, 2] } },
            [1, 5, 3, 4]
          ]
        }
      },
      "expected": 5
    },
    {
      "description": "find: empty array returns null",
      "body": {
        "$return": { "$call": "find", "$args": [{ "$params": ["x"], "$return": true }, []] }
      },
      "expected": null
    },
    {
      "description": "find: works with objects in array",
      "body": {
        "$return": {
          "$call": "find",
          "$args": [
            {
              "$params": ["item"],
              "$return": {
                "$call": "gt",
                "$args": [{ "$get": "age", "$from": { "$var": "item" } }, 30]
              }
            },
            [
              { "name": "alice", "age": 25 },
              { "name": "bob", "age": 35 },
              { "name": "carol", "age": 28 }
            ]
          ]
        }
      },
      "expected": { "name": "bob", "age": 35 }
    },
    {
      "description": "findIndex: returns index of first match",
      "body": {
        "$return": {
          "$call": "findIndex",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "gt", "$args": [{ "$var": "x" }, 3] } },
            [1, 2, 3, 4, 5]
          ]
        }
      },
      "expected": 3
    },
    {
      "description": "findIndex: returns null when no match",
      "body": {
        "$return": {
          "$call": "findIndex",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "gt", "$args": [{ "$var": "x" }, 100] } },
            [1, 2, 3]
          ]
        }
      },
      "expected": null
    },
    {
      "description": "findIndex: empty array returns null",
      "body": {
        "$return": { "$call": "findIndex", "$args": [{ "$params": ["x"], "$return": true }, []] }
      },
      "expected": null
    },
    {
      "description": "findIndex: callback receives index",
      "body": {
        "$return": {
          "$call": "findIndex",
          "$args": [
            { "$params": ["x", "i"], "$return": { "$call": "eq", "$args": [{ "$var": "i" }, 2] } },
            ["a", "b", "c", "d"]
          ]
        }
      },
      "expected": 2
    },
    {
      "description": "some: true when at least one matches",
      "body": {
        "$return": {
          "$call": "some",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "gt", "$args": [{ "$var": "x" }, 3] } },
            [1, 2, 3, 4, 5]
          ]
        }
      },
      "expected": true
    },
    {
      "description": "some: false when none match",
      "body": {
        "$return": {
          "$call": "some",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "gt", "$args": [{ "$var": "x" }, 100] } },
            [1, 2, 3]
          ]
        }
      },
      "expected": false
    },
    {
      "description": "some: false for empty array",
      "body": {
        "$return": { "$call": "some", "$args": [{ "$params": ["x"], "$return": true }, []] }
      },
      "expected": false
    },
    {
      "description": "every: true when all match",
      "body": {
        "$return": {
          "$call": "every",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "gt", "$args": [{ "$var": "x" }, 0] } },
            [1, 2, 3, 4, 5]
          ]
        }
      },
      "expected": true
    },
    {
      "description": "every: false when one fails",
      "body": {
        "$return": {
          "$call": "every",
          "$args": [
            { "$params": ["x"], "$return": { "$call": "gt", "$args": [{ "$var": "x" }, 3] } },
            [1, 2, 3, 4, 5]
          ]
        }
      },
      "expected": false
    },
    {
      "description": "every: true for empty array (vacuous truth)",
      "body": {
        "$return": { "$call": "every", "$args": [{ "$params": ["x"], "$return": false }, []] }
      },
      "expected": true
    },
    {
      "description": "sort: ascending numeric sort",
      "body": {
        "$return": {
          "$call": "sort",
          "$args": [
            {
              "$params": ["a", "b"],
              "$return": { "$call": "sub", "$args": [{ "$var": "a" }, { "$var": "b" }] }
            },
            [3, 1, 4, 1, 5, 9, 2, 6]
          ]
        }
      },
      "expected": [1, 1, 2, 3, 4, 5, 6, 9]
    },
    {
      "description": "sort: descending numeric sort",
      "body": {
        "$return": {
          "$call": "sort",
          "$args": [
            {
              "$params": ["a", "b"],
              "$return": { "$call": "sub", "$args": [{ "$var": "b" }, { "$var": "a" }] }
            },
            [3, 1, 4, 1, 5]
          ]
        }
      },
      "expected": [5, 4, 3, 1, 1]
    },
    {
      "description": "sort: empty array returns empty array",
      "body": {
        "$return": {
          "$call": "sort",
          "$args": [
            {
              "$params": ["a", "b"],
              "$return": { "$call": "sub", "$args": [{ "$var": "a" }, { "$var": "b" }] }
            },
            []
          ]
        }
      },
      "expected": []
    },
    {
      "description": "sort: single element array",
      "body": {
        "$return": {
          "$call": "sort",
          "$args": [
            {
              "$params": ["a", "b"],
              "$return": { "$call": "sub", "$args": [{ "$var": "a" }, { "$var": "b" }] }
            },
            [42]
          ]
        }
      },
      "expected": [42]
    },
    {
      "description": "sort: stable sort preserves order of equal elements",
      "body": {
        "$return": {
          "$call": "sort",
          "$args": [
            {
              "$params": ["a", "b"],
              "$return": {
                "$call": "sub",
                "$args": [
                  { "$get": "priority", "$from": { "$var": "a" } },
                  { "$get": "priority", "$from": { "$var": "b" } }
                ]
              }
            },
            [
              { "name": "first", "priority": 1 },
              { "name": "second", "priority": 2 },
              { "name": "third", "priority": 1 }
            ]
          ]
        }
      },
      "expected": [
        { "name": "first", "priority": 1 },
        { "name": "third", "priority": 1 },
        { "name": "second", "priority": 2 }
      ]
    },
    {
      "description": "find + findIndex: consistent results",
      "body": {
        "arr": [10, 20, 30, 40, 50],
        "pred": { "$params": ["x"], "$return": { "$call": "gte", "$args": [{ "$var": "x" }, 30] } },
        "found": { "$call": "find", "$args": [{ "$var": "pred" }, { "$var": "arr" }] },
        "idx": { "$call": "findIndex", "$args": [{ "$var": "pred" }, { "$var": "arr" }] },
        "$return": [{ "$var": "found" }, { "$var": "idx" }]
      },
      "expected": [30, 2]
    }
  ]
}
