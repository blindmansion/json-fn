      "value": { "$raw": 42 },
      "canonical": "{\"$raw\":42}",
      "valueHash": "jfn:value:v1:sha256:2f5921f2444e7188885400678a6f21a7d19bb88fe3b808236985507cf7dc830c"
    },
    {
      "name": "the bare scalar",
      "value": 42,
      "canonical": "42",
      "valueHash": "jfn:value:v1:sha256:19653bfdc2ff32ea3d7561694239cdd496b7a238613ef96a07b5c76444617780"
    },
    {
      "name": "redundant raw wrapper around static data is preserved",
      "value": { "$raw": { "config": [1, 2, 3] } },
