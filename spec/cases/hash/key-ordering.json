{
  "description": "Canonical encoding sorts object keys by UTF-16 code units; structurally equal objects that differ only in authored key order share one canonical form and one value hash",
  "cases": [
    {
      "name": "already sorted",
      "value": { "a": 1, "b": 2, "c": 3 },
      "canonical": "{\"a\":1,\"b\":2,\"c\":3}",
      "valueHash": "jfn:value:v1:sha256:32d109c96a3b17190b87cf02fe8c6a6d4f1af2b74e697158c9c3aee36f87c1c2"
    },
    {
      "name": "reverse authored order",
      "value": { "c": 3, "b": 2, "a": 1 },
      "canonical": "{\"a\":1,\"b\":2,\"c\":3}",
      "valueHash": "jfn:value:v1:sha256:32d109c96a3b17190b87cf02fe8c6a6d4f1af2b74e697158c9c3aee36f87c1c2"
    },
    {
      "name": "interleaved authored order",
      "value": { "b": 2, "a": 1, "c": 3 },
      "canonical": "{\"a\":1,\"b\":2,\"c\":3}",
      "valueHash": "jfn:value:v1:sha256:32d109c96a3b17190b87cf02fe8c6a6d4f1af2b74e697158c9c3aee36f87c1c2"
    },
    {
      "name": "nested objects sort at every level",
      "value": { "outer": { "z": 1, "a": { "m": 2, "b": 3 } }, "first": true },
      "canonical": "{\"first\":true,\"outer\":{\"a\":{\"b\":3,\"m\":2},\"z\":1}}",
      "valueHash": "jfn:value:v1:sha256:a428b56cf0119a7f2d4ae73dcd644fba098176bc194a55c43292187a84ba3c2f"
    },
    {
      "name": "empty-string key sorts first",
      "value": { "": 0, "a": 1 },
      "canonical": "{\"\":0,\"a\":1}",
      "valueHash": "jfn:value:v1:sha256:420668d2f7d9a16056df7edfa973e8a1d71676c05c6c9d03d64efdd3596bd88e"
    },
    {
      "name": "digits sort before uppercase before lowercase",
