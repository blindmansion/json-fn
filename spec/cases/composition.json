{
  "description": "composing features together",
  "functions": {
    "fact": {
      "$params": ["n"],
      "$return": {
        "$if": { "$fn": ["lte", { "$var": "n" }, 1] },
        "$then": 1,
        "$else": {
          "$fn": [
            "mul",
            { "$var": "n" },
            {
              "$fn": ["fact", { "$fn": ["sub", { "$var": "n" }, 1] }]
            }
          ]
        }
      }
    },
    "isEven": {
      "$params": ["n"],
      "remainder": { "$fn": ["mod", { "$var": "n" }, 2] },
      "$return": { "$fn": ["eq", { "$var": "remainder" }, 0] }
    }
  },
  "cases": [
    {
      "description": "isEven(fact(6)) — combines named functions, variables, conditionals",
      "body": {
        "result": { "$fn": ["fact", 6] },
        "check": { "$fn": ["isEven", { "$var": "result" }] },
        "$return": {
          "$if": { "$var": "check" },
          "$then": { "$fn": ["strcat", "720 is ", "even"] },
          "$else": { "$fn": ["strcat", "720 is ", "odd"] }
        }
      },
      "expected": "720 is even"
    },
    {
      "description": "greeting from parts using variables and strcat",
      "body": {
        "$params": ["first", "last"],
        "full": {
          "$fn": ["strcat", { "$var": "first" }, { "$fn": ["strcat", " ", { "$var": "last" }] }]
        },
        "$return": { "$fn": ["strcat", "Hello, ", { "$var": "full" }] }
      },
      "args": ["Ada", "Lovelace"],
      "expected": "Hello, Ada Lovelace"
    }
  ]
}
