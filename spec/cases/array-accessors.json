{
  "description": "array accessors",
  "cases": [
    {
      "description": "head: returns first element",
      "body": { "$return": { "$call": "head", "$args": [[10, 20, 30]] } },
      "expected": 10
    },
    {
      "description": "head: returns null for empty array",
      "body": { "$return": { "$call": "head", "$args": [[]] } },
      "expected": null
    },
    {
      "description": "head: single element array",
      "body": { "$return": { "$call": "head", "$args": [[42]] } },
      "expected": 42
    },
    {
      "description": "head: works with mixed types",
      "body": { "$return": { "$call": "head", "$args": [["hello", 2, true]] } },
      "expected": "hello"
    },
    {
      "description": "last: returns last element",
      "body": { "$return": { "$call": "last", "$args": [[10, 20, 30]] } },
      "expected": 30
    },
    {
      "description": "last: returns null for empty array",
      "body": { "$return": { "$call": "last", "$args": [[]] } },
      "expected": null
    },
    {
      "description": "last: single element array",
      "body": { "$return": { "$call": "last", "$args": [[42]] } },
      "expected": 42
    },
    {
      "description": "tail: returns all but the first element",
      "body": { "$return": { "$call": "tail", "$args": [[10, 20, 30]] } },
      "expected": [20, 30]
    },
    {
      "description": "tail: returns empty array for empty input",
      "body": { "$return": { "$call": "tail", "$args": [[]] } },
      "expected": []
    },
    {
      "description": "tail: returns empty array for single element",
      "body": { "$return": { "$call": "tail", "$args": [[42]] } },
      "expected": []
    },
    {
      "description": "slice: array from start index",
      "body": { "$return": { "$call": "slice", "$args": [[10, 20, 30, 40, 50], 2] } },
      "expected": [30, 40, 50]
    },
    {
      "description": "slice: array with start and end",
      "body": { "$return": { "$call": "slice", "$args": [[10, 20, 30, 40, 50], 1, 3] } },
      "expected": [20, 30]
    },
    {
      "description": "slice: negative start counts from end",
      "body": { "$return": { "$call": "slice", "$args": [[10, 20, 30, 40, 50], -2] } },
      "expected": [40, 50]
    },
    {
      "description": "slice: negative end counts from end",
      "body": { "$return": { "$call": "slice", "$args": [[10, 20, 30, 40, 50], 1, -1] } },
      "expected": [20, 30, 40]
    },
    {
      "description": "slice: start beyond length returns empty",
      "body": { "$return": { "$call": "slice", "$args": [[1, 2, 3], 10] } },
      "expected": []
    },
    {
      "description": "slice: works on strings",
      "body": { "$return": { "$call": "slice", "$args": ["hello world", 6] } },
      "expected": "world"
    },
    {
      "description": "slice: string with start and end",
      "body": { "$return": { "$call": "slice", "$args": ["hello world", 0, 5] } },
      "expected": "hello"
    },
    {
      "description": "reverse: reverses array order",
      "body": { "$return": { "$call": "reverse", "$args": [[1, 2, 3, 4, 5]] } },
      "expected": [5, 4, 3, 2, 1]
    },
    {
      "description": "reverse: empty array returns empty array",
      "body": { "$return": { "$call": "reverse", "$args": [[]] } },
      "expected": []
    },
    {
      "description": "reverse: single element unchanged",
      "body": { "$return": { "$call": "reverse", "$args": [[42]] } },
      "expected": [42]
    },
    {
      "description": "reverse: works with mixed types",
      "body": { "$return": { "$call": "reverse", "$args": [["a", 1, true, null]] } },
      "expected": [null, true, 1, "a"]
    },
    {
      "description": "indexOf: found in array",
      "body": { "$return": { "$call": "indexOf", "$args": [[10, 20, 30, 40], 30] } },
      "expected": 2
    },
    {
      "description": "indexOf: not found in array returns -1",
      "body": { "$return": { "$call": "indexOf", "$args": [[10, 20, 30], 99] } },
      "expected": -1
    },
    {
      "description": "indexOf: returns first occurrence",
      "body": { "$return": { "$call": "indexOf", "$args": [[1, 2, 3, 2, 1], 2] } },
      "expected": 1
    },
    {
      "description": "indexOf: uses structural equality for arrays",
      "body": { "$return": { "$call": "indexOf", "$args": [[[1]], [1]] } },
      "expected": 0
    },
    {
      "description": "indexOf: uses structural equality for objects",
      "body": { "$return": { "$call": "indexOf", "$args": [[{ "x": 1 }], { "x": 1 }] } },
      "expected": 0
    },
    {
      "description": "indexOf: found in string",
      "body": { "$return": { "$call": "indexOf", "$args": ["hello world", "world"] } },
      "expected": 6
    },
    {
      "description": "indexOf: not found in string returns -1",
      "body": { "$return": { "$call": "indexOf", "$args": ["hello", "xyz"] } },
      "expected": -1
    },
    {
      "description": "includes: true when element exists in array",
      "body": { "$return": { "$call": "includes", "$args": [[1, 2, 3], 2] } },
      "expected": true
    },
    {
      "description": "includes: false when element missing from array",
      "body": { "$return": { "$call": "includes", "$args": [[1, 2, 3], 5] } },
      "expected": false
    },
    {
      "description": "includes: uses structural equality for arrays",
      "body": { "$return": { "$call": "includes", "$args": [[[1]], [1]] } },
      "expected": true
    },
    {
      "description": "includes: uses structural equality for objects",
      "body": { "$return": { "$call": "includes", "$args": [[{ "x": 1 }], { "x": 1 }] } },
      "expected": true
    },
    {
      "description": "includes: true when substring exists",
      "body": { "$return": { "$call": "includes", "$args": ["hello world", "world"] } },
      "expected": true
    },
    {
      "description": "includes: false when substring missing",
      "body": { "$return": { "$call": "includes", "$args": ["hello", "xyz"] } },
      "expected": false
    },
    {
      "description": "head and last: pipeline to extract first and last",
      "body": {
        "arr": [10, 20, 30, 40, 50],
        "first": { "$call": "head", "$args": [{ "$var": "arr" }] },
        "end": { "$call": "last", "$args": [{ "$var": "arr" }] },
        "$return": { "$call": "add", "$args": [{ "$var": "first" }, { "$var": "end" }] }
      },
      "expected": 60
    }
  ]
}
