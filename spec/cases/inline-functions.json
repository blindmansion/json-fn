{
  "description": "inline (anonymous) functions",
  "cases": [
    {
      "description": "inline square(5)",
      "body": {
        "$return": {
          "$fn": [
            {
              "$params": ["x"],
              "$return": {
                "$fn": [
                  "mul",
                  {
                    "$var": "x"
                  },
                  {
                    "$var": "x"
                  }
                ]
              }
            },
            5
          ]
        }
      },
      "expected": 25
    },
    {
      "description": "nested inline: sumThenSquare(3, 4)",
      "body": {
        "$return": {
          "$fn": [
            {
              "$params": ["a", "b"],
              "$return": {
                "$fn": [
                  {
                    "$params": ["sum"],
                    "$return": {
                      "$fn": [
                        "mul",
                        {
                          "$var": "sum"
                        },
                        {
                          "$var": "sum"
                        }
                      ]
                    }
                  },
                  {
                    "$fn": [
                      "add",
                      {
                        "$var": "a"
                      },
                      {
                        "$var": "b"
                      }
                    ]
                  }
                ]
              }
            },
            3,
            4
          ]
        }
      },
      "expected": 49
    }
  ]
}
