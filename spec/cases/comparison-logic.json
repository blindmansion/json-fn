{
  "description": "comparison and logic",
  "cases": [
    {
      "description": "neq: true for different numbers",
      "body": { "$return": { "$fn": ["neq", 1, 2] } },
      "expected": true
    },
    {
      "description": "neq: false for same numbers",
      "body": { "$return": { "$fn": ["neq", 42, 42] } },
      "expected": false
    },
    {
      "description": "neq: true for different strings",
      "body": { "$return": { "$fn": ["neq", "hello", "world"] } },
      "expected": true
    },
    {
      "description": "neq: false for same strings",
      "body": { "$return": { "$fn": ["neq", "hello", "hello"] } },
      "expected": false
    },
    {
      "description": "neq: true for different booleans",
      "body": { "$return": { "$fn": ["neq", true, false] } },
      "expected": true
    },
    {
      "description": "neq: false for same booleans",
      "body": { "$return": { "$fn": ["neq", true, true] } },
      "expected": false
    },
    {
      "description": "neq: false for null vs null",
      "body": { "$return": { "$fn": ["neq", null, null] } },
      "expected": false
    },
    {
      "description": "neq: true for null vs zero",
      "body": { "$return": { "$fn": ["neq", null, 0] } },
      "expected": true
    },
    {
      "description": "neq: true for number vs string of same value",
      "body": { "$return": { "$fn": ["neq", 1, "1"] } },
      "expected": true
    },
    {
      "description": "not: negates true",
      "body": { "$return": { "$fn": ["not", true] } },
      "expected": false
    },
    {
      "description": "not: negates false",
      "body": { "$return": { "$fn": ["not", false] } },
      "expected": true
    },
    {
      "description": "not: double negation returns original",
      "body": {
        "$return": {
          "$fn": ["not", { "$fn": ["not", true] }]
        }
      },
      "expected": true
    },
    {
      "description": "not: combined with comparison",
      "body": {
        "$return": {
          "$fn": ["not", { "$fn": ["eq", 1, 2] }]
        }
      },
      "expected": true
    },
    {
      "description": "neq: used as filter predicate",
      "body": {
        "$return": {
          "$fn": [
            "filter",
            {
              "$params": ["x"],
              "$return": { "$fn": ["neq", { "$var": "x" }, 0] }
            },
            [0, 1, 0, 2, 0, 3]
          ]
        }
      },
      "expected": [1, 2, 3]
    },
    {
      "description": "not: used to invert filter logic",
      "body": {
        "$return": {
          "$fn": [
            "filter",
            {
              "$params": ["x"],
              "$return": {
                "$fn": ["not", { "$fn": ["gt", { "$var": "x" }, 3] }]
              }
            },
            [1, 2, 3, 4, 5]
          ]
        }
      },
      "expected": [1, 2, 3]
    },
    {
      "description": "$eq: true for equal evaluated values",
      "body": {
        "$return": {
          "$eq": [{ "$fn": ["add", 1, 1] }, 2]
        }
      },
      "expected": true
    },
    {
      "description": "$neq: true for unequal evaluated values",
      "body": {
        "$return": {
          "$neq": [{ "$fn": ["str", 1] }, 1]
        }
      },
      "expected": true
    },
    {
      "description": "$lt/$lte/$gt/$gte: comparison shorthands",
      "body": {
        "$return": {
          "$and": [{ "$lt": [1, 2] }, { "$lte": [2, 2] }, { "$gt": [3, 2] }, { "$gte": [3, 3] }]
        }
      },
      "expected": true
    },
    {
      "description": "$not: negates truthy/falsy expression results",
      "body": {
        "$return": {
          "$and": [
            { "$not": false },
            { "$not": null },
            { "$not": 0 },
            { "$not": "" },
            { "$not": { "$eq": [1, 2] } }
          ]
        }
      },
      "expected": true
    },
    {
      "description": "$not: false for truthy values",
      "body": { "$return": { "$not": "value" } },
      "expected": false
    },
    {
      "description": "$eq: can be used directly in conditionals",
      "body": {
        "$params": ["cmd"],
        "$return": {
          "$if": { "$eq": [{ "$var": "cmd" }, "show"] },
          "$then": "display",
          "$else": "move"
        }
      },
      "args": ["show"],
      "expected": "display"
    },
    {
      "description": "$eq: only uses strict scalar equality for arrays",
      "body": {
        "$return": { "$eq": [[1], [1]] }
      },
      "expected": false
    },
    {
      "description": "$eq: only uses strict scalar equality for objects",
      "body": {
        "$return": { "$eq": [{ "x": 1 }, { "x": 1 }] }
      },
      "expected": false
    },
    {
      "description": "eq: only uses strict scalar equality for arrays",
      "body": {
        "$return": { "$fn": ["eq", [1], [1]] }
      },
      "expected": false
    },
    {
      "description": "neq: true for structurally equal arrays",
      "body": {
        "$return": { "$fn": ["neq", [1], [1]] }
      },
      "expected": true
    },
    {
      "description": "eq: only uses strict scalar equality for objects",
      "body": {
        "$return": { "$fn": ["eq", { "x": 1 }, { "x": 1 }] }
      },
      "expected": false
    },
    {
      "description": "neq: true for structurally equal objects",
      "body": {
        "$return": { "$fn": ["neq", { "x": 1 }, { "x": 1 }] }
      },
      "expected": true
    },
    {
      "description": "jsonEq: true for structurally equal arrays",
      "body": {
        "$return": {
          "$fn": ["jsonEq", [1, { "x": [true, null] }], [1, { "x": [true, null] }]]
        }
      },
      "expected": true
    },
    {
      "description": "jsonEq: true for structurally equal objects regardless of key order",
      "body": {
        "$return": {
          "$fn": ["jsonEq", { "a": 1, "b": [2, 3] }, { "b": [2, 3], "a": 1 }]
        }
      },
      "expected": true
    },
    {
      "description": "jsonEq: false when array order differs",
      "body": {
        "$return": { "$fn": ["jsonEq", [1, 2, 3], [3, 2, 1]] }
      },
      "expected": false
    },
    {
      "description": "jsonEq: false for boolean vs number",
      "body": { "$return": { "$fn": ["jsonEq", true, 1] } },
      "expected": false
    },
    {
      "description": "jsonEq: false for number vs string",
      "body": { "$return": { "$fn": ["jsonEq", 1, "1"] } },
      "expected": false
    },
    {
      "description": "jsonNeq: negates jsonEq",
      "body": {
        "$return": {
          "$and": [
            { "$fn": ["jsonNeq", { "x": 1 }, { "x": 2 }] },
            {
              "$not": {
                "$fn": ["jsonNeq", { "x": [1] }, { "x": [1] }]
              }
            }
          ]
        }
      },
      "expected": true
    },
    {
      "description": "$eq: rejects non-array operands",
      "body": { "$return": { "$eq": 1 } },
      "error": "$eq must be an array of two expressions"
    },
    {
      "description": "$eq: rejects wrong arity",
      "body": { "$return": { "$eq": [1, 1, 1] } },
      "error": "$eq must be an array of two expressions"
    },
    {
      "description": "$gt: rejects sibling expression properties",
      "body": { "$return": { "$gt": [2, 1], "$lt": [1, 2] } },
      "error": "$gt expressions cannot have other properties"
    },
    {
      "description": "$not: rejects sibling expression properties",
      "body": { "$return": { "$not": true, "$eq": [1, 1] } },
      "error": "$eq expressions cannot have other properties"
    }
  ]
}
