{
  "description": "name resolution — unified lexical-first shadowing + bare registry references",
  "cases": [
    {
      "description": "a function-valued param shadows an operator (x + 1 uses the passed `add`)",
      "body": { "$params": ["add", "x"], "$return": { "$fn": ["add", { "$var": "x" }, 1] } },
      "args": ["sub", 10],
      "expected": 9
    },
    {
      "description": "a function-valued param shadows a stdlib function in a direct call",
      "body": { "$params": ["map"], "$return": { "$fn": ["map", 2] } },
      "args": [{ "$params": ["x"], "$return": { "$fn": ["mul", { "$var": "x" }, 10] } }],
      "expected": 20
    },
    {
      "description": "a param shadow survives an escaping closure (captured at creation)",
      "functions": {
        "makeMapper": {
          "$params": ["map"],
          "$return": { "$params": ["x"], "$return": { "$fn": ["map", { "$var": "x" }] } }
        }
      },
      "body": {
        "$return": {
          "$fn": [
            {
              "$fn": [
                "makeMapper",
                { "$params": ["n"], "$return": { "$fn": ["mul", { "$var": "n" }, 10] } }
              ]
            },
            5
          ]
        }
      },
      "expected": 50
    },
    {
      "description": "compose captures both fn params through an escaping closure (incl. a stdlib-colliding `add`)",
      "functions": {
        "compose": {
          "$params": ["add", "g"],
          "$return": {
            "$params": ["x"],
            "$return": { "$fn": ["add", { "$fn": ["g", { "$var": "x" }] }] }
          }
        }
      },
      "body": {
        "$return": {
          "$fn": [
            {
              "$fn": [
                "compose",
                { "$params": ["n"], "$return": { "$fn": ["mul", { "$var": "n" }, 10] } },
                { "$params": ["n"], "$return": { "$fn": ["add", { "$var": "n" }, 1] } }
              ]
            },
            5
          ]
        }
      },
      "expected": 60
    },
    {
      "description": "a where-local function shadows stdlib `length`",
      "body": {
        "$params": ["x"],
        "length": { "$params": ["v"], "$return": 999 },
        "$return": { "$fn": ["length", { "$var": "x" }] }
      },
      "args": [[1, 2, 3]],
      "expected": 999
    },
    {
      "description": "a where-local function shadows an operator (`add` → subtracts)",
      "body": {
        "$params": ["x"],
        "add": {
          "$params": ["a", "b"],
          "$return": { "$fn": ["sub", { "$var": "a" }, { "$var": "b" }] }
        },
        "$return": { "$fn": ["add", { "$var": "x" }, 1] }
      },
      "args": [10],
      "expected": 9
    },
    {
      "description": "local recursion still dispatches through the registry (canary)",
      "body": {
        "$params": ["n"],
        "fact": {
          "$params": ["m"],
          "$return": {
            "$if": { "$lte": [{ "$var": "m" }, 1] },
            "$then": 1,
            "$else": {
              "$fn": [
                "mul",
                { "$var": "m" },
                { "$fn": ["fact", { "$fn": ["sub", { "$var": "m" }, 1] }] }
              ]
            }
          }
        },
        "$return": { "$fn": ["fact", { "$var": "n" }] }
      },
      "args": [5],
      "expected": 120
    },
    {
      "description": "mutual recursion via where-locals stays green (even)",
      "body": {
        "$params": ["n"],
        "isEven": {
          "$params": ["m"],
          "$return": {
            "$if": { "$eq": [{ "$var": "m" }, 0] },
            "$then": true,
            "$else": { "$fn": ["isOdd", { "$fn": ["sub", { "$var": "m" }, 1] }] }
          }
        },
        "isOdd": {
          "$params": ["m"],
          "$return": {
            "$if": { "$eq": [{ "$var": "m" }, 0] },
            "$then": false,
            "$else": { "$fn": ["isEven", { "$fn": ["sub", { "$var": "m" }, 1] }] }
          }
        },
        "$return": { "$fn": ["isEven", { "$var": "n" }] }
      },
      "args": [10],
      "expected": true
    },
    {
      "description": "mutual recursion via where-locals stays green (odd)",
      "body": {
        "$params": ["n"],
        "isEven": {
          "$params": ["m"],
          "$return": {
            "$if": { "$eq": [{ "$var": "m" }, 0] },
            "$then": true,
            "$else": { "$fn": ["isOdd", { "$fn": ["sub", { "$var": "m" }, 1] }] }
          }
        },
        "isOdd": {
          "$params": ["m"],
          "$return": {
            "$if": { "$eq": [{ "$var": "m" }, 0] },
            "$then": false,
            "$else": { "$fn": ["isEven", { "$fn": ["sub", { "$var": "m" }, 1] }] }
          }
        },
        "$return": { "$fn": ["isEven", { "$var": "n" }] }
      },
      "args": [7],
      "expected": false
    },
    {
      "description": "a bare stdlib name in value position resolves to its `&`-free reference",
      "body": { "$return": { "$var": "length" } },
      "expected": "length"
    },
    {
      "description": "map(length, xss) works without `&` (bare registry name as argument)",
      "body": {
        "$params": ["xss"],
        "$return": { "$fn": ["map", { "$var": "length" }, { "$var": "xss" }] }
      },
      "args": [
        [
          [1, 2],
          [3, 4, 5]
        ]
      ],
      "expected": [2, 3]
    },
    {
      "description": "a local binding shadows the stdlib name in value position",
      "body": { "$params": ["x"], "length": 42, "$return": { "$var": "length" } },
      "args": [7],
      "expected": 42
    },
    {
      "description": "`length.foo` still errors (path guard, no ref-then-walk)",
      "body": { "$return": { "$var": "length.foo" } },
      "error": "Variable length not found"
    },
    {
      "description": "an unknown bare name still errors",
      "body": { "$return": { "$var": "definitelyNotRegistered" } },
      "error": "Variable definitelyNotRegistered not found"
    },
    {
      "description": "a non-function local named like a builtin does NOT hijack the operator",
      "body": { "$params": ["x"], "add": 5, "$return": { "$fn": ["add", { "$var": "x" }, 1] } },
      "args": [10],
      "expected": 11
    }
  ]
}
