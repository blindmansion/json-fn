{
  "description": "highest-value collection operations",
  "cases": [
    {
      "description": "chunk: splits into fixed-size chunks with a shorter remainder",
      "body": { "$return": { "$call": "chunk", "$args": [[1, 2, 3, 4, 5], 2] } },
      "expected": [[1, 2], [3, 4], [5]]
    },
    {
      "description": "chunk: empty input returns an empty array",
      "body": { "$return": { "$call": "chunk", "$args": [[], 3] } },
      "expected": []
    },
    {
      "description": "chunk: a size larger than the input creates one chunk",
      "body": { "$return": { "$call": "chunk", "$args": [[1, 2], 10] } },
      "expected": [[1, 2]]
    },
    {
      "description": "chunk: rejects a non-array input",
      "body": { "$return": { "$call": "chunk", "$args": ["abc", 2] } },
      "error": "first argument must be an array"
    },
    {
      "description": "chunk: rejects a zero size",
      "body": { "$return": { "$call": "chunk", "$args": [[1, 2], 0] } },
      "error": "size must be a positive integer"
    },
    {
      "description": "chunk: rejects a negative size",
      "body": { "$return": { "$call": "chunk", "$args": [[1, 2], -1] } },
      "error": "size must be a positive integer"
    },
    {
      "description": "chunk: rejects a non-integer size",
      "body": { "$return": { "$call": "chunk", "$args": [[1, 2], 1.5] } },
      "error": "size must be a positive integer"
    },
    {
      "description": "partition: preserves order in matching and non-matching groups",
      "body": {
        "$return": {
          "$call": "partition",
          "$args": [
            {
              "$params": ["n"],
              "$return": {
                "$call": "eq",
                "$args": [{ "$call": "mod", "$args": [{ "$var": "n" }, 2] }, 0]
              }
            },
            [1, 2, 3, 4, 5]
          ]
        }
      },
      "expected": [
        [2, 4],
        [1, 3, 5]
      ]
    },
    {
      "description": "partition: empty input returns two empty groups",
      "body": {
        "$return": {
          "$call": "partition",
          "$args": [{ "$params": ["x"], "$return": true }, []]
        }
      },
      "expected": [[], []]
    },
    {
      "description": "partition: rejects a non-array input",
      "body": {
        "$return": {
          "$call": "partition",
          "$args": [{ "$params": ["x"], "$return": true }, "abc"]
        }
      },
      "error": "second argument must be an array"
    },
    {
      "description": "scan: returns post-callback accumulators in input order",
      "body": {
        "$return": {
          "$call": "scan",
          "$args": [
            {
              "$params": ["acc", "n"],
              "$return": { "$call": "add", "$args": [{ "$var": "acc" }, { "$var": "n" }] }
            },
            0,
            [1, 2, 3, 4]
          ]
        }
      },
      "expected": [1, 3, 6, 10]
    },
    {
      "description": "scan: empty input omits the initial accumulator",
      "body": {
        "$return": {
          "$call": "scan",
          "$args": [{ "$params": ["acc", "x"], "$return": { "$var": "acc" } }, 10, []]
        }
      },
      "expected": []
    },
    {
      "description": "scan: rejects a non-array input",
      "body": {
        "$return": {
          "$call": "scan",
          "$args": [{ "$params": ["acc", "x"], "$return": { "$var": "acc" } }, 0, "abc"]
        }
      },
      "error": "third argument must be an array"
    },
    {
      "description": "countBy: counts string and numeric keys with normalized collisions",
      "body": {
        "$return": {
          "$call": "countBy",
          "$args": [
            { "$params": ["item"], "$return": { "$get": "key", "$from": { "$var": "item" } } },
            [{ "key": 1 }, { "key": "1" }, { "key": 2 }, { "key": 1 }]
          ]
        }
      },
      "expected": { "1": 3, "2": 1 }
    },
    {
      "description": "countBy: safely counts special object keys",
      "body": {
        "$return": {
          "$call": "countBy",
          "$args": [
            { "$params": ["item"], "$return": { "$var": "item" } },
            ["__proto__", "constructor", "__proto__"]
          ]
        }
      },
      "expected": { "__proto__": 2, "constructor": 1 }
    },
    {
      "description": "countBy: rejects unsupported callback keys",
      "body": {
        "$return": {
          "$call": "countBy",
          "$args": [{ "$params": ["item"], "$return": [{ "$var": "item" }] }, [1]]
        }
      },
      "error": "key function must return a string or number"
    },
    {
      "description": "frequencies: counts scalar values with normalized collisions",
      "body": {
        "$return": {
          "$call": "frequencies",
          "$args": [[1, "1", true, true, null, "__proto__", "__proto__"]]
        }
      },
      "expected": { "1": 2, "true": 2, "null": 1, "__proto__": 2 }
    },
    {
      "description": "frequencies: empty input returns an empty object",
      "body": { "$return": { "$call": "frequencies", "$args": [[]] } },
      "expected": {}
    },
    {
      "description": "frequencies: rejects a non-array input",
      "body": { "$return": { "$call": "frequencies", "$args": ["abc"] } },
      "error": "argument must be an array"
    },
    {
      "description": "frequencies: rejects non-scalar elements",
      "body": { "$return": { "$call": "frequencies", "$args": [[[1]]] } },
      "error": "array elements must be scalars"
    }
  ]
}
