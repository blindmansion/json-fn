{
  "description": "numeric functions",
  "cases": [
    {
      "description": "floor: rounds down positive decimal",
      "body": { "$return": { "$call": "floor", "$args": [3.7] } },
      "expected": 3
    },
    {
      "description": "floor: rounds down negative decimal",
      "body": { "$return": { "$call": "floor", "$args": [-2.3] } },
      "expected": -3
    },
    {
      "description": "floor: integer unchanged",
      "body": { "$return": { "$call": "floor", "$args": [5] } },
      "expected": 5
    },
    {
      "description": "floor: zero unchanged",
      "body": { "$return": { "$call": "floor", "$args": [0] } },
      "expected": 0
    },
    {
      "description": "ceil: rounds up positive decimal",
      "body": { "$return": { "$call": "ceil", "$args": [3.2] } },
      "expected": 4
    },
    {
      "description": "ceil: rounds up negative decimal",
      "body": { "$return": { "$call": "ceil", "$args": [-2.7] } },
      "expected": -2
    },
    {
      "description": "ceil: integer unchanged",
      "body": { "$return": { "$call": "ceil", "$args": [5] } },
      "expected": 5
    },
    {
      "description": "ceil: zero unchanged",
      "body": { "$return": { "$call": "ceil", "$args": [0] } },
      "expected": 0
    },
    {
      "description": "round: rounds down when below .5",
      "body": { "$return": { "$call": "round", "$args": [3.3] } },
      "expected": 3
    },
    {
      "description": "round: rounds up when above .5",
      "body": { "$return": { "$call": "round", "$args": [3.7] } },
      "expected": 4
    },
    {
      "description": "round: rounds up at .5",
      "body": { "$return": { "$call": "round", "$args": [2.5] } },
      "expected": 3
    },
    {
      "description": "round: integer unchanged",
      "body": { "$return": { "$call": "round", "$args": [5] } },
      "expected": 5
    },
    {
      "description": "round: negative rounds toward zero",
      "body": { "$return": { "$call": "round", "$args": [-2.3] } },
      "expected": -2
    },
    {
      "description": "max: returns largest element",
      "body": { "$return": { "$call": "max", "$args": [[3, 1, 4, 1, 5, 9, 2, 6]] } },
      "expected": 9
    },
    {
      "description": "max: single element",
      "body": { "$return": { "$call": "max", "$args": [[42]] } },
      "expected": 42
    },
    {
      "description": "max: works with negative numbers",
      "body": { "$return": { "$call": "max", "$args": [[-3, -1, -4, -1, -5]] } },
      "expected": -1
    },
    {
      "description": "max: non-array argument throws",
      "body": { "$return": { "$call": "max", "$args": [42] } },
      "error": "must be an array"
    },
    {
      "description": "min: returns smallest element",
      "body": { "$return": { "$call": "min", "$args": [[3, 1, 4, 1, 5, 9, 2, 6]] } },
      "expected": 1
    },
    {
      "description": "min: single element",
      "body": { "$return": { "$call": "min", "$args": [[42]] } },
      "expected": 42
    },
    {
      "description": "min: works with negative numbers",
      "body": { "$return": { "$call": "min", "$args": [[-3, -1, -4, -1, -5]] } },
      "expected": -5
    },
    {
      "description": "min: non-array argument throws",
      "body": { "$return": { "$call": "min", "$args": [42] } },
      "error": "must be an array"
    },
    {
      "description": "floor and ceil: bracket a decimal",
      "body": {
        "val": 3.7,
        "lo": { "$call": "floor", "$args": [{ "$var": "val" }] },
        "hi": { "$call": "ceil", "$args": [{ "$var": "val" }] },
        "$return": [{ "$var": "lo" }, { "$var": "hi" }]
      },
      "expected": [3, 4]
    },
    {
      "description": "max and min: range of array",
      "body": {
        "arr": [5, 2, 8, 1, 9, 3],
        "hi": { "$call": "max", "$args": [{ "$var": "arr" }] },
        "lo": { "$call": "min", "$args": [{ "$var": "arr" }] },
        "$return": { "$call": "sub", "$args": [{ "$var": "hi" }, { "$var": "lo" }] }
      },
      "expected": 8
    }
  ]
}
