{
  "description": "objects",
  "cases": [
    {
      "description": "entries: returns key-value pairs",
      "body": { "$return": { "$call": "entries", "$args": [{ "a": 1, "b": 2, "c": 3 }] } },
      "expected": [
        ["a", 1],
        ["b", 2],
        ["c", 3]
      ]
    },
    {
      "description": "entries: empty object returns empty array",
      "body": { "$return": { "$call": "entries", "$args": [{}] } },
      "expected": []
    },
    {
      "description": "fromEntries: builds object from pairs",
      "body": {
        "$return": {
          "$call": "fromEntries",
          "$args": [
            [
              ["x", 10],
              ["y", 20]
            ]
          ]
        }
      },
      "expected": { "x": 10, "y": 20 }
    },
    {
      "description": "fromEntries: empty pairs returns empty object",
      "body": { "$return": { "$call": "fromEntries", "$args": [[]] } },
      "expected": {}
    },
    {
      "description": "entries → fromEntries roundtrip",
      "body": {
        "pairs": { "$call": "entries", "$args": [{ "name": "alice", "age": 30 }] },
        "$return": { "$call": "fromEntries", "$args": [{ "$var": "pairs" }] }
      },
      "expected": { "name": "alice", "age": 30 }
    },
    {
      "description": "merge: merges two objects",
      "body": { "$return": { "$call": "merge", "$args": [{ "a": 1 }, { "b": 2 }] } },
      "expected": { "a": 1, "b": 2 }
    },
    {
      "description": "merge: second object wins on key conflict",
      "body": {
        "$return": {
          "$call": "merge",
          "$args": [
            { "a": 1, "b": 2 },
            { "b": 99, "c": 3 }
          ]
        }
      },
      "expected": { "a": 1, "b": 99, "c": 3 }
    },
    {
      "description": "merge: merging with empty object is identity",
      "body": { "$return": { "$call": "merge", "$args": [{ "a": 1 }, {}] } },
      "expected": { "a": 1 }
    },
    {
      "description": "hasKey: returns true for existing key",
      "body": { "$return": { "$call": "hasKey", "$args": [{ "x": 1, "y": 2 }, "x"] } },
      "expected": true
    },
    {
      "description": "hasKey: returns false for missing key",
      "body": { "$return": { "$call": "hasKey", "$args": [{ "x": 1 }, "z"] } },
      "expected": false
    },
    {
      "description": "hasKey: detects key with null value",
      "body": { "$return": { "$call": "hasKey", "$args": [{ "a": null }, "a"] } },
      "expected": true
    },
    {
      "description": "isObject: true for plain objects",
      "body": { "$return": { "$call": "isObject", "$args": [{ "a": 1 }] } },
      "expected": true
    },
    {
      "description": "isObject: true for empty object",
      "body": { "$return": { "$call": "isObject", "$args": [{}] } },
      "expected": true
    },
    {
      "description": "isObject: false for arrays",
      "body": { "$return": { "$call": "isObject", "$args": [[1, 2]] } },
      "expected": false
    },
    {
      "description": "isObject: false for null",
      "body": { "$return": { "$call": "isObject", "$args": [null] } },
      "expected": false
    },
    {
      "description": "isObject: false for number",
      "body": { "$return": { "$call": "isObject", "$args": [42] } },
      "expected": false
    },
    {
      "description": "isObject: false for string",
      "body": { "$return": { "$call": "isObject", "$args": ["hello"] } },
      "expected": false
    },
    {
      "description": "isObject: false for boolean",
      "body": { "$return": { "$call": "isObject", "$args": [true] } },
      "expected": false
    },
    {
      "description": "pick: selects specified keys",
      "body": { "$return": { "$call": "pick", "$args": [{ "a": 1, "b": 2, "c": 3 }, ["a", "c"]] } },
      "expected": { "a": 1, "c": 3 }
    },
    {
      "description": "pick: ignores keys not present in the object",
      "body": { "$return": { "$call": "pick", "$args": [{ "a": 1 }, ["a", "z"]] } },
      "expected": { "a": 1 }
    },
    {
      "description": "pick: empty key list returns empty object",
      "body": { "$return": { "$call": "pick", "$args": [{ "a": 1, "b": 2 }, []] } },
      "expected": {}
    },
    {
      "description": "omit: excludes specified keys",
      "body": { "$return": { "$call": "omit", "$args": [{ "a": 1, "b": 2, "c": 3 }, ["b"]] } },
      "expected": { "a": 1, "c": 3 }
    },
    {
      "description": "omit: ignores keys not present in the object",
      "body": { "$return": { "$call": "omit", "$args": [{ "a": 1, "b": 2 }, ["z"]] } },
      "expected": { "a": 1, "b": 2 }
    },
    {
      "description": "omit: omitting all keys returns empty object",
      "body": { "$return": { "$call": "omit", "$args": [{ "a": 1, "b": 2 }, ["a", "b"]] } },
      "expected": {}
    },
    {
      "description": "mapValues: transforms values with inline function",
      "body": {
        "$return": {
          "$call": "mapValues",
          "$args": [
            { "$params": ["v"], "$return": { "$call": "mul", "$args": [{ "$var": "v" }, 2] } },
            { "x": 1, "y": 2, "z": 3 }
          ]
        }
      },
      "expected": { "x": 2, "y": 4, "z": 6 }
    },
    {
      "description": "mapValues: callback receives key as second argument",
      "body": {
        "$return": {
          "$call": "mapValues",
          "$args": [
            { "$params": ["v", "k"], "$return": { "$var": "k" } },
            { "a": 1, "b": 2 }
          ]
        }
      },
      "expected": { "a": "a", "b": "b" }
    },
    {
      "description": "mapValues: works with named function",
      "body": {
        "$return": { "$call": "mapValues", "$args": [{ "$fn": "negate" }, { "a": 1, "b": -2 }] }
      },
      "functions": {
        "negate": { "$params": ["n"], "$return": { "$call": "neg", "$args": [{ "$var": "n" }] } }
      },
      "expected": { "a": -1, "b": 2 }
    },
    {
      "description": "mapValues: empty object returns empty object",
      "body": {
        "$return": {
          "$call": "mapValues",
          "$args": [{ "$params": ["v"], "$return": { "$var": "v" } }, {}]
        }
      },
      "expected": {}
    },
    {
      "description": "entries → filter → fromEntries (filter object by value)",
      "body": {
        "pairs": { "$call": "entries", "$args": [{ "a": 1, "b": 5, "c": 2, "d": 8 }] },
        "big": {
          "$call": "filter",
          "$args": [
            {
              "$params": ["pair"],
              "value": { "$get": 1, "$from": { "$var": "pair" } },
              "$return": { "$call": "gt", "$args": [{ "$var": "value" }, 3] }
            },
            { "$var": "pairs" }
          ]
        },
        "$return": { "$call": "fromEntries", "$args": [{ "$var": "big" }] }
      },
      "expected": { "b": 5, "d": 8 }
    },
    {
      "description": "entries → map → fromEntries (transform keys)",
      "body": {
        "pairs": { "$call": "entries", "$args": [{ "hello": 1, "world": 2 }] },
        "uppered": {
          "$call": "map",
          "$args": [
            {
              "$params": ["pair"],
              "k": { "$call": "upper", "$args": [{ "$get": 0, "$from": { "$var": "pair" } }] },
              "v": { "$get": 1, "$from": { "$var": "pair" } },
              "$return": [{ "$var": "k" }, { "$var": "v" }]
            },
            { "$var": "pairs" }
          ]
        },
        "$return": { "$call": "fromEntries", "$args": [{ "$var": "uppered" }] }
      },
      "expected": { "HELLO": 1, "WORLD": 2 }
    },
    {
      "description": "merge chain for state update",
      "body": {
        "state": { "score": 0, "lives": 3, "level": 1 },
        "$return": {
          "$call": "merge",
          "$args": [{ "$var": "state" }, { "score": 100, "level": 2 }]
        }
      },
      "expected": { "score": 100, "lives": 3, "level": 2 }
    }
  ]
}
