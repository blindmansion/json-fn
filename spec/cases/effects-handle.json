{
  "description": "the `handle` builtin: in-language interpretation of tasks (pure passthrough, effect dispatch, bubbling, multi-shot resume, raise, wildcard, return clause, malformed-node errors, and the escaping-closure interaction)",
  "functions": {
    "counter": {
      "$return": {
        "$call": "bind",
        "$args": [
          { "$call": "perform", "$args": ["get", []] },
          {
            "$params": ["c"],
            "$return": {
              "$call": "bind",
              "$args": [
                {
                  "$call": "perform",
                  "$args": ["put", [{ "$call": "add", "$args": [{ "$var": "c" }, 1] }]]
                },
                { "$params": ["_"], "$return": { "$call": "pure", "$args": [{ "$var": "c" }] } }
              ]
            }
          }
        ]
      }
    },
    "withState": {
      "$params": ["s0", "task"],
      "$return": {
        "$call": {
          "$call": "handle",
          "$args": [
            { "$var": "task" },
            {
              "get": {
                "$params": ["resume"],
                "$return": {
                  "$params": ["s"],
                  "$return": {
                    "$call": { "$call": { "$var": "resume" }, "$args": [{ "$var": "s" }] },
                    "$args": [{ "$var": "s" }]
                  }
                }
              },
              "put": {
                "$params": ["s1", "resume"],
                "$return": {
                  "$params": ["s"],
                  "$return": {
                    "$call": { "$call": { "$var": "resume" }, "$args": [null] },
                    "$args": [{ "$var": "s1" }]
                  }
                }
              },
              "return": {
                "$params": ["v"],
                "$return": { "$params": ["s"], "$return": { "$var": "v" } }
              }
            }
          ]
        },
        "$args": [{ "$var": "s0" }]
      }
    }
  },
  "cases": [
    {
      "description": "pure passthrough: a fully-pure task with empty handlers returns its value",
      "body": {
        "$return": { "$call": "handle", "$args": [{ "$call": "pure", "$args": [5] }, {}] }
      },
      "expected": 5
    },
    {
      "description": "single effect handled: resume feeds a value back into the continuation",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$call": "perform", "$args": ["ask", []] },
            {
              "ask": {
                "$params": ["resume"],
                "$return": { "$call": { "$var": "resume" }, "$args": [10] }
              }
            }
          ]
        }
      },
      "expected": 10
    },
    {
      "description": "effect args are spread into the clause before resume",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$call": "perform", "$args": ["add1", [5]] },
            {
              "add1": {
                "$params": ["x", "resume"],
                "$return": {
                  "$call": { "$var": "resume" },
                  "$args": [{ "$call": "add", "$args": [{ "$var": "x" }, 1] }]
                }
              }
            }
          ]
        }
      },
      "expected": 6
    },
    {
      "description": "chained binds (the greeter): effects sequenced through resume",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            {
              "$call": "bind",
              "$args": [
                { "$call": "perform", "$args": ["io.readLine", []] },
                {
                  "$params": ["name"],
                  "$return": {
                    "$call": "bind",
                    "$args": [
                      { "$call": "perform", "$args": ["io.print", [{ "$var": "name" }]] },
                      {
                        "$params": ["_"],
                        "$return": { "$call": "pure", "$args": [{ "$var": "name" }] }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "io.readLine": {
                "$params": ["resume"],
                "$return": { "$call": { "$var": "resume" }, "$args": ["world"] }
              },
              "io.print": {
                "$params": ["msg", "resume"],
                "$return": { "$call": { "$var": "resume" }, "$args": [null] }
              }
            }
          ]
        }
      },
      "expected": "world"
    },
    {
      "description": "return clause lifts the completion value",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$call": "pure", "$args": [5] },
            {
              "return": {
                "$params": ["v"],
                "$return": { "$call": "mul", "$args": [{ "$var": "v" }, 2] }
              }
            }
          ]
        }
      },
      "expected": 10
    },
    {
      "description": "return clause result is final, not re-interpreted (a returned task is not stepped)",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$call": "pure", "$args": [3] },
            {
              "return": {
                "$params": ["v"],
                "$return": { "$call": "perform", "$args": ["e", [{ "$var": "v" }]] }
              }
            }
          ]
        }
      },
      "expected": { "@task": "effect", "name": "e", "args": [3] }
    },
    {
      "description": "a clause that ignores resume short-circuits (orElse / early exit)",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$call": "perform", "$args": ["fail", []] },
            { "fail": { "$params": ["resume"], "$return": "early" } }
          ]
        }
      },
      "expected": "early"
    },
    {
      "description": "raise caught by a raise clause",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$call": "raise", "$args": [{ "tag": "NotFound" }] },
            {
              "raise": {
                "$params": ["err", "resume"],
                "$return": { "$get": "tag", "$from": { "$var": "err" } }
              }
            }
          ]
        }
      },
      "expected": "NotFound"
    },
    {
      "description": "the * wildcard clause receives { name, args }",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$call": "perform", "$args": ["trace", [1, 2, 3]] },
            {
              "*": {
                "$params": ["eff", "resume"],
                "$return": { "$get": "args", "$from": { "$var": "eff" } }
              }
            }
          ]
        }
      },
      "expected": [1, 2, 3]
    },
    {
      "description": "an unmatched effect bubbles through an inner handle to an outer one",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$call": "handle", "$args": [{ "$call": "perform", "$args": ["e", ["x"]] }, {}] },
            {
              "e": {
                "$params": ["a", "resume"],
                "$return": {
                  "$call": { "$var": "resume" },
                  "$args": [{ "$call": "strcat", "$args": ["got:", { "$var": "a" }] }]
                }
              }
            }
          ]
        }
      },
      "expected": "got:x"
    },
    {
      "description": "an unmatched effect bubbles through two nested handles",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            {
              "$call": "handle",
              "$args": [
                { "$call": "handle", "$args": [{ "$call": "perform", "$args": ["e", [3]] }, {}] },
                {
                  "other": {
                    "$params": ["resume"],
                    "$return": { "$call": { "$var": "resume" }, "$args": [0] }
                  }
                }
              ]
            },
            {
              "e": {
                "$params": ["n", "resume"],
                "$return": {
                  "$call": { "$var": "resume" },
                  "$args": [{ "$call": "mul", "$args": [{ "$var": "n" }, 10] }]
                }
              }
            }
          ]
        }
      },
      "expected": 30
    },
    {
      "description": "multi-shot resume: nondeterministic search collects all solutions",
      "functions": {
        "allSolutions": {
          "$params": ["task"],
          "$return": {
            "$call": "handle",
            "$args": [
              { "$var": "task" },
              {
                "choose": {
                  "$params": ["xs", "resume"],
                  "$return": {
                    "$call": "flatMap",
                    "$args": [{ "$var": "resume" }, { "$var": "xs" }]
                  }
                },
                "fail": { "$params": ["resume"], "$return": [] },
                "return": { "$params": ["v"], "$return": [{ "$var": "v" }] }
              }
            ]
          }
        },
        "pairsSummingTo4": {
          "$return": {
            "$call": "bind",
            "$args": [
              { "$call": "perform", "$args": ["choose", [[1, 2, 3]]] },
              {
                "$params": ["a"],
                "$return": {
                  "$call": "bind",
                  "$args": [
                    { "$call": "perform", "$args": ["choose", [[1, 2, 3]]] },
                    {
                      "$params": ["b"],
                      "$return": {
                        "$if": {
                          "$call": "eq",
                          "$args": [
                            { "$call": "add", "$args": [{ "$var": "a" }, { "$var": "b" }] },
                            4
                          ]
                        },
                        "$then": { "$call": "pure", "$args": [[{ "$var": "a" }, { "$var": "b" }]] },
                        "$else": { "$call": "perform", "$args": ["fail", []] }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "body": {
        "$return": {
          "$call": "allSolutions",
          "$args": [{ "$call": "pairsSummingTo4", "$args": [] }]
        }
      },
      "expected": [
        [1, 3],
        [2, 2],
        [3, 1]
      ]
    },
    {
      "description": "the state handler runs end-to-end: get/put/return threaded purely",
      "body": {
        "$return": { "$call": "withState", "$args": [10, { "$call": "counter", "$args": [] }] }
      },
      "expected": 10
    },
    {
      "description": "load-bearing: a recursive nested where-local effectful loop whose suspended continuation escapes handle still works (escaping-closures x bind chains)",
      "body": {
        "$params": ["start"],
        "run": {
          "$params": ["s"],
          "go": {
            "$params": ["n"],
            "$return": {
              "$if": { "$call": "lte", "$args": [{ "$var": "n" }, 0] },
              "$then": { "$call": "pure", "$args": [[]] },
              "$else": {
                "$call": "bind",
                "$args": [
                  { "$call": "perform", "$args": ["emit", [{ "$var": "n" }]] },
                  {
                    "$params": ["_"],
                    "$return": {
                      "$call": "go",
                      "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }]
                    }
                  }
                ]
              }
            }
          },
          "$return": {
            "$call": "handle",
            "$args": [
              { "$call": "go", "$args": [{ "$var": "s" }] },
              {
                "emit": {
                  "$params": ["x", "resume"],
                  "$return": {
                    "$call": "concat",
                    "$args": [[{ "$var": "x" }], { "$call": { "$var": "resume" }, "$args": [null] }]
                  }
                },
                "return": { "$params": ["v"], "$return": { "$var": "v" } }
              }
            ]
          }
        },
        "$return": { "$call": "run", "$args": [{ "$var": "start" }] }
      },
      "args": [3],
      "expected": [3, 2, 1]
    },
    {
      "description": "malformed forged task: bind with a non-closure then fails with a clean guest-visible error",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$raw": { "@task": "bind", "task": { "@task": "pure", "value": 1 }, "then": 5 } },
            {}
          ]
        }
      },
      "error": "bind `then` must be a function"
    },
    {
      "description": "malformed forged task: effect with a non-string name fails cleanly",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [{ "$raw": { "@task": "effect", "name": 5, "args": [] } }, {}]
        }
      },
      "error": "effect `name` must be a string"
    },
    {
      "description": "malformed forged task: effect with non-array args fails cleanly",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [{ "$raw": { "@task": "effect", "name": "e", "args": 7 } }, {}]
        }
      },
      "error": "effect `args` must be an array"
    },
    {
      "description": "handling a non-task value fails cleanly",
      "body": { "$return": { "$call": "handle", "$args": [5, {}] } },
      "error": "Task expected"
    },
    {
      "description": "handle charges fuel; a tight budget trips the fuel limit",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            {
              "$call": "bind",
              "$args": [
                { "$call": "perform", "$args": ["e", []] },
                { "$params": ["_"], "$return": { "$call": "pure", "$args": [1] } }
              ]
            },
            {
              "e": {
                "$params": ["resume"],
                "$return": { "$call": { "$var": "resume" }, "$args": [null] }
              }
            }
          ]
        }
      },
      "limits": { "maxFuel": 5 },
      "error": "fuel limit"
    }
  ]
}
