{
  "description": "Fuel limits (metered work budget)",
  "comment": "Fuel is charged at expression, function-invocation, result-size, and size-sensitive builtin chokepoints; see docs/execution-limits.md.",
  "cases": [
    {
      "description": "op-bomb via map + pure-builtin callback is rejected at a tight budget",
      "body": {
        "$return": {
          "$call": "length",
          "$args": [{ "$call": "map", "$args": ["neg", { "$call": "range", "$args": [100000] }] }]
        }
      },
      "limits": { "maxFuel": 1000 },
      "error": "Maximum fuel"
    },
    {
      "description": "same map program completes under an adequate budget",
      "body": {
        "$return": {
          "$call": "length",
          "$args": [{ "$call": "map", "$args": ["neg", { "$call": "range", "$args": [100000] }] }]
        }
      },
      "limits": { "maxFuel": 10000000 },
      "expected": 100000
    },
    {
      "description": "op-bomb via reduce + pure-builtin callback is rejected at a tight budget",
      "body": {
        "$return": { "$call": "reduce", "$args": ["add", 0, { "$call": "range", "$args": [1000] }] }
      },
      "limits": { "maxFuel": 1000 },
      "error": "Maximum fuel"
    },
    {
      "description": "same reduce program completes under an adequate budget",
      "body": {
        "$return": { "$call": "reduce", "$args": ["add", 0, { "$call": "range", "$args": [1000] }] }
      },
      "limits": { "maxFuel": 10000000 },
      "expected": 499500
    },
    {
      "description": "op-bomb via sort + pure-builtin comparator is rejected at a tight budget",
      "body": {
        "$return": {
          "$call": "length",
          "$args": [{ "$call": "sort", "$args": ["sub", { "$call": "range", "$args": [1000] }] }]
        }
      },
      "limits": { "maxFuel": 1000 },
      "error": "Maximum fuel"
    },
    {
      "description": "nested-HOF amplification (flatMap of map) is rejected at a tight budget",
      "body": {
        "$return": {
          "$call": "length",
          "$args": [
            {
              "$call": "flatMap",
              "$args": [
                {
                  "$params": ["x"],
                  "$return": {
                    "$call": "map",
                    "$args": ["neg", { "$call": "range", "$args": [300] }]
                  }
                },
                { "$call": "range", "$args": [300] }
              ]
            }
          ]
        }
      },
      "limits": { "maxFuel": 1000 },
      "error": "Maximum fuel"
    },
    {
      "description": "same nested-HOF program completes under an adequate budget",
      "body": {
        "$return": {
          "$call": "length",
          "$args": [
            {
              "$call": "flatMap",
              "$args": [
                {
                  "$params": ["x"],
                  "$return": {
                    "$call": "map",
                    "$args": ["neg", { "$call": "range", "$args": [300] }]
                  }
                },
                { "$call": "range", "$args": [300] }
              ]
            }
          ]
        }
      },
      "limits": { "maxFuel": 10000000 },
      "expected": 90000
    },
    {
      "description": "constructing and measuring a 100-element range fits the aggregate test budget",
      "body": {
        "$return": { "$call": "length", "$args": [{ "$call": "range", "$args": [100] }] }
      },
      "limits": { "maxFuel": 150 },
      "expected": 100
    },
    {
      "description": "sum charges fuel for traversing its input",
      "body": {
        "$return": { "$call": "sum", "$args": [{ "$call": "range", "$args": [100] }] }
      },
      "limits": { "maxFuel": 150 },
      "error": "Maximum fuel"
    },
    {
      "description": "max charges fuel for traversing its input",
      "body": {
        "$return": { "$call": "max", "$args": [{ "$call": "range", "$args": [100] }] }
      },
      "limits": { "maxFuel": 150 },
      "error": "Maximum fuel"
    },
    {
      "description": "min charges fuel for traversing its input",
      "body": {
        "$return": { "$call": "min", "$args": [{ "$call": "range", "$args": [100] }] }
      },
      "limits": { "maxFuel": 150 },
      "error": "Maximum fuel"
    },
    {
      "description": "constructing and measuring 100 empty arrays fits the flatten test budget",
      "body": {
        "$return": {
          "$call": "length",
          "$args": [{ "$call": "repeat", "$args": [[[]], 100] }]
        }
      },
      "limits": { "maxFuel": 150 },
      "expected": 100
    },
    {
      "description": "flatten charges fuel for traversing its input even when output is empty",
      "body": {
        "$return": {
          "$call": "length",
          "$args": [
            {
              "$call": "flatten",
              "$args": [{ "$call": "repeat", "$args": [[[]], 100] }]
            }
          ]
        }
      },
      "limits": { "maxFuel": 150 },
      "error": "Maximum fuel"
    },
    {
      "description": "small program still runs under a modest budget (guards against over-charging)",
      "body": { "$return": { "$call": "map", "$args": ["neg", [1, 2, 3]] } },
      "limits": { "maxFuel": 1000 },
      "expected": [-1, -2, -3]
    }
  ]
}
