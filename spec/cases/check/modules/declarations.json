{
  "$schema": "../../check.schema.json",
  "description": "module checking: declarations, signatures, and recovery",
  "builtins": "none",
  "cases": [
    {
      "description": "a typed module whose body matches its signature checks clean",
      "module": {
        "main": {
          "$params": [],
          "$sig": { "required": [], "optional": [], "returns": { "type": "integer" } },
          "$return": 1
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a return value outside the declared return type is a hard error",
      "module": {
        "main": {
          "$params": [],
          "$sig": { "required": [], "optional": [], "returns": { "type": "integer" } },
          "$return": "wrong"
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["main", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" },
            "actual": { "const": "wrong" }
          }
        ]
      }
    },
    {
      "description": "a module-level function without a signature is rejected by default",
      "module": { "main": { "$params": [], "$return": 1 } },
      "expected": {
        "diagnostics": [
          {
            "path": ["main"],
            "severity": "error",
            "messageIncludes": "module-level function must declare a signature"
          }
        ]
      }
    },
    {
      "description": "allowUntypedFunctions records the missing signature as visible degradation",
      "module": { "main": { "$params": [], "$return": 1 } },
      "options": { "allowUntypedFunctions": true },
      "expected": {
        "diagnostics": [
          {
            "path": ["main"],
            "severity": "info",
            "messageIncludes": "degraded to `any` because module function \"main\" has no declared signature"
          }
        ]
      }
    },
    {
      "description": "checking recovers and reports independent errors across functions",
      "module": {
        "f": {
          "$params": [],
          "$sig": { "required": [], "optional": [], "returns": { "type": "integer" } },
          "$return": true
        },
        "g": {
          "$params": [],
          "$sig": { "required": [], "optional": [], "returns": { "type": "string" } },
          "$return": 0
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" },
            "actual": { "const": true }
          },
          {
            "path": ["g", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "string" },
            "actual": { "const": 0 }
          }
        ]
      }
    }
  ]
}
