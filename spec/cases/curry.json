{
  "description": "closures, currying, and advanced function patterns",
  "functions": {
    "partialAdd": {
      "$params": ["a"],
      "$return": {
        "$params": ["b"],
        "$return": { "$fn": ["add", { "$var": "a" }, { "$var": "b" }] }
      }
    },
    "accum": {
      "$params": ["...initial"],
      "$return": {
        "$params": ["...more"],
        "$return": { "$fn": ["concat", { "$var": "initial" }, { "$var": "more" }] }
      }
    },
    "curriedAdd": {
      "$params": ["a"],
      "$return": {
        "$params": ["b"],
        "$return": { "$fn": ["add", { "$var": "a" }, { "$var": "b" }] }
      }
    },
    "curryApply": {
      "$params": ["targetFn", "arity", "accumulated", "newArgs"],
      "allArgs": { "$fn": ["concat", { "$var": "accumulated" }, { "$var": "newArgs" }] },
      "numArgs": { "$fn": ["length", { "$var": "allArgs" }] },
      "enough": { "$fn": ["gte", { "$var": "numArgs" }, { "$var": "arity" }] },
      "$return": {
        "$if": { "$var": "enough" },
        "$then": { "$fn": ["apply", { "$var": "targetFn" }, { "$var": "allArgs" }] },
        "$else": {
          "$params": ["...nextArgs"],
          "$return": {
            "$fn": [
              "curryApply",
              { "$var": "targetFn" },
              { "$var": "arity" },
              { "$var": "allArgs" },
              { "$var": "nextArgs" }
            ]
          }
        }
      }
    },
    "curry": {
      "$params": ["targetFn", "arity"],
      "$return": {
        "$params": ["...newArgs"],
        "$return": {
          "$fn": [
            "curryApply",
            { "$var": "targetFn" },
            { "$var": "arity" },
            [],
            { "$var": "newArgs" }
          ]
        }
      }
    },
    "autoCurry": {
      "$params": ["targetFn"],
      "detectedArity": { "$fn": ["arity", { "$var": "targetFn" }] },
      "$return": {
        "$params": ["...newArgs"],
        "$return": {
          "$fn": [
            "curryApply",
            { "$var": "targetFn" },
            { "$var": "detectedArity" },
            [],
            { "$var": "newArgs" }
          ]
        }
      }
    },
    "add3": {
      "$params": ["a", "b", "c"],
      "$return": {
        "$fn": ["add", { "$var": "a" }, { "$fn": ["add", { "$var": "b" }, { "$var": "c" }] }]
      }
    }
  },
  "cases": [
    {
      "description": "makeAdder(10) returns a closure with x captured",
      "body": {
        "$params": ["x"],
        "$return": {
          "$params": ["y"],
          "$return": { "$fn": ["add", { "$var": "x" }, { "$var": "y" }] }
        }
      },
      "args": [10],
      "expected": { "$params": ["y"], "$return": { "$fn": ["add", 10, { "$var": "y" }] } }
    },
    {
      "description": "makeAdder(10)(5) via nested inline call",
      "body": {
        "adder": {
          "$fn": [
            {
              "$params": ["x"],
              "$return": {
                "$params": ["y"],
                "$return": { "$fn": ["add", { "$var": "x" }, { "$var": "y" }] }
              }
            },
            10
          ]
        },
        "$return": { "$fn": [{ "$var": "adder" }, 5] }
      },
      "expected": 15
    },
    {
      "description": "variadic: capture all args with ...rest",
      "body": { "$params": ["...allArgs"], "$return": { "$var": "allArgs" } },
      "args": [10, 20, 30],
      "expected": [10, 20, 30]
    },
    {
      "description": "dynamic dispatch: call function by name from args (add)",
      "body": { "$params": ["fnName"], "$return": { "$fn": [{ "$var": "fnName" }, 3, 4] } },
      "args": ["add"],
      "expected": 7
    },
    {
      "description": "dynamic dispatch: call function by name from args (mul)",
      "body": { "$params": ["fnName"], "$return": { "$fn": [{ "$var": "fnName" }, 3, 4] } },
      "args": ["mul"],
      "expected": 12
    },
    {
      "description": "partialAdd(10) returns a function",
      "body": { "$return": { "$fn": ["partialAdd", 10] } },
      "expected": { "$params": ["b"], "$return": { "$fn": ["add", 10, { "$var": "b" }] } }
    },
    {
      "description": "partialAdd(10)(7) = 17",
      "body": {
        "partial": { "$fn": ["partialAdd", 10] },
        "$return": { "$fn": [{ "$var": "partial" }, 7] }
      },
      "expected": 17
    },
    {
      "description": "accum(1,2)(3,4) concatenates args",
      "body": {
        "step1": { "$fn": ["accum", 1, 2] },
        "$return": { "$fn": [{ "$var": "step1" }, 3, 4] }
      },
      "expected": [1, 2, 3, 4]
    },
    {
      "description": "arity check: length([1,2,3]) >= 3 is true",
      "body": {
        "args": [1, 2, 3],
        "numArgs": { "$fn": ["length", { "$var": "args" }] },
        "enough": { "$fn": ["gte", { "$var": "numArgs" }, 3] },
        "$return": { "$var": "enough" }
      },
      "expected": true
    },
    {
      "description": "arity check: length([1,2]) >= 3 is false",
      "body": {
        "args": [1, 2],
        "numArgs": { "$fn": ["length", { "$var": "args" }] },
        "enough": { "$fn": ["gte", { "$var": "numArgs" }, 3] },
        "$return": { "$var": "enough" }
      },
      "expected": false
    },
    {
      "description": "curriedAdd(10)(32) = 42",
      "body": {
        "step1": { "$fn": ["curriedAdd", 10] },
        "$return": { "$fn": [{ "$var": "step1" }, 32] }
      },
      "expected": 42
    },
    {
      "description": "curry('add', 2) returns a function",
      "body": { "$return": { "$fn": ["curry", "add", 2] } },
      "expected": {
        "$params": ["...newArgs"],
        "$return": { "$fn": ["curryApply", "add", 2, [], { "$var": "newArgs" }] }
      }
    },
    {
      "description": "curry('add', 2)(10) returns another function",
      "body": {
        "curriedAdd": { "$fn": ["curry", "add", 2] },
        "$return": { "$fn": [{ "$var": "curriedAdd" }, 10] }
      },
      "expected": {
        "$params": ["...nextArgs"],
        "$return": { "$fn": ["curryApply", "add", 2, [10], { "$var": "nextArgs" }] }
      }
    },
    {
      "description": "curry('add', 2)(10)(32) = 42",
      "body": {
        "step1": { "$fn": ["curry", "add", 2] },
        "step2": { "$fn": [{ "$var": "step1" }, 10] },
        "$return": { "$fn": [{ "$var": "step2" }, 32] }
      },
      "expected": 42
    },
    {
      "description": "curry('add', 2)(10, 32) — all args at once",
      "body": {
        "curriedAdd": { "$fn": ["curry", "add", 2] },
        "$return": { "$fn": [{ "$var": "curriedAdd" }, 10, 32] }
      },
      "expected": 42
    },
    {
      "description": "curry('add3', 3)(1)(2)(3) = 6",
      "body": {
        "step1": { "$fn": ["curry", "add3", 3] },
        "step2": { "$fn": [{ "$var": "step1" }, 1] },
        "step3": { "$fn": [{ "$var": "step2" }, 2] },
        "$return": { "$fn": [{ "$var": "step3" }, 3] }
      },
      "expected": 6
    },
    {
      "description": "curry('add3', 3)(1, 2)(3) = 6",
      "body": {
        "step1": { "$fn": ["curry", "add3", 3] },
        "step2": { "$fn": [{ "$var": "step1" }, 1, 2] },
        "$return": { "$fn": [{ "$var": "step2" }, 3] }
      },
      "expected": 6
    },
    {
      "description": "autoCurry('add')(10)(32) = 42",
      "body": {
        "step1": { "$fn": ["autoCurry", "add"] },
        "step2": { "$fn": [{ "$var": "step1" }, 10] },
        "$return": { "$fn": [{ "$var": "step2" }, 32] }
      },
      "expected": 42
    },
    {
      "description": "autoCurry('add')(10, 32) — all args at once",
      "body": {
        "curriedAdd": { "$fn": ["autoCurry", "add"] },
        "$return": { "$fn": [{ "$var": "curriedAdd" }, 10, 32] }
      },
      "expected": 42
    },
    {
      "description": "autoCurry with a JSON function (add3)",
      "body": {
        "step1": { "$fn": ["autoCurry", "add3"] },
        "step2": { "$fn": [{ "$var": "step1" }, 1] },
        "step3": { "$fn": [{ "$var": "step2" }, 2] },
        "$return": { "$fn": [{ "$var": "step3" }, 3] }
      },
      "expected": 6
    }
  ]
}
