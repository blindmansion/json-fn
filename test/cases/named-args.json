{
  "description": "named arguments",
  "cases": [
    {
      "description": "basic named args on a JSON function",
      "body": {
        "$return": {
          "$fn": "greet",
          "$args": {
            "greeting": "Hello, ",
            "name": "world"
          }
        }
      },
      "functions": {
        "greet": {
          "$params": ["greeting", "name"],
          "$return": {
            "$fn": "strcat",
            "$args": [
              {
                "$var": "greeting"
              },
              {
                "$var": "name"
              }
            ]
          }
        }
      },
      "expected": "Hello, world"
    },
    {
      "description": "named args produce correct positional order",
      "body": {
        "$return": {
          "$fn": "subtract",
          "$args": {
            "b": 3,
            "a": 10
          }
        }
      },
      "functions": {
        "subtract": {
          "$params": ["a", "b"],
          "$return": {
            "$fn": "sub",
            "$args": [
              {
                "$var": "a"
              },
              {
                "$var": "b"
              }
            ]
          }
        }
      },
      "expected": 7
    },
    {
      "description": "missing named arg defaults to null",
      "body": {
        "$return": {
          "$fn": "maybeAdd",
          "$args": {
            "a": 5
          }
        }
      },
      "functions": {
        "maybeAdd": {
          "$params": ["a", "b"],
          "$return": {
            "$fn": "isNull",
            "$args": [
              {
                "$var": "b"
              }
            ]
          }
        }
      },
      "expected": true
    },
    {
      "description": "named args on inline function body",
      "body": {
        "$return": {
          "$fn": {
            "$params": ["x", "y"],
            "$return": {
              "$fn": "mul",
              "$args": [
                {
                  "$var": "x"
                },
                {
                  "$var": "y"
                }
              ]
            }
          },
          "$args": {
            "y": 7,
            "x": 3
          }
        }
      },
      "expected": 21
    },
    {
      "description": "named args with expressions as values",
      "body": {
        "$return": {
          "$fn": "addThree",
          "$args": {
            "a": {
              "$fn": "add",
              "$args": [1, 2]
            },
            "b": 10,
            "c": 100
          }
        }
      },
      "functions": {
        "addThree": {
          "$params": ["a", "b", "c"],
          "$return": {
            "$fn": "add",
            "$args": [
              {
                "$fn": "add",
                "$args": [
                  {
                    "$var": "a"
                  },
                  {
                    "$var": "b"
                  }
                ]
              },
              {
                "$var": "c"
              }
            ]
          }
        }
      },
      "expected": 113
    },
    {
      "description": "positional args still work",
      "body": {
        "$return": {
          "$fn": "myAdd",
          "$args": [3, 4]
        }
      },
      "functions": {
        "myAdd": {
          "$params": ["a", "b"],
          "$return": {
            "$fn": "add",
            "$args": [
              {
                "$var": "a"
              },
              {
                "$var": "b"
              }
            ]
          }
        }
      },
      "expected": 7
    },
    {
      "description": "errors on unknown named arg",
      "body": {
        "$return": {
          "$fn": "myAdd",
          "$args": {
            "a": 1,
            "c": 2
          }
        }
      },
      "functions": {
        "myAdd": {
          "$params": ["a", "b"],
          "$return": {
            "$fn": "add",
            "$args": [
              {
                "$var": "a"
              },
              {
                "$var": "b"
              }
            ]
          }
        }
      },
      "error": "Unknown named argument \"c\""
    },
    {
      "description": "errors on named args for external functions",
      "body": {
        "$return": {
          "$fn": "add",
          "$args": {
            "a": 1,
            "b": 2
          }
        }
      },
      "error": "Named arguments are not supported for external functions"
    },
    {
      "description": "errors on named args for functions without $params",
      "body": {
        "$return": {
          "$fn": "noParams",
          "$args": {
            "a": 1
          }
        }
      },
      "functions": {
        "noParams": {
          "$return": 42
        }
      },
      "error": "Named arguments require the target function to declare $params"
    },
    {
      "description": "errors on named args for functions with rest params",
      "body": {
        "$return": {
          "$fn": "restFn",
          "$args": {
            "a": 1
          }
        }
      },
      "functions": {
        "restFn": {
          "$params": ["a", "...rest"],
          "$return": {
            "$var": "a"
          }
        }
      },
      "error": "Named arguments are not supported for functions with rest parameters"
    }
  ]
}
