    {
      "description": "local function body shadows a global registry function of the same name",
      "body": {
        "double": {
          "$params": ["x"],
          "$return": {
            "$fn": "mul",
            "$args": [
              {
                "$var": "x"
              },
              3
            ]
          }
        },
        "$return": {
          "$fn": "double",
          "$args": [5]
        }
      },
      "functions": {
        "double": {
          "$params": ["x"],
          "$return": {
            "$fn": "mul",
            "$args": [
              {
                "$var": "x"
              },
              2
            ]
          }
        }
      },
      "expected": 15
    },
    {
