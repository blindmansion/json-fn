{
  "description": "local function recursion via scoped registry",
  "cases": [
    {
      "description": "self-recursive local factorial via string dispatch",
      "body": {
        "$params": ["n"],
        "fact": {
          "$params": ["x"],
          "$return": {
            "$if": {
              "$fn": "lte",
              "$args": [
                {
                  "$var": "x"
                },
                1
              ]
            },
            "$then": 1,
            "$else": {
              "$fn": "mul",
              "$args": [
                {
                  "$var": "x"
                },
                {
                  "$fn": "fact",
                  "$args": [
                    {
                      "$fn": "sub",
                      "$args": [
                        {
                          "$var": "x"
                        },
                        1
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "$return": {
          "$fn": "fact",
          "$args": [
            {
              "$var": "n"
            }
          ]
        }
      },
      "args": [5],
      "expected": 120
    },
    {
      "description": "self-recursive local fibonacci",
      "body": {
        "$params": ["n"],
        "fib": {
          "$params": ["x"],
          "$return": {
            "$if": {
              "$fn": "lte",
              "$args": [
                {
                  "$var": "x"
                },
                1
              ]
            },
            "$then": {
              "$var": "x"
            },
            "$else": {
              "$fn": "add",
              "$args": [
                {
                  "$fn": "fib",
                  "$args": [
                    {
                      "$fn": "sub",
                      "$args": [
                        {
                          "$var": "x"
                        },
                        1
                      ]
                    }
                  ]
                },
                {
                  "$fn": "fib",
                  "$args": [
                    {
                      "$fn": "sub",
                      "$args": [
                        {
                          "$var": "x"
                        },
                        2
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "$return": {
          "$fn": "fib",
          "$args": [
            {
              "$var": "n"
            }
          ]
        }
      },
      "args": [10],
      "expected": 55
    },
    {
      "description": "base case: local factorial(0) = 1",
      "body": {
        "fact": {
          "$params": ["n"],
          "$return": {
            "$if": {
              "$fn": "lte",
              "$args": [
                {
                  "$var": "n"
                },
                1
              ]
            },
            "$then": 1,
            "$else": {
              "$fn": "mul",
              "$args": [
                {
                  "$var": "n"
                },
                {
                  "$fn": "fact",
                  "$args": [
                    {
                      "$fn": "sub",
                      "$args": [
                        {
                          "$var": "n"
                        },
                        1
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "$return": {
          "$fn": "fact",
          "$args": [0]
        }
      },
      "expected": 1
    },
    {
      "description": "mutual recursion between local isEven and isOdd",
      "body": {
        "$params": ["n"],
        "myIsEven": {
          "$params": ["x"],
          "$return": {
            "$if": {
              "$fn": "eq",
              "$args": [
                {
                  "$var": "x"
                },
                0
              ]
            },
            "$then": true,
            "$else": {
              "$fn": "myIsOdd",
              "$args": [
                {
                  "$fn": "sub",
                  "$args": [
                    {
                      "$var": "x"
                    },
                    1
                  ]
                }
              ]
            }
          }
        },
        "myIsOdd": {
          "$params": ["x"],
          "$return": {
            "$if": {
              "$fn": "eq",
              "$args": [
                {
                  "$var": "x"
                },
                0
              ]
            },
            "$then": false,
            "$else": {
              "$fn": "myIsEven",
              "$args": [
                {
                  "$fn": "sub",
                  "$args": [
                    {
                      "$var": "x"
                    },
                    1
                  ]
                }
              ]
            }
          }
        },
        "$return": [
          {
            "$fn": "myIsEven",
            "$args": [
              {
                "$var": "n"
              }
            ]
          },
          {
            "$fn": "myIsOdd",
            "$args": [
              {
                "$var": "n"
              }
            ]
          }
        ]
      },
      "args": [4],
      "expected": [true, false]
    },
