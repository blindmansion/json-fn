      },
      "args": [5],
      "expected": 120
    },
    {
      "description": "non-recursive local calling a recursive local",
      "body": {
        "fact": {
          "$params": ["n"],
          "$return": {
            "$if": {
              "$fn": "lte",
              "$args": [
                {
                  "$var": "n"
                },
                1
              ]
            },
            "$then": 1,
            "$else": {
              "$fn": "mul",
              "$args": [
                {
                  "$var": "n"
                },
                {
                  "$fn": "fact",
                  "$args": [
                    {
                      "$fn": "sub",
                      "$args": [
                        {
                          "$var": "n"
                        },
                        1
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "doubleFactorial": {
          "$fn": "mul",
          "$args": [
