    {
      "description": "recursive local with rest params",
      "body": {
        "sumAll": {
          "$params": ["first", "...rest"],
          "$return": {
            "$if": {
              "$fn": "eq",
              "$args": [
                {
                  "$fn": "length",
                  "$args": [
                    {
                      "$var": "rest"
                    }
                  ]
                },
                0
              ]
            },
            "$then": {
              "$var": "first"
            },
            "$else": {
              "$fn": "add",
              "$args": [
                {
                  "$var": "first"
                },
                {
                  "$fn": "sumAll",
                  "$args": {
                    "$var": "rest"
                  }
                }
              ]
            }
          }
        },
        "$return": {
          "$fn": "sumAll",
          "$args": [1, 2, 3, 4, 5]
        }
      },
      "expected": 15
    },
    {
      "description": "nested scope: inner function body has its own local recursive fn",
      "body": {
        "$params": ["n"],
        "$return": {
          "$fn": {
            "fact": {
              "$params": ["x"],
              "$return": {
                "$if": {
                  "$fn": "lte",
                  "$args": [
                    {
                      "$var": "x"
                    },
                    1
                  ]
                },
                "$then": 1,
                "$else": {
                  "$fn": "mul",
                  "$args": [
                    {
                      "$var": "x"
                    },
                    {
                      "$fn": "fact",
                      "$args": [
                        {
                          "$fn": "sub",
                          "$args": [
                            {
                              "$var": "x"
                            },
                            1
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            "$return": {
              "$fn": "fact",
              "$args": [
                {
                  "$var": "n"
                }
              ]
            }
          },
          "$args": []
        }
      },
      "args": [6],
      "expected": 720
    },
    {
      "description": "local recursive fn does not leak into sibling scope",
      "body": {
        "wrapper": {
          "fact": {
            "$params": ["n"],
            "$return": {
              "$if": {
                "$fn": "lte",
                "$args": [
                  {
                    "$var": "n"
                  },
                  1
                ]
              },
              "$then": 1,
              "$else": {
                "$fn": "mul",
                "$args": [
                  {
                    "$var": "n"
                  },
                  {
                    "$fn": "fact",
                    "$args": [
                      {
                        "$fn": "sub",
                        "$args": [
                          {
                            "$var": "n"
                          },
                          1
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "$return": {
            "$fn": "fact",
            "$args": [5]
          }
        },
        "$return": {
          "$fn": "fact",
          "$args": [3]
        }
      },
      "error": "Function fact not found"
    },
    {
      "description": "returned closure referencing local fn by string fails outside defining scope",
      "body": {
        "closure": {
          "$fn": {
            "helper": {
              "$params": ["x"],
              "$return": {
                "$fn": "mul",
                "$args": [
                  {
                    "$var": "x"
                  },
                  2
                ]
              }
            },
            "$return": {
              "$params": ["y"],
              "$return": {
                "$fn": "helper",
                "$args": [
                  {
                    "$var": "y"
                  }
                ]
              }
            }
          },
          "$args": []
        },
        "$return": {
          "$fn": {
            "$var": "closure"
          },
          "$args": [5]
        }
      },
      "error": "Function helper not found"
    }
