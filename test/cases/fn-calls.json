{
  "description": "function calls",
  "cases": [
    {
      "description": "add(3, 4)",
      "body": {
        "$return": {
          "$fn": "add",
          "$args": [3, 4]
        }
      },
      "expected": 7
    },
    {
      "description": "upper('hello')",
      "body": {
        "$return": {
          "$fn": "upper",
          "$args": ["hello"]
        }
      },
      "expected": "HELLO"
    },
    {
      "description": "nested calls: mul(add(2,3), sub(10,4))",
      "body": {
        "$return": {
          "$fn": "mul",
          "$args": [
            {
              "$fn": "add",
              "$args": [2, 3]
            },
            {
              "$fn": "sub",
              "$args": [10, 4]
            }
          ]
        }
      },
      "expected": 30
    },
    {
      "description": "$params binds arguments by name",
      "body": {
        "$params": ["a", "b"],
        "$return": {
          "$fn": "add",
          "$args": [
            {
              "$var": "a"
            },
            {
              "$var": "b"
            }
          ]
        }
      },
      "args": [10, 20],
      "expected": 30
    }
  ]
}
