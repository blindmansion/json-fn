{
  "description": "scoping",
  "cases": [
    {
      "description": "inner variable shadows outer parameter of the same name",
      "body": { "$params": ["x"], "$return": { "$let": { "x": 999 }, "$in": { "$var": "x" } } },
      "args": [10],
      "expected": 999
    },
    {
      "description": "inner parameter shadows outer parameter in a nested function call",
      "body": {
        "$params": ["x"],
        "$return": {
          "$call": {
            "$params": ["x"],
            "$return": { "$call": "add", "$args": [{ "$var": "x" }, 1] }
          },
          "$args": [50]
        }
      },
      "args": [10],
      "expected": 51
    },
    {
      "description": "outer parameter is still captured when not shadowed",
      "body": {
        "$params": ["x"],
        "$return": {
          "$call": {
            "$params": ["y"],
            "$return": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] }
          },
          "$args": [5]
        }
      },
      "args": [10],
      "expected": 15
    },
    {
      "description": "returned closure preserves inner scope (closure shape)",
      "comment": "The inner parameter shadows the outer x, so the body has no free variables; the empty record is omitted and the value is byte-identical to its source body.",
      "body": { "$return": { "$call": "makeAdder", "$args": [10] } },
      "functions": {
        "makeAdder": {
          "$params": ["x"],
          "$return": {
            "$params": ["x"],
            "$return": { "$call": "add", "$args": [{ "$var": "x" }, 1000] }
          }
        }
      },
      "expected": {
        "$params": ["x"],
        "$return": { "$call": "add", "$args": [{ "$var": "x" }, 1000] }
      }
    },
    {
      "description": "returned closure preserves inner scope (call through)",
      "body": {
        "$return": {
          "$let": { "adder": { "$call": "makeAdder", "$args": [10] } },
          "$in": { "$call": { "$var": "adder" }, "$args": [42] }
        }
      },
      "functions": {
        "makeAdder": {
          "$params": ["x"],
          "$return": {
            "$params": ["x"],
            "$return": { "$call": "add", "$args": [{ "$var": "x" }, 1000] }
          }
        }
      },
      "expected": 1042
    },
    {
      "description": "multiple levels of shadowing",
      "body": {
        "$return": {
          "$let": { "x": 1 },
          "$in": { "$let": { "x": 2 }, "$in": { "$let": { "x": 3 }, "$in": { "$var": "x" } } }
        }
      },
      "expected": 3
    },
    {
      "description": "a name bound by the closure's own inner $let is not captured (closure shape)",
      "comment": "n is bound by the body's inner $let, so it is not free: no record entry, and the body rides unrewritten.",
      "body": { "$return": { "$call": "outer", "$args": [5] } },
      "functions": {
        "outer": {
          "$params": ["n"],
          "$return": {
            "$params": ["x"],
            "$return": {
              "$let": { "n": { "$call": "mul", "$args": [{ "$var": "x" }, 10] } },
              "$in": { "$var": "n" }
            }
          }
        }
      },
      "expected": {
        "$params": ["x"],
        "$return": {
          "$let": { "n": { "$call": "mul", "$args": [{ "$var": "x" }, 10] } },
          "$in": { "$var": "n" }
        }
      }
    },
    {
      "description": "a name bound by the closure's own inner $let is not captured (call through)",
      "body": { "$return": { "$call": { "$call": "outer", "$args": [5] }, "$args": [7] } },
      "functions": {
        "outer": {
          "$params": ["n"],
          "$return": {
            "$params": ["x"],
            "$return": {
              "$let": { "n": { "$call": "mul", "$args": [{ "$var": "x" }, 10] } },
              "$in": { "$var": "n" }
            }
          }
        }
      },
      "expected": 70
    },
    {
      "description": "non-shadowed outer vars are captured by value",
      "body": { "$return": { "$call": "outer", "$args": [10, 20] } },
      "functions": {
        "outer": {
          "$params": ["a", "b"],
          "$return": {
            "$params": ["c"],
            "$return": {
              "$call": "add",
              "$args": [
                { "$var": "a" },
                { "$call": "add", "$args": [{ "$var": "b" }, { "$var": "c" }] }
              ]
            }
          }
        }
      },
      "expected": {
        "$params": ["c"],
        "$return": {
          "$call": "add",
          "$args": [
            { "$var": "a" },
            { "$call": "add", "$args": [{ "$var": "b" }, { "$var": "c" }] }
          ]
        },
        "$captures": { "a": 10, "b": 20 }
      }
    },
    {
      "description": "partial shadowing — only the colliding name is masked",
      "body": {
        "$return": {
          "$let": { "x": 100, "y": 200 },
          "$in": {
            "$call": {
              "$params": ["x"],
              "$return": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] }
            },
            "$args": [1]
          }
        }
      },
      "expected": 201
    }
  ]
}
