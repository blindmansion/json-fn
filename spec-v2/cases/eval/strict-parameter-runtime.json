{
  "description": "strict runtime parameter semantics",
  "cases": [
    {
      "description": "missing required positional argument is rejected",
      "body": { "$params": ["value"], "$return": { "$var": "value" } },
      "error": "Missing required argument at parameter position 1"
    },
    {
      "description": "exact positional call succeeds",
      "body": { "$params": ["value"], "$return": { "$var": "value" } },
      "args": [4],
      "expected": 4
    },
    {
      "description": "explicit null is a supplied positional value",
      "body": { "$params": [{ "$param": "value", "$default": 4 }], "$return": { "$var": "value" } },
      "args": [null],
      "expected": null
    },
    {
      "description": "omitted defaulted positional parameter uses its default",
      "body": { "$params": [{ "$param": "value", "$default": 4 }], "$return": { "$var": "value" } },
      "expected": 4
    },
    {
      "description": "extra fixed argument is rejected",
      "body": { "$params": ["value"], "$return": { "$var": "value" } },
      "args": [1, 2],
      "error": "Expected exactly 1 argument, received 2"
    },
    {
      "description": "rest accepts zero remaining arguments",
      "body": { "$params": ["value", "...rest"], "$return": { "$var": "rest" } },
      "args": [1],
      "expected": []
    },
    {
      "description": "rest collects all remaining arguments",
      "body": { "$params": ["value", "...rest"], "$return": { "$var": "rest" } },
      "args": [1, 2, 3],
      "expected": [2, 3]
    },
    {
      "description": "required fixed slot before rest cannot be omitted",
      "body": { "$params": ["value", "...rest"], "$return": { "$var": "rest" } },
      "error": "Missing required argument at parameter position 1"
    },
    {
      "description": "all-defaulted object pattern still requires its argument",
      "comment": "Field defaults live in the projections' $else arms; the lowered slot itself is a plain required positional parameter, so omission is the ordinary missing-argument error.",
      "body": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "value": { "$get": "value", "$from": { "$var": "__p0" }, "$else": 4 } },
          "$in": { "$var": "value" }
        }
      },
      "error": "Missing required argument at parameter position 1"
    },
    {
      "description": "absent defaulted field uses its default",
      "body": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "value": { "$get": "value", "$from": { "$var": "__p0" }, "$else": 4 } },
          "$in": { "$var": "value" }
        }
      },
      "args": [{}],
      "expected": 4
    },
    {
      "description": "explicit null field suppresses its default",
      "body": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "value": { "$get": "value", "$from": { "$var": "__p0" }, "$else": 4 } },
          "$in": { "$var": "value" }
        }
      },
      "args": [{ "value": null }],
      "expected": null
    },
    {
      "description": "explicit null supplies a required positional value",
      "body": { "$params": ["value"], "$return": { "$var": "value" } },
      "args": [null],
      "expected": null
    },
    {
      "description": "omitted optional parameters and fields bind to null",
      "body": {
        "$params": ["__p0", { "$param": "value", "$optional": true }],
        "$return": {
          "$let": { "field": { "$get": "field", "$from": { "$var": "__p0" }, "$else": null } },
          "$in": { "field": { "$var": "field" }, "value": { "$var": "value" } }
        }
      },
      "args": [{}],
      "expected": { "field": null, "value": null }
    },
    {
      "description": "supplied optional parameters and fields retain their values",
      "body": {
        "$params": ["__p0", { "$param": "value", "$optional": true }],
        "$return": {
          "$let": { "field": { "$get": "field", "$from": { "$var": "__p0" }, "$else": null } },
          "$in": { "field": { "$var": "field" }, "value": { "$var": "value" } }
        }
      },
      "args": [{ "field": 1 }, 2],
      "expected": { "field": 1, "value": 2 }
    },
    {
      "description": "optional-only layout accepts no arguments",
      "body": {
        "$params": [
          { "$param": "first", "$optional": true },
          { "$param": "second", "$optional": true }
        ],
        "$return": [{ "$var": "first" }, { "$var": "second" }]
      },
      "expected": [null, null]
    },
    {
      "description": "optional-only layout rejects too many arguments",
      "body": {
        "$params": [
          { "$param": "first", "$optional": true },
          { "$param": "second", "$optional": true }
        ],
        "$return": null
      },
      "args": [1, 2, 3],
      "error": "Expected 0 to 2 arguments, received 3."
    },
    {
      "description": "required-plus-optional layout accepts omission",
      "body": {
        "$params": ["required", { "$param": "optional", "$optional": true }],
        "$return": [{ "$var": "required" }, { "$var": "optional" }]
      },
      "args": [1],
      "expected": [1, null]
    },
    {
      "description": "required-plus-optional layout reports its accepted range",
      "body": {
        "$params": ["required", { "$param": "optional", "$optional": true }],
        "$return": null
      },
      "error": "Expected 1 to 2 arguments, received 0."
    },
    {
      "description": "required-plus-defaulted layout accepts omission",
      "body": {
        "$params": ["required", { "$param": "defaulted", "$default": 2 }],
        "$return": [{ "$var": "required" }, { "$var": "defaulted" }]
      },
      "args": [1],
      "expected": [1, 2]
    },
    {
      "description": "required-plus-defaulted layout rejects too many arguments",
      "body": {
        "$params": ["required", { "$param": "defaulted", "$default": 2 }],
        "$return": null
      },
      "args": [1, 2, 3],
      "error": "Expected 1 to 2 arguments, received 3."
    },
    {
      "description": "mixed optional-defaulted layout accepts trailing omission",
      "body": {
        "$params": [
          "required",
          { "$param": "optional", "$optional": true },
          { "$param": "defaulted", "$default": 3 }
        ],
        "$return": [{ "$var": "required" }, { "$var": "optional" }, { "$var": "defaulted" }]
      },
      "args": [1],
      "expected": [1, null, 3]
    },
    {
      "description": "mixed optional-defaulted layout reports its accepted range",
      "body": {
        "$params": [
          "required",
          { "$param": "optional", "$optional": true },
          { "$param": "defaulted", "$default": 3 }
        ],
        "$return": null
      },
      "args": [1, 2, 3, 4],
      "error": "Expected 1 to 3 arguments, received 4."
    }
  ]
}
