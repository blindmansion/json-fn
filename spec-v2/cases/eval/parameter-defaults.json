{
  "description": "parameter default evaluation and validation",
  "cases": [
    {
      "description": "computed positional defaults use builtins",
      "body": {
        "$params": [{ "$param": "value", "$default": { "$call": "add", "$args": [2, 3] } }],
        "$return": { "$var": "value" }
      },
      "expected": 5
    },
    {
      "description": "every supplied JSON value suppresses a positional default",
      "body": {
        "$return": {
          "$let": {
            "withDefault": {
              "$params": [{ "$param": "value", "$default": "fallback" }],
              "$return": { "$var": "value" }
            }
          },
          "$in": [
            { "$call": "withDefault", "$args": [null] },
            { "$call": "withDefault", "$args": [false] },
            { "$call": "withDefault", "$args": [0] },
            { "$call": "withDefault", "$args": [""] },
            { "$call": "withDefault", "$args": [[]] },
            { "$call": "withDefault", "$args": [{}] }
          ]
        }
      },
      "expected": [null, false, 0, "", [], {}]
    },
    {
      "description": "a positional parameter may have an explicit null default",
      "body": {
        "$params": [{ "$param": "value", "$default": null }],
        "$return": { "$var": "value" }
      },
      "expected": null
    },
    {
      "description": "an unused positional default remains lazy",
      "body": {
        "$params": [{ "$param": "unused", "$default": { "$var": "doesNotExist" } }],
        "$return": "ok"
      },
      "expected": "ok"
    },
    {
      "description": "positional defaults support forward references",
      "body": {
        "$params": [
          { "$param": "first", "$default": { "$var": "second" } },
          { "$param": "second", "$default": 2 }
        ],
        "$return": { "$var": "first" }
      },
      "expected": 2
    },
    {
      "description": "positional defaults reference enclosing values and local functions",
      "body": {
        "$return": {
          "$let": {
            "fallbackValue": { "$call": "add", "$args": [3, 4] },
            "fallbackFunction": { "$return": 9 }
          },
          "$in": {
            "$call": {
              "$params": [
                { "$param": "fromValue", "$default": { "$var": "fallbackValue" } },
                {
                  "$param": "fromFunction",
                  "$default": { "$call": "fallbackFunction", "$args": [] }
                }
              ],
              "$return": [{ "$var": "fromValue" }, { "$var": "fromFunction" }]
            },
            "$args": []
          }
        }
      },
      "expected": [7, 9]
    },
    {
      "description": "cycles spanning positional defaults are rejected",
      "body": {
        "$params": [
          { "$param": "a", "$default": { "$var": "b" } },
          { "$param": "b", "$default": { "$var": "a" } }
        ],
        "$return": { "$var": "a" }
      },
      "error": "Circular variable dependency detected: a -> b -> a"
    },
    {
      "description": "arity uses the normalized parameter layout",
      "body": {
        "$return": {
          "$call": "arity",
          "$args": [
            {
              "$raw": {
                "$params": [
                  "required",
                  "__p1",
                  { "$param": "optional", "$optional": true },
                  { "$param": "defaulted", "$default": 1 },
                  "...rest"
                ],
                "$return": {
                  "$let": {
                    "field": { "$get": "field", "$from": { "$var": "__p1" } },
                    "optionalField": {
                      "$get": "optionalField",
                      "$from": { "$var": "__p1" },
                      "$else": null
                    }
                  },
                  "$in": null
                }
              }
            }
          ]
        }
      },
      "expected": 4
    },
    {
      "description": "arity rejects a descriptor carrying only $param",
      "comment": "A descriptor must carry at least one of $optional, $default, or $type — the bare name string is the one canonical spelling of a plain required slot.",
      "body": {
        "$return": {
          "$call": "arity",
          "$args": [{ "$raw": { "$params": [{ "$param": "value" }], "$return": null } }]
        }
      },
      "error": "$params[0]: A parameter descriptor must carry $optional, $default, or $type"
    },
    {
      "description": "field defaults depend on positional parameters and earlier fields",
      "body": {
        "$return": {
          "$let": {
            "calculate": {
              "$params": ["base", "__p1"],
              "$return": {
                "$let": {
                  "first": {
                    "$get": "first",
                    "$from": { "$var": "__p1" },
                    "$else": { "$var": "base" }
                  },
                  "second": { "$get": "second", "$from": { "$var": "__p1" }, "$else": 2 },
                  "total": {
                    "$get": "total",
                    "$from": { "$var": "__p1" },
                    "$else": {
                      "$call": "add",
                      "$args": [{ "$var": "first" }, { "$var": "second" }]
                    }
                  }
                },
                "$in": { "$var": "total" }
              }
            }
          },
          "$in": [
            { "$call": "calculate", "$args": [3, {}] },
            { "$call": "calculate", "$args": [3, { "second": 4 }] }
          ]
        }
      },
      "expected": [5, 7]
    },
    {
      "description": "field defaults capture local functions",
      "body": {
        "$return": {
          "$call": {
            "$let": { "fallback": { "$return": 13 } },
            "$in": {
              "$params": ["__p0"],
              "$return": {
                "$let": {
                  "value": {
                    "$get": "value",
                    "$from": { "$var": "__p0" },
                    "$else": { "$call": "fallback", "$args": [] }
                  }
                },
                "$in": { "$var": "value" }
              }
            }
          },
          "$args": [{}]
        }
      },
      "expected": 13
    },
    {
      "description": "positional defaults capture outer values",
      "body": {
        "$return": {
          "$call": {
            "$let": { "fallback": 7 },
            "$in": {
              "$params": [{ "$param": "value", "$default": { "$var": "fallback" } }],
              "$return": { "$var": "value" }
            }
          },
          "$args": []
        }
      },
      "expected": 7
    },
    {
      "description": "current parameters mask outer bindings inside defaults",
      "body": {
        "$return": {
          "$call": {
            "$let": { "value": 99 },
            "$in": {
              "$params": [
                { "$param": "value", "$default": 1 },
                { "$param": "copy", "$default": { "$var": "value" } }
              ],
              "$return": { "$var": "copy" }
            }
          },
          "$args": []
        }
      },
      "expected": 1
    },
    {
      "description": "every parameter kind shadows same-named outer bindings",
      "body": {
        "$return": {
          "$call": {
            "$let": {
              "required": "outer",
              "fieldRequired": "outer",
              "fieldOptional": "outer",
              "fieldDefaulted": "outer",
              "optional": "outer",
              "defaulted": "outer",
              "rest": "outer"
            },
            "$in": {
              "$params": [
                "required",
                "__p1",
                { "$param": "optional", "$optional": true },
                { "$param": "defaulted", "$default": "parameter default" },
                "...rest"
              ],
              "$return": {
                "$let": {
                  "fieldRequired": { "$get": "fieldRequired", "$from": { "$var": "__p1" } },
                  "fieldOptional": {
                    "$get": "fieldOptional",
                    "$from": { "$var": "__p1" },
                    "$else": null
                  },
                  "fieldDefaulted": {
                    "$get": "fieldDefaulted",
                    "$from": { "$var": "__p1" },
                    "$else": "field default"
                  }
                },
                "$in": {
                  "required": { "$var": "required" },
                  "fieldRequired": { "$var": "fieldRequired" },
                  "fieldOptional": { "$var": "fieldOptional" },
                  "fieldDefaulted": { "$var": "fieldDefaulted" },
                  "optional": { "$var": "optional" },
                  "defaulted": { "$var": "defaulted" },
                  "rest": { "$var": "rest" }
                }
              }
            }
          },
          "$args": ["required", { "fieldRequired": "field" }]
        }
      },
      "expected": {
        "required": "required",
        "fieldRequired": "field",
        "fieldOptional": null,
        "fieldDefaulted": "field default",
        "optional": null,
        "defaulted": "parameter default",
        "rest": []
      }
    },
    {
      "description": "malformed nested parameters fail while creating a closure",
      "body": { "$return": { "$params": [{ "$param": "value" }], "$return": null } },
      "error": "$params[0]: A parameter descriptor must carry $optional, $default, or $type"
    },
    {
      "description": "required and defaulted fields work in either order",
      "body": {
        "$return": {
          "$let": {
            "requiredFirst": {
              "$params": ["__p0", { "$param": "suffix", "$default": 3 }],
              "$return": {
                "$let": {
                  "required": { "$get": "required", "$from": { "$var": "__p0" } },
                  "fallback": { "$get": "fallback", "$from": { "$var": "__p0" }, "$else": 2 }
                },
                "$in": [{ "$var": "required" }, { "$var": "fallback" }, { "$var": "suffix" }]
              }
            },
            "defaultedFirst": {
              "$params": ["__p0", { "$param": "suffix", "$default": 3 }],
              "$return": {
                "$let": {
                  "fallback": { "$get": "fallback", "$from": { "$var": "__p0" }, "$else": 2 },
                  "required": { "$get": "required", "$from": { "$var": "__p0" } }
                },
                "$in": [{ "$var": "required" }, { "$var": "fallback" }, { "$var": "suffix" }]
              }
            }
          },
          "$in": [
            { "$call": "requiredFirst", "$args": [{ "required": 1 }] },
            { "$call": "defaultedFirst", "$args": [{ "required": 1 }] }
          ]
        }
      },
      "expected": [
        [1, 2, 3],
        [1, 2, 3]
      ]
    },
    {
      "description": "a descriptor carrying only $param is rejected at the body's own parameter surface",
      "comment": "The same descriptor rule applies wherever function-body shape is validated; the top-level body is no exception.",
      "body": { "$params": [{ "$param": "x" }], "$return": null },
      "error": "$params[0]: A parameter descriptor must carry $optional, $default, or $type"
    },
    {
      "description": "parameter descriptors reject extra properties",
      "comment": "Descriptors are closed: no keys other than $param, $optional, $default, and $type are allowed.",
      "body": { "$params": [{ "$param": "x", "$default": 1, "extra": true }], "$return": null },
      "error": "$params[0]: A parameter descriptor allows only $param, $optional, $default, and $type"
    },
    {
      "description": "a rest descriptor admits only $type",
      "comment": "A rest slot in descriptor form carries the ... prefix inside $param and cannot be defaulted or optional.",
      "body": { "$params": [{ "$param": "...xs", "$default": [] }], "$return": null },
      "error": "$params[0]: A rest parameter descriptor admits only $type"
    },
    {
      "description": "rest parameters must be final",
      "body": { "$params": ["...xs", "later"], "$return": null },
      "error": "A rest parameter must have a name and be the final $params entry"
    },
    {
      "description": "named parameter bindings cannot be duplicated",
      "body": { "$params": ["x", { "$param": "x", "$default": 1 }], "$return": null },
      "error": "Duplicate parameter binding \"x\""
    },
    {
      "description": "a lowered field projection shadows a same-named positional parameter",
      "comment": "Uniqueness of the names bound by one parameter list is a shorthand parse rule. Canonically the projection is an ordinary $let binding, so the field name shadows the parameter throughout $in — a program the parser never emits, given a meaning by the ordinary rules rather than policed.",
      "body": {
        "$params": ["__p0", { "$param": "x", "$default": 1 }],
        "$return": {
          "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
          "$in": { "$var": "x" }
        }
      },
      "args": [{ "x": 10 }],
      "expected": 10
    },
    {
      "description": "specific malformed descriptor errors survive a preceding default",
      "body": {
        "$params": [{ "$param": "first", "$default": 1 }, { "$param": "second" }],
        "$return": null
      },
      "error": "$params[1]: A parameter descriptor must carry $optional, $default, or $type"
    },
    {
      "description": "specific duplicate errors survive a preceding default",
      "body": { "$params": [{ "$param": "same", "$default": 1 }, "same"], "$return": null },
      "args": [1, 2],
      "error": "Duplicate parameter binding \"same\""
    },
    {
      "description": "specific rest errors survive a preceding default",
      "body": {
        "$params": [{ "$param": "first", "$default": 1 }, "...rest", "later"],
        "$return": null
      },
      "error": "A rest parameter must have a name and be the final $params entry"
    }
  ]
}
