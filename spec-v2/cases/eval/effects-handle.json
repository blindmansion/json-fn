{
  "description": "handle evaluator integration across nesting, higher-order results, escaping closures, and limits",
  "functions": {
    "counter": {
      "$return": {
        "$call": "bind",
        "$args": [
          { "$call": "perform", "$args": ["get", []] },
          {
            "$params": ["c"],
            "$return": {
              "$call": "bind",
              "$args": [
                {
                  "$call": "perform",
                  "$args": ["put", [{ "$call": "add", "$args": [{ "$var": "c" }, 1] }]]
                },
                { "$params": ["_"], "$return": { "$call": "pure", "$args": [{ "$var": "c" }] } }
              ]
            }
          }
        ]
      }
    },
    "withState": {
      "$params": ["s0", "task"],
      "$return": {
        "$call": {
          "$call": "handle",
          "$args": [
            { "$var": "task" },
            {
              "get": {
                "$params": ["resume"],
                "$return": {
                  "$params": ["s"],
                  "$return": {
                    "$call": { "$call": { "$var": "resume" }, "$args": [{ "$var": "s" }] },
                    "$args": [{ "$var": "s" }]
                  }
                }
              },
              "put": {
                "$params": ["s1", "resume"],
                "$return": {
                  "$params": ["s"],
                  "$return": {
                    "$call": { "$call": { "$var": "resume" }, "$args": [null] },
                    "$args": [{ "$var": "s1" }]
                  }
                }
              },
              "return": {
                "$params": ["v"],
                "$return": { "$params": ["s"], "$return": { "$var": "v" } }
              }
            }
          ]
        },
        "$args": [{ "$var": "s0" }]
      }
    }
  },
  "cases": [
    {
      "description": "an unmatched effect bubbles through an inner handle to an outer one",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            { "$call": "handle", "$args": [{ "$call": "perform", "$args": ["e", ["x"]] }, {}] },
            {
              "e": {
                "$params": ["a", "resume"],
                "$return": {
                  "$call": { "$var": "resume" },
                  "$args": [{ "$call": "strcat", "$args": ["got:", { "$var": "a" }] }]
                }
              }
            }
          ]
        }
      },
      "expected": "got:x"
    },
    {
      "description": "an unmatched effect bubbles through two nested handles",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            {
              "$call": "handle",
              "$args": [
                { "$call": "handle", "$args": [{ "$call": "perform", "$args": ["e", [3]] }, {}] },
                {
                  "other": {
                    "$params": ["resume"],
                    "$return": { "$call": { "$var": "resume" }, "$args": [0] }
                  }
                }
              ]
            },
            {
              "e": {
                "$params": ["n", "resume"],
                "$return": {
                  "$call": { "$var": "resume" },
                  "$args": [{ "$call": "mul", "$args": [{ "$var": "n" }, 10] }]
                }
              }
            }
          ]
        }
      },
      "expected": 30
    },
    {
      "description": "the state handler runs end-to-end: get/put/return threaded purely",
      "body": {
        "$return": { "$call": "withState", "$args": [10, { "$call": "counter", "$args": [] }] }
      },
      "expected": 10
    },
    {
      "description": "a function-valued annotated handle checks the eventual call result",
      "body": {
        "$return": {
          "$call": {
            "$call": "handle",
            "$args": [
              { "$call": "pure", "$args": [5] },
              {
                "return": {
                  "$params": ["v"],
                  "$return": {
                    "$params": ["state"],
                    "$return": { "$call": "add", "$args": [{ "$var": "v" }, { "$var": "state" }] }
                  }
                }
              },
              {
                "$raw": {
                  "$fnType": {
                    "required": [{ "type": "integer" }],
                    "optional": [],
                    "returns": { "type": "integer" }
                  }
                }
              }
            ]
          },
          "$args": [3]
        }
      },
      "expected": 8
    },
    {
      "description": "a function-valued annotated handle rejects an invalid eventual argument",
      "body": {
        "$return": {
          "$call": {
            "$call": "handle",
            "$args": [
              { "$call": "pure", "$args": [null] },
              {
                "return": {
                  "$params": ["_"],
                  "$return": { "$params": ["value"], "$return": { "$var": "value" } }
                }
              },
              {
                "$raw": {
                  "$fnType": {
                    "required": [{ "type": "integer" }],
                    "optional": [],
                    "returns": { "type": "integer" }
                  }
                }
              }
            ]
          },
          "$args": ["wrong"]
        }
      },
      "error": "function arguments contract failed"
    },
    {
      "description": "a function-valued annotated handle rejects an invalid eventual return",
      "body": {
        "$return": {
          "$call": {
            "$call": "handle",
            "$args": [
              { "$call": "pure", "$args": [null] },
              {
                "return": {
                  "$params": ["_"],
                  "$return": { "$params": ["value"], "$return": "wrong" }
                }
              },
              {
                "$raw": {
                  "$fnType": {
                    "required": [{ "type": "integer" }],
                    "optional": [],
                    "returns": { "type": "integer" }
                  }
                }
              }
            ]
          },
          "$args": [1]
        }
      },
      "error": "function return contract failed"
    },
    {
      "description": "load-bearing: a recursive nested where-local effectful loop whose suspended continuation escapes handle still works (escaping-closures x bind chains)",
      "body": {
        "$params": ["start"],
        "$return": {
          "$let": {
            "run": {
              "$params": ["s"],
              "$return": {
                "$let": {
                  "go": {
                    "$params": ["n"],
                    "$return": {
                      "$if": { "$call": "lte", "$args": [{ "$var": "n" }, 0] },
                      "$then": { "$call": "pure", "$args": [[]] },
                      "$else": {
                        "$call": "bind",
                        "$args": [
                          { "$call": "perform", "$args": ["emit", [{ "$var": "n" }]] },
                          {
                            "$params": ["_"],
                            "$return": {
                              "$call": "go",
                              "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }]
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "$in": {
                  "$call": "handle",
                  "$args": [
                    { "$call": "go", "$args": [{ "$var": "s" }] },
                    {
                      "emit": {
                        "$params": ["x", "resume"],
                        "$return": {
                          "$call": "concat",
                          "$args": [
                            [{ "$var": "x" }],
                            { "$call": { "$var": "resume" }, "$args": [null] }
                          ]
                        }
                      },
                      "return": { "$params": ["v"], "$return": { "$var": "v" } }
                    }
                  ]
                }
              }
            }
          },
          "$in": { "$call": "run", "$args": [{ "$var": "start" }] }
        }
      },
      "args": [3],
      "expected": [3, 2, 1]
    },
    {
      "description": "a continuation resumed more than once shares one capture record",
      "comment": "Calling resume twice runs the remainder twice. The language has no mutation, so both applications read the same captured scale from one record and each produces its own completion.",
      "body": {
        "$params": ["scale"],
        "$return": {
          "$call": "handle",
          "$args": [
            {
              "$call": "bind",
              "$args": [
                { "$call": "perform", "$args": ["choose", []] },
                {
                  "$params": ["x"],
                  "$return": {
                    "$call": "pure",
                    "$args": [{ "$call": "mul", "$args": [{ "$var": "x" }, { "$var": "scale" }] }]
                  }
                }
              ]
            },
            {
              "choose": {
                "$params": ["resume"],
                "$return": [
                  { "$call": { "$var": "resume" }, "$args": [10] },
                  { "$call": { "$var": "resume" }, "$args": [20] }
                ]
              }
            }
          ]
        }
      },
      "args": [3],
      "expected": [30, 60]
    },
    {
      "description": "handle charges fuel; a tight budget trips the fuel limit",
      "body": {
        "$return": {
          "$call": "handle",
          "$args": [
            {
              "$call": "bind",
              "$args": [
                { "$call": "perform", "$args": ["e", []] },
                { "$params": ["_"], "$return": { "$call": "pure", "$args": [1] } }
              ]
            },
            {
              "e": {
                "$params": ["resume"],
                "$return": { "$call": { "$var": "resume" }, "$args": [null] }
              }
            }
          ]
        }
      },
      "limits": { "maxFuel": 5 },
      "error": "fuel limit"
    }
  ]
}
