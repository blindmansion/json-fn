{
  "description": "conditionals",
  "functions": {
    "classify": {
      "$params": ["n"],
      "$return": {
        "$cond": [
          [{ "$call": "lt", "$args": [{ "$var": "n" }, 0] }, "negative"],
          [{ "$call": "eq", "$args": [{ "$var": "n" }, 0] }, "zero"],
          [true, "positive"]
        ]
      }
    },
    "fizzbuzz": {
      "$params": ["n"],
      "$return": {
        "$let": {
          "divBy3": {
            "$call": "eq",
            "$args": [{ "$call": "mod", "$args": [{ "$var": "n" }, 3] }, 0]
          },
          "divBy5": {
            "$call": "eq",
            "$args": [{ "$call": "mod", "$args": [{ "$var": "n" }, 5] }, 0]
          },
          "divBy15": { "$call": "and", "$args": [{ "$var": "divBy3" }, { "$var": "divBy5" }] }
        },
        "$in": {
          "$cond": [
            [{ "$var": "divBy15" }, "FizzBuzz"],
            [{ "$var": "divBy3" }, "Fizz"],
            [{ "$var": "divBy5" }, "Buzz"],
            [true, { "$var": "n" }]
          ]
        }
      }
    }
  },
  "cases": [
    {
      "description": "$if: true condition returns $then",
      "body": {
        "$return": {
          "$if": { "$call": "gt", "$args": [10, 5] },
          "$then": "ten is greater",
          "$else": "five is greater"
        }
      },
      "expected": "ten is greater"
    },
    {
      "description": "$if: false condition returns $else",
      "body": {
        "$return": {
          "$if": { "$call": "gt", "$args": [3, 5] },
          "$then": "three is greater",
          "$else": "five is greater"
        }
      },
      "expected": "five is greater"
    },
    {
      "description": "$if: a non-boolean condition is an immediate error",
      "comment": "Condition positions are runtime boolean positions — validation against the boolean schema, attached to evaluation. There is no truthiness; the error names the position and the evaluated value's kind, and it is a host error, not a raise-catchable signal.",
      "body": { "$return": { "$if": "yes", "$then": 1, "$else": 0 } },
      "error": "$if condition must be a boolean; got string"
    },
    {
      "description": "$if: a null condition is the same immediate error",
      "comment": "A null test is written out as an explicit comparison — x != null — never as a bare condition.",
      "body": { "$params": ["x"], "$return": { "$if": { "$var": "x" }, "$then": 1, "$else": 0 } },
      "args": [null],
      "error": "$if condition must be a boolean; got null"
    },
    {
      "description": "$cond: classify negative",
      "body": { "$return": { "$call": "classify", "$args": [-5] } },
      "expected": "negative"
    },
    {
      "description": "$cond: classify zero",
      "body": { "$return": { "$call": "classify", "$args": [0] } },
      "expected": "zero"
    },
    {
      "description": "$cond: classify positive",
      "body": { "$return": { "$call": "classify", "$args": [42] } },
      "expected": "positive"
    },
    {
      "description": "$cond: fizzbuzz(15) → FizzBuzz",
      "body": { "$return": { "$call": "fizzbuzz", "$args": [15] } },
      "expected": "FizzBuzz"
    },
    {
      "description": "$cond: fizzbuzz(9) → Fizz",
      "body": { "$return": { "$call": "fizzbuzz", "$args": [9] } },
      "expected": "Fizz"
    },
    {
      "description": "$cond: fizzbuzz(10) → Buzz",
      "body": { "$return": { "$call": "fizzbuzz", "$args": [10] } },
      "expected": "Buzz"
    },
    {
      "description": "$cond: fizzbuzz(7) → 7 (number passthrough)",
      "body": { "$return": { "$call": "fizzbuzz", "$args": [7] } },
      "expected": 7
    },
    {
      "description": "$cond: inline letter grade",
      "body": {
        "$params": ["score"],
        "$return": {
          "$cond": [
            [{ "$call": "gte", "$args": [{ "$var": "score" }, 90] }, "A"],
            [{ "$call": "gte", "$args": [{ "$var": "score" }, 80] }, "B"],
            [{ "$call": "gte", "$args": [{ "$var": "score" }, 70] }, "C"],
            [{ "$call": "gte", "$args": [{ "$var": "score" }, 60] }, "D"],
            [true, "F"]
          ]
        }
      },
      "args": [85],
      "expected": "B"
    },
    {
      "description": "$cond: short-circuits (only first matching branch evaluates)",
      "body": {
        "$return": {
          "$cond": [
            [false, { "$call": "add", "$args": [1, 2] }],
            [true, "matched second"],
            [true, "never reached"]
          ]
        }
      },
      "expected": "matched second"
    },
    {
      "description": "$cond: single pair works as a guard",
      "body": { "$return": { "$cond": [[true, "always this"]] } },
      "expected": "always this"
    },
    {
      "description": "$cond: $else returns fallback when no branch matches",
      "body": {
        "$return": {
          "$cond": [
            [false, "no"],
            [{ "$call": "gt", "$args": [1, 2] }, "also no"]
          ],
          "$else": "fallback"
        }
      },
      "expected": "fallback"
    },
    {
      "description": "$cond: matched branch skips $else",
      "body": {
        "$return": { "$cond": [[true, "matched"]], "$else": { "$call": "div", "$args": [1, 0] } }
      },
      "expected": "matched"
    },
    {
      "description": "$cond: no match without $else errors",
      "body": { "$return": { "$cond": [[false, "no"]] } },
      "error": "No $cond branch matched"
    },
    {
      "description": "$cond: rejects non-array branches",
      "body": { "$return": { "$cond": true, "$else": "fallback" } },
      "error": "$cond must be an array of [condition, result] pairs"
    },
    {
      "description": "$cond: rejects malformed branches",
      "body": { "$return": { "$cond": [[true, "yes", "extra"]], "$else": "fallback" } },
      "error": "Each $cond branch must be a [condition, result] pair"
    },
    {
      "description": "$cond: a non-boolean arm condition reached by evaluation is an immediate error",
      "comment": "Every earlier condition evaluated to false, so evaluation reaches the malformed condition and validation fires there; the error names the arm position.",
      "body": {
        "$return": {
          "$cond": [
            [false, "no"],
            [7, "never"]
          ],
          "$else": "fallback"
        }
      },
      "error": "$cond arm 2 condition must be a boolean; got number"
    },
    {
      "description": "$cond: an arm condition behind an earlier true is neither evaluated nor validated",
      "comment": "Validation attaches to evaluation, never a pre-pass: only the tested prefix of conditions evaluates, so which position errors is a pure function of the values evaluation produces.",
      "body": {
        "$return": {
          "$cond": [
            [true, "taken"],
            ["not a boolean", "skipped"]
          ],
          "$else": "fallback"
        }
      },
      "expected": "taken"
    },
    {
      "description": "$match: returns result for first strict-equal case",
      "body": {
        "$params": ["cmd"],
        "$return": {
          "$match": { "$var": "cmd" },
          "$cases": [
            ["show", "display"],
            ["reset", "resetting"],
            ["help", "help text"]
          ],
          "$else": "move"
        }
      },
      "args": ["reset"],
      "expected": "resetting"
    },
    {
      "description": "$match: $else returns fallback when no case matches",
      "body": {
        "$params": ["cmd"],
        "$return": { "$match": { "$var": "cmd" }, "$cases": [["show", "display"]], "$else": "move" }
      },
      "args": ["e2e4"],
      "expected": "move"
    },
    {
      "description": "$match: cases use strict equality",
      "body": {
        "$params": ["value"],
        "$return": {
          "$match": { "$var": "value" },
          "$cases": [[1, "number"]],
          "$else": "not number"
        }
      },
      "args": ["1"],
      "expected": "not number"
    },
    {
      "description": "$match: rejects non-scalar match values",
      "body": { "$return": { "$match": [1], "$cases": [[[1], "array"]], "$else": "fallback" } },
      "error": "$match values must be null, boolean, number, or string"
    },
    {
      "description": "$match: rejects non-scalar case values",
      "body": {
        "$return": { "$match": "show", "$cases": [[["show"], "array"]], "$else": "fallback" }
      },
      "error": "$match values must be null, boolean, number, or string"
    },
    {
      "description": "$match: evaluates case values and only matched result",
      "body": {
        "$params": ["value"],
        "$return": {
          "$match": { "$var": "value" },
          "$cases": [
            ["b", { "$call": "div", "$args": [1, 0] }],
            [{ "$call": "strcat", "$args": ["a", ""] }, "matched"]
          ],
          "$else": { "$call": "div", "$args": [1, 0] }
        }
      },
      "args": ["a"],
      "expected": "matched"
    },
    {
      "description": "$match: stops after first matching case",
      "body": {
        "$return": {
          "$match": "a",
          "$cases": [
            ["a", "first"],
            [{ "$call": "div", "$args": [1, 0] }, "second"]
          ],
          "$else": { "$call": "div", "$args": [1, 0] }
        }
      },
      "expected": "first"
    },
    {
      "description": "$match: requires $else",
      "body": { "$return": { "$match": "missing", "$cases": [["show", "display"]] } },
      "error": "$match expressions must have $match, $cases, and $else properties"
    },
    {
      "description": "$match: requires $cases",
      "body": { "$return": { "$match": "show", "$else": "fallback" } },
      "error": "$match expressions must have $match, $cases, and $else properties"
    },
    {
      "description": "$match: rejects malformed cases",
      "body": {
        "$return": {
          "$match": "show",
          "$cases": [["show", "display", "extra"]],
          "$else": "fallback"
        }
      },
      "error": "Each $match case must be a [value, result] pair"
    },
    {
      "description": "$and: returns true when every operand is true",
      "body": { "$return": { "$and": [true, { "$call": "gt", "$args": [2, 1] }, true] } },
      "expected": true
    },
    {
      "description": "$and: returns false at the first false operand without evaluating the rest",
      "body": { "$return": { "$and": [true, false, { "$call": "div", "$args": [1, 0] }] } },
      "expected": false
    },
    {
      "description": "$and: rejects an empty operand array",
      "comment": "$and takes at least two operands: an empty form would be a second spelling of true, and a singleton a bare validation form.",
      "body": { "$return": { "$and": [] } },
      "error": "$and must be an array of at least two expressions"
    },
    {
      "description": "$and: rejects a singleton operand array",
      "body": { "$return": { "$and": [true] } },
      "error": "$and must be an array of at least two expressions"
    },
    {
      "description": "$and: an operand past the deciding false is not validated",
      "comment": "Validation attaches to evaluation, never a pre-pass: operands past the deciding one are neither evaluated nor validated.",
      "body": { "$return": { "$and": [false, "never validated"] } },
      "expected": false
    },
    {
      "description": "$and: a non-boolean operand is an immediate error",
      "comment": "The error names the position (1-based operand index) and the evaluated value's kind; it is a host error, not a raise-catchable signal.",
      "body": { "$return": { "$and": [true, "", "unreached"] } },
      "error": "$and operand 2 must be a boolean; got string"
    },
    {
      "description": "$or: returns false when every operand is false",
      "body": { "$return": { "$or": [false, { "$call": "gt", "$args": [1, 2] }, false] } },
      "expected": false
    },
    {
      "description": "$or: returns true at the first true operand without evaluating the rest",
      "body": { "$return": { "$or": [false, true, { "$call": "div", "$args": [1, 0] }] } },
      "expected": true
    },
    {
      "description": "$or: rejects an empty operand array",
      "body": { "$return": { "$or": [] } },
      "error": "$or must be an array of at least two expressions"
    },
    {
      "description": "$or: rejects a singleton operand array",
      "body": { "$return": { "$or": [true] } },
      "error": "$or must be an array of at least two expressions"
    },
    {
      "description": "$or: an operand past the deciding true is not validated",
      "body": { "$return": { "$or": [true, "never validated"] } },
      "expected": true
    },
    {
      "description": "$or: a non-boolean operand is an immediate error",
      "body": { "$return": { "$or": [false, 42, "unreached"] } },
      "error": "$or operand 2 must be a boolean; got number"
    },
    {
      "description": "$and/$or: nested composition",
      "body": {
        "$params": ["x"],
        "$return": {
          "$and": [
            { "$call": "gt", "$args": [{ "$var": "x" }, 0] },
            {
              "$or": [
                { "$call": "eq", "$args": [{ "$var": "x" }, 42] },
                { "$call": "lt", "$args": [{ "$var": "x" }, 100] }
              ]
            }
          ]
        }
      },
      "args": [10],
      "expected": true
    }
  ]
}
