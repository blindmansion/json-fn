{
  "description": "escaping closures carry the enclosing local functions they call as open-body record entries, so recursion and mutual recursion survive leaving the defining scope",
  "cases": [
    {
      "description": "self-recursive local escapes as a closure and remains callable outside its defining scope",
      "body": {
        "$params": ["base", "start"],
        "$return": {
          "$let": {
            "makeCountdown": {
              "$params": ["b"],
              "$return": {
                "$let": {
                  "go": {
                    "$params": ["x"],
                    "$return": {
                      "$if": { "$call": "lte", "$args": [{ "$var": "x" }, 0] },
                      "$then": { "$var": "b" },
                      "$else": {
                        "$call": "go",
                        "$args": [{ "$call": "sub", "$args": [{ "$var": "x" }, 1] }]
                      }
                    }
                  }
                },
                "$in": { "$var": "go" }
              }
            }
          },
          "$in": {
            "$call": { "$call": "makeCountdown", "$args": [{ "$var": "base" }] },
            "$args": [{ "$var": "start" }]
          }
        }
      },
      "args": [42, 3],
      "expected": 42
    },
    {
      "description": "mutually recursive locals escape together (even branch)",
      "body": {
        "$params": ["start"],
        "$return": {
          "$let": {
            "makeParity": {
              "$return": {
                "$let": {
                  "isEven": {
                    "$params": ["n"],
                    "$return": {
                      "$if": { "$call": "eq", "$args": [{ "$var": "n" }, 0] },
                      "$then": true,
                      "$else": {
                        "$call": "isOdd",
                        "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }]
                      }
                    }
                  },
                  "isOdd": {
                    "$params": ["n"],
                    "$return": {
                      "$if": { "$call": "eq", "$args": [{ "$var": "n" }, 0] },
                      "$then": false,
                      "$else": {
                        "$call": "isEven",
                        "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }]
                      }
                    }
                  }
                },
                "$in": { "$var": "isEven" }
              }
            }
          },
          "$in": { "$call": { "$call": "makeParity", "$args": [] }, "$args": [{ "$var": "start" }] }
        }
      },
      "args": [10],
      "expected": true
    },
    {
      "description": "mutually recursive locals escape together (odd branch)",
      "body": {
        "$params": ["start"],
        "$return": {
          "$let": {
            "makeParity": {
              "$return": {
                "$let": {
                  "isEven": {
                    "$params": ["n"],
                    "$return": {
                      "$if": { "$call": "eq", "$args": [{ "$var": "n" }, 0] },
                      "$then": true,
                      "$else": {
                        "$call": "isOdd",
                        "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }]
                      }
                    }
                  },
                  "isOdd": {
                    "$params": ["n"],
                    "$return": {
                      "$if": { "$call": "eq", "$args": [{ "$var": "n" }, 0] },
                      "$then": false,
                      "$else": {
                        "$call": "isEven",
                        "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }]
                      }
                    }
                  }
                },
                "$in": { "$var": "isEven" }
              }
            }
          },
          "$in": { "$call": { "$call": "makeParity", "$args": [] }, "$args": [{ "$var": "start" }] }
        }
      },
      "args": [7],
      "expected": false
    },
    {
      "description": "partial application: a captured param rides the escaping recursive closure's record",
      "body": {
        "$params": ["base", "start"],
        "$return": {
          "$let": {
            "adderFrom": {
              "$params": ["b"],
              "$return": {
                "$let": {
                  "sumDown": {
                    "$params": ["x"],
                    "$return": {
                      "$if": { "$call": "lte", "$args": [{ "$var": "x" }, 0] },
                      "$then": { "$var": "b" },
                      "$else": {
                        "$call": "add",
                        "$args": [
                          { "$var": "x" },
                          {
                            "$call": "sumDown",
                            "$args": [{ "$call": "sub", "$args": [{ "$var": "x" }, 1] }]
                          }
                        ]
                      }
                    }
                  }
                },
                "$in": { "$var": "sumDown" }
              }
            }
          },
          "$in": {
            "$call": { "$call": "adderFrom", "$args": [{ "$var": "base" }] },
            "$args": [{ "$var": "start" }]
          }
        }
      },
      "args": [100, 3],
      "expected": 106
    },
    {
      "description": "escaping closure passes an enclosing local fn to a HOF by reference",
      "body": {
        "$params": ["xs"],
        "$return": {
          "$let": {
            "makeMapper": {
              "$return": {
                "$let": {
                  "triple": {
                    "$params": ["x"],
                    "$return": { "$call": "mul", "$args": [{ "$var": "x" }, 3] }
                  }
                },
                "$in": {
                  "$params": ["ys"],
                  "$return": { "$call": "map", "$args": [{ "$fn": "triple" }, { "$var": "ys" }] }
                }
              }
            }
          },
          "$in": { "$call": { "$call": "makeMapper", "$args": [] }, "$args": [{ "$var": "xs" }] }
        }
      },
      "args": [[1, 2, 3]],
      "expected": [3, 6, 9]
    },
    {
      "description": "inner param shadows an enclosing local fn of the same name; the argument wins and the enclosing definition is not captured in its place",
      "body": {
        "$params": ["base", "arg"],
        "$return": {
          "$let": {
            "makeShadow": {
              "$params": ["b"],
              "$return": {
                "$let": {
                  "go": {
                    "$params": ["x"],
                    "$return": { "$call": "add", "$args": [{ "$var": "x" }, 1000] }
                  }
                },
                "$in": {
                  "$params": ["go"],
                  "$return": { "$call": "go", "$args": [{ "$var": "b" }] }
                }
              }
            }
          },
          "$in": {
            "$call": { "$call": "makeShadow", "$args": [{ "$var": "base" }] },
            "$args": [{ "$var": "arg" }]
          }
        }
      },
      "args": [
        1,
        { "$params": ["x"], "$return": { "$call": "mul", "$args": [{ "$var": "x" }, 3] } }
      ],
      "expected": 3
    }
  ]
}
