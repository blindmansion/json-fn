{
  "description": "name resolution — unified lexical-first shadowing + bare registry references",
  "cases": [
    {
      "description": "a function-valued param shadows an operator (x + 1 uses the passed `add`)",
      "body": {
        "$params": ["add", "x"],
        "$return": { "$call": "add", "$args": [{ "$var": "x" }, 1] }
      },
      "args": ["sub", 10],
      "expected": 9
    },
    {
      "description": "a function-valued param shadows a stdlib function in a direct call",
      "body": { "$params": ["map"], "$return": { "$call": "map", "$args": [2] } },
      "args": [{ "$params": ["x"], "$return": { "$call": "mul", "$args": [{ "$var": "x" }, 10] } }],
      "expected": 20
    },
    {
      "description": "a param shadow survives an escaping closure (captured at creation)",
      "functions": {
        "makeMapper": {
          "$params": ["map"],
          "$return": { "$params": ["x"], "$return": { "$call": "map", "$args": [{ "$var": "x" }] } }
        }
      },
      "body": {
        "$return": {
          "$call": {
            "$call": "makeMapper",
            "$args": [
              { "$params": ["n"], "$return": { "$call": "mul", "$args": [{ "$var": "n" }, 10] } }
            ]
          },
          "$args": [5]
        }
      },
      "expected": 50
    },
    {
      "description": "compose captures both fn params through an escaping closure (incl. a stdlib-colliding `add`)",
      "functions": {
        "compose": {
          "$params": ["add", "g"],
          "$return": {
            "$params": ["x"],
            "$return": { "$call": "add", "$args": [{ "$call": "g", "$args": [{ "$var": "x" }] }] }
          }
        }
      },
      "body": {
        "$return": {
          "$call": {
            "$call": "compose",
            "$args": [
              { "$params": ["n"], "$return": { "$call": "mul", "$args": [{ "$var": "n" }, 10] } },
              { "$params": ["n"], "$return": { "$call": "add", "$args": [{ "$var": "n" }, 1] } }
            ]
          },
          "$args": [5]
        }
      },
      "expected": 60
    },
    {
      "description": "a where-local function shadows stdlib `length`",
      "body": {
        "$params": ["x"],
        "$return": {
          "$let": { "length": { "$params": ["v"], "$return": 999 } },
          "$in": { "$call": "length", "$args": [{ "$var": "x" }] }
        }
      },
      "args": [[1, 2, 3]],
      "expected": 999
    },
    {
      "description": "a where-local function shadows an operator (`add` → subtracts)",
      "body": {
        "$params": ["x"],
        "$return": {
          "$let": {
            "add": {
              "$params": ["a", "b"],
              "$return": { "$call": "sub", "$args": [{ "$var": "a" }, { "$var": "b" }] }
            }
          },
          "$in": { "$call": "add", "$args": [{ "$var": "x" }, 1] }
        }
      },
      "args": [10],
      "expected": 9
    },
    {
      "description": "local recursion still dispatches through the registry (canary)",
      "body": {
        "$params": ["n"],
        "$return": {
          "$let": {
            "fact": {
              "$params": ["m"],
              "$return": {
                "$if": { "$call": "lte", "$args": [{ "$var": "m" }, 1] },
                "$then": 1,
                "$else": {
                  "$call": "mul",
                  "$args": [
                    { "$var": "m" },
                    {
                      "$call": "fact",
                      "$args": [{ "$call": "sub", "$args": [{ "$var": "m" }, 1] }]
                    }
                  ]
                }
              }
            }
          },
          "$in": { "$call": "fact", "$args": [{ "$var": "n" }] }
        }
      },
      "args": [5],
      "expected": 120
    },
    {
      "description": "mutual recursion via where-locals stays green (even)",
      "body": {
        "$params": ["n"],
        "$return": {
          "$let": {
            "isEven": {
              "$params": ["m"],
              "$return": {
                "$if": { "$call": "eq", "$args": [{ "$var": "m" }, 0] },
                "$then": true,
                "$else": {
                  "$call": "isOdd",
                  "$args": [{ "$call": "sub", "$args": [{ "$var": "m" }, 1] }]
                }
              }
            },
            "isOdd": {
              "$params": ["m"],
              "$return": {
                "$if": { "$call": "eq", "$args": [{ "$var": "m" }, 0] },
                "$then": false,
                "$else": {
                  "$call": "isEven",
                  "$args": [{ "$call": "sub", "$args": [{ "$var": "m" }, 1] }]
                }
              }
            }
          },
          "$in": { "$call": "isEven", "$args": [{ "$var": "n" }] }
        }
      },
      "args": [10],
      "expected": true
    },
    {
      "description": "mutual recursion via where-locals stays green (odd)",
      "body": {
        "$params": ["n"],
        "$return": {
          "$let": {
            "isEven": {
              "$params": ["m"],
              "$return": {
                "$if": { "$call": "eq", "$args": [{ "$var": "m" }, 0] },
                "$then": true,
                "$else": {
                  "$call": "isOdd",
                  "$args": [{ "$call": "sub", "$args": [{ "$var": "m" }, 1] }]
                }
              }
            },
            "isOdd": {
              "$params": ["m"],
              "$return": {
                "$if": { "$call": "eq", "$args": [{ "$var": "m" }, 0] },
                "$then": false,
                "$else": {
                  "$call": "isEven",
                  "$args": [{ "$call": "sub", "$args": [{ "$var": "m" }, 1] }]
                }
              }
            }
          },
          "$in": { "$call": "isEven", "$args": [{ "$var": "n" }] }
        }
      },
      "args": [7],
      "expected": false
    },
    {
      "description": "a bare stdlib name in value position resolves to its `&`-free reference",
      "body": { "$return": { "$var": "length" } },
      "expected": "length"
    },
    {
      "description": "map(length, xss) works without `&` (bare registry name as argument)",
      "body": {
        "$params": ["xss"],
        "$return": { "$call": "map", "$args": [{ "$var": "length" }, { "$var": "xss" }] }
      },
      "args": [
        [
          [1, 2],
          [3, 4, 5]
        ]
      ],
      "expected": [2, 3]
    },
    {
      "description": "a local binding shadows the stdlib name in value position",
      "body": {
        "$params": ["x"],
        "$return": { "$let": { "length": 42 }, "$in": { "$var": "length" } }
      },
      "args": [7],
      "expected": 42
    },
    {
      "description": "an unknown bare name still errors",
      "body": { "$return": { "$var": "definitelyNotRegistered" } },
      "error": "Variable definitelyNotRegistered not found"
    },
    {
      "description": "a non-function local named like a builtin does NOT hijack the operator",
      "body": {
        "$params": ["x"],
        "$return": {
          "$let": { "add": 5 },
          "$in": { "$call": "add", "$args": [{ "$var": "x" }, 1] }
        }
      },
      "args": [10],
      "expected": 11
    }
  ]
}
