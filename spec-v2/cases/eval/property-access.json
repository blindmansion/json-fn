{
  "description": "property access with $var/$get and $get/$from",
  "cases": [
    {
      "description": "single key access on an object",
      "body": {
        "$return": {
          "$let": { "person": { "name": "Ada", "age": 36 } },
          "$in": { "$get": "name", "$from": { "$var": "person" } }
        }
      },
      "expected": "Ada"
    },
    {
      "description": "numeric index access on an array",
      "body": { "$return": { "$get": 1, "$from": [10, 20, 30] } },
      "expected": 20
    },
    {
      "description": "dynamic key via variable",
      "body": {
        "$return": {
          "$let": { "data": { "x": 100, "y": 200 }, "field": "y" },
          "$in": { "$get": { "$var": "field" }, "$from": { "$var": "data" } }
        }
      },
      "expected": 200
    },
    {
      "description": "dynamic key from function result",
      "body": {
        "$return": {
          "$let": { "data": { "hello": "world" } },
          "$in": {
            "$get": { "$call": "strcat", "$args": ["hel", "lo"] },
            "$from": { "$var": "data" }
          }
        }
      },
      "expected": "world"
    },
    {
      "description": "missing key returns null",
      "body": {
        "$return": {
          "$let": { "obj": { "a": 1 } },
          "$in": { "$get": "z", "$from": { "$var": "obj" } }
        }
      },
      "expected": null
    },
    {
      "description": "path traversal into a present null value throws",
      "body": {
        "$return": {
          "$let": { "obj": { "a": null } },
          "$in": { "$get": "b", "$from": { "$get": "a", "$from": { "$var": "obj" } } }
        }
      },
      "error": "Cannot access property"
    },
    {
      "description": "$get from function call result",
      "body": { "$return": { "$get": 0, "$from": { "$call": "concat", "$args": [[10], [20]] } } },
      "expected": 10
    },
    {
      "description": "get field then transform",
      "body": {
        "$return": {
          "$let": {
            "person": { "name": "ada", "age": 36 },
            "name": { "$get": "name", "$from": { "$var": "person" } }
          },
          "$in": { "$call": "upper", "$args": [{ "$var": "name" }] }
        }
      },
      "expected": "ADA"
    },
    {
      "description": "closure captures outer var for $get",
      "body": {
        "$params": ["data"],
        "$return": {
          "$params": ["key"],
          "$return": { "$get": { "$var": "key" }, "$from": { "$var": "data" } }
        }
      },
      "args": [{ "x": 10, "y": 20 }],
      "expected": {
        "$params": ["key"],
        "$return": { "$get": { "$var": "key" }, "$from": { "x": 10, "y": 20 } }
      }
    },
    {
      "description": "closure-returned accessor works end-to-end",
      "body": {
        "$params": ["data"],
        "$return": {
          "$let": {
            "accessor": {
              "$params": ["key"],
              "$return": { "$get": { "$var": "key" }, "$from": { "$var": "data" } }
            }
          },
          "$in": { "$call": { "$var": "accessor" }, "$args": ["y"] }
        }
      },
      "args": [{ "x": 10, "y": 20 }],
      "expected": 20
    },
    {
      "description": "dot notation: single property access",
      "body": {
        "$return": {
          "$let": { "person": { "name": "Ada", "age": 36 } },
          "$in": { "$get": "name", "$from": { "$var": "person" } }
        }
      },
      "expected": "Ada"
    },
    {
      "description": "dot notation: nested property access",
      "body": {
        "$return": {
          "$let": { "person": { "address": { "city": "London", "zip": "SW1" } } },
          "$in": { "$get": "city", "$from": { "$get": "address", "$from": { "$var": "person" } } }
        }
      },
      "expected": "London"
    },
    {
      "description": "dot notation: bracket index on array",
      "body": {
        "$return": {
          "$let": { "items": ["a", "b", "c"] },
          "$in": { "$get": 1, "$from": { "$var": "items" } }
        }
      },
      "expected": "b"
    },
    {
      "description": "dot notation: mixed dots and brackets",
      "body": {
        "$return": {
          "$let": { "data": { "items": [{ "name": "first" }, { "name": "second" }] } },
          "$in": {
            "$get": "name",
            "$from": { "$get": 1, "$from": { "$get": "items", "$from": { "$var": "data" } } }
          }
        }
      },
      "expected": "second"
    },
    {
      "description": "dot notation: bracket then dot",
      "body": {
        "$return": {
          "$let": {
            "rows": [
              { "x": 10, "y": 20 },
              { "x": 30, "y": 40 }
            ]
          },
          "$in": { "$get": "y", "$from": { "$get": 0, "$from": { "$var": "rows" } } }
        }
      },
      "expected": 20
    },
    {
      "description": "dot notation: deeply nested path",
      "body": {
        "$return": {
          "$let": { "a": { "b": { "c": { "d": 42 } } } },
          "$in": {
            "$get": "d",
            "$from": { "$get": "c", "$from": { "$get": "b", "$from": { "$var": "a" } } }
          }
        }
      },
      "expected": 42
    },
    {
      "description": "dot notation: missing key returns null",
      "body": {
        "$return": {
          "$let": { "obj": { "a": 1 } },
          "$in": { "$get": "z", "$from": { "$var": "obj" } }
        }
      },
      "expected": null
    },
    {
      "description": "dot notation: path into non-object throws",
      "body": {
        "$return": {
          "$let": { "obj": { "a": 42 } },
          "$in": { "$get": "b", "$from": { "$get": "a", "$from": { "$var": "obj" } } }
        }
      },
      "error": "Cannot access property"
    },
    {
      "description": "dot notation: out-of-bounds index returns null",
      "body": {
        "$return": {
          "$let": { "items": [1, 2, 3] },
          "$in": { "$get": 99, "$from": { "$var": "items" } }
        }
      },
      "expected": null
    },
    {
      "description": "dot notation combined with $get",
      "body": {
        "$return": {
          "$let": {
            "data": {
              "people": [
                { "name": "Ada", "city": "London" },
                { "name": "Bob", "city": "Paris" }
              ]
            }
          },
          "$in": {
            "$get": "city",
            "$from": { "$get": 0, "$from": { "$get": "people", "$from": { "$var": "data" } } }
          }
        }
      },
      "expected": "London"
    },
    {
      "description": "dot notation with $get dynamic key",
      "body": {
        "$return": {
          "$let": { "data": { "record": { "x": 100, "y": 200 } }, "field": "y" },
          "$in": {
            "$get": { "$var": "field" },
            "$from": { "$get": "record", "$from": { "$var": "data" } }
          }
        }
      },
      "expected": 200
    },
    {
      "description": "dot notation: non-numeric bracket is string key",
      "body": {
        "$return": {
          "$let": { "data": { "my-key": 99 } },
          "$in": { "$get": "my-key", "$from": { "$var": "data" } }
        }
      },
      "expected": 99
    },
    {
      "description": "dot notation: used in function argument",
      "body": {
        "$return": {
          "$let": { "person": { "name": "ada" } },
          "$in": { "$call": "upper", "$args": [{ "$get": "name", "$from": { "$var": "person" } }] }
        }
      },
      "expected": "ADA"
    },
    {
      "description": "dot notation: used with $params",
      "body": { "$params": ["data"], "$return": { "$get": "name", "$from": { "$var": "data" } } },
      "args": [{ "name": "Ada", "age": 36 }],
      "expected": "Ada"
    },
    {
      "description": "dot notation: closure captures variable used with dot path",
      "body": {
        "$params": ["person"],
        "$return": {
          "$params": ["unused"],
          "$return": { "$get": "name", "$from": { "$var": "person" } }
        }
      },
      "args": [{ "name": "Ada", "age": 36 }],
      "expected": {
        "$params": ["unused"],
        "$return": { "$get": "name", "$from": { "name": "Ada", "age": 36 } }
      }
    },
    {
      "description": "dot notation: closure-returned function with dot path works end-to-end",
      "body": {
        "$params": ["person"],
        "$return": {
          "$let": {
            "getter": {
              "$params": ["unused"],
              "$return": { "$get": "name", "$from": { "$var": "person" } }
            }
          },
          "$in": { "$call": { "$var": "getter" }, "$args": [null] }
        }
      },
      "args": [{ "name": "Ada", "age": 36 }],
      "expected": "Ada"
    },
    {
      "description": "dot notation: closure with dot path and $get",
      "body": {
        "$params": ["data"],
        "$return": {
          "$params": ["key"],
          "$return": {
            "$get": { "$var": "key" },
            "$from": { "$get": "nested", "$from": { "$var": "data" } }
          }
        }
      },
      "args": [{ "nested": { "x": 10, "y": 20 } }],
      "expected": {
        "$params": ["key"],
        "$return": {
          "$get": { "$var": "key" },
          "$from": { "$get": "nested", "$from": { "nested": { "x": 10, "y": 20 } } }
        }
      }
    },
    {
      "description": "dot notation: closure with dot path and $get end-to-end",
      "body": {
        "$params": ["data"],
        "$return": {
          "$let": {
            "accessor": {
              "$params": ["key"],
              "$return": {
                "$get": { "$var": "key" },
                "$from": { "$get": "nested", "$from": { "$var": "data" } }
              }
            }
          },
          "$in": { "$call": { "$var": "accessor" }, "$args": ["y"] }
        }
      },
      "args": [{ "nested": { "x": 10, "y": 20 } }],
      "expected": 20
    },
    {
      "description": "$get on string: index 0",
      "body": { "$return": { "$get": 0, "$from": "hello" } },
      "expected": "h"
    },
    {
      "description": "$get on string: middle index",
      "body": { "$return": { "$get": 2, "$from": "hello" } },
      "expected": "l"
    },
    {
      "description": "$get on string: last index",
      "body": { "$return": { "$get": 4, "$from": "hello" } },
      "expected": "o"
    },
    {
      "description": "$get on string: indexes Unicode code points",
      "body": { "$return": { "$get": 1, "$from": "a😀b" } },
      "expected": "😀"
    },
    {
      "description": "$get on string: code-point index after astral character",
      "body": { "$return": { "$get": 2, "$from": "a😀b" } },
      "expected": "b"
    },
    {
      "description": "$get on string: out of bounds returns null",
      "body": { "$return": { "$get": 10, "$from": "hi" } },
      "expected": null
    },
    {
      "description": "$get on string: via $var",
      "body": {
        "$return": { "$let": { "s": "abcdef" }, "$in": { "$get": 3, "$from": { "$var": "s" } } }
      },
      "expected": "d"
    },
    {
      "description": "$get on string: computed index",
      "body": {
        "$return": {
          "$let": { "s": "world" },
          "$in": { "$get": { "$call": "sub", "$args": [4, 2] }, "$from": { "$var": "s" } }
        }
      },
      "expected": "r"
    },
    {
      "description": "$get on string: non-numeric key throws",
      "body": { "$return": { "$get": "x", "$from": "hello" } },
      "error": "string indices must be integers"
    },
    {
      "description": "$var bracket notation on string",
      "body": {
        "$return": { "$let": { "s": "hello" }, "$in": { "$get": 0, "$from": { "$var": "s" } } }
      },
      "expected": "h"
    },
    {
      "description": "$var bracket notation on string: middle char",
      "body": {
        "$return": { "$let": { "s": "world" }, "$in": { "$get": 3, "$from": { "$var": "s" } } }
      },
      "expected": "l"
    },
    {
      "description": "$var bracket notation on string: out of bounds returns null",
      "body": {
        "$return": { "$let": { "s": "hi" }, "$in": { "$get": 5, "$from": { "$var": "s" } } }
      },
      "expected": null
    },
    {
      "description": "$var dot path ending in string index",
      "body": {
        "$return": {
          "$let": { "data": { "name": "Alice" } },
          "$in": { "$get": 0, "$from": { "$get": "name", "$from": { "$var": "data" } } }
        }
      },
      "expected": "A"
    },
    {
      "description": "object access rejects a numeric key",
      "body": { "$return": { "$get": 1, "$from": { "1": "one" } } },
      "error": "Cannot index an object with key 1: object keys must be strings"
    },
    {
      "description": "object access accepts an explicitly stringified numeric key",
      "body": { "$return": { "$get": { "$call": "str", "$args": [1] }, "$from": { "1": "one" } } },
      "expected": "one"
    },
    {
      "description": "array access rejects a string index",
      "body": { "$return": { "$get": "0", "$from": ["first"] } },
      "error": "Cannot index an array with key \"0\": array indices must be integers"
    },
    {
      "description": "array access rejects a fractional numeric index",
      "body": { "$return": { "$get": 1.5, "$from": ["first", "second"] } },
      "error": "Cannot index an array with key 1.5: array indices must be integers"
    },
    {
      "description": "string access rejects a string index",
      "body": { "$return": { "$get": "0", "$from": "hello" } },
      "error": "Cannot index a string with key \"0\": string indices must be integers"
    },
    {
      "description": "string access rejects a fractional numeric index",
      "body": { "$return": { "$get": 1.5, "$from": "hello" } },
      "error": "Cannot index a string with key 1.5: string indices must be integers"
    },
    {
      "description": "negative array index is valid but out of bounds",
      "body": { "$return": { "$get": -1, "$from": ["first"] } },
      "expected": null
    },
    {
      "description": "negative string index is valid but out of bounds",
      "body": { "$return": { "$get": -1, "$from": "hello" } },
      "expected": null
    },
    {
      "description": "object access does not read inherited properties",
      "body": { "$return": { "$get": "toString", "$from": { "$raw": {} } } },
      "expected": null
    },
    {
      "description": "object access reads an own constructor property",
      "body": { "$return": { "$get": "constructor", "$from": { "constructor": "data" } } },
      "expected": "data"
    },
    {
      "description": "object access reads an own __proto__ property",
      "body": { "$return": { "$get": "__proto__", "$from": { "$raw": { "__proto__": "data" } } } },
      "expected": "data"
    }
  ]
}
