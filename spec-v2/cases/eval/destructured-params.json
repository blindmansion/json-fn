{
  "description": "destructured (object-pattern) parameters — $fields (plans/destructured-params.md)",
  "functions": {
    "move": {
      "$params": ["__p0"],
      "$return": {
        "$let": {
          "from": { "$get": "from", "$from": { "$var": "__p0" } },
          "to": { "$get": "to", "$from": { "$var": "__p0" } }
        },
        "$in": { "$call": "sub", "$args": [{ "$var": "to" }, { "$var": "from" }] }
      }
    }
  },
  "cases": [
    {
      "description": "binds named fields from an object argument",
      "body": {
        "$params": ["__p0"],
        "$return": {
          "$let": {
            "from": { "$get": "from", "$from": { "$var": "__p0" } },
            "to": { "$get": "to", "$from": { "$var": "__p0" } }
          },
          "$in": { "$call": "sub", "$args": [{ "$var": "to" }, { "$var": "from" }] }
        }
      },
      "args": [{ "from": 3, "to": 7 }],
      "expected": 4
    },
    {
      "description": "called in-language with a data object is an ordinary positional call",
      "body": { "$return": { "$call": "move", "$args": [{ "from": 3, "to": 7 }] } },
      "expected": 4
    },
    {
      "description": "single field pattern",
      "body": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
          "$in": { "$call": "mul", "$args": [{ "$var": "x" }, 2] }
        }
      },
      "args": [{ "x": 21 }],
      "expected": 42
    },
    {
      "description": "absent required key is rejected",
      "body": { "$params": [{ "$fields": ["from", "to"] }], "$return": { "$var": "to" } },
      "args": [{ "from": 5 }],
      "error": "Missing required field \"to\""
    },
    {
      "description": "extra keys are ignored",
      "body": {
        "$params": ["__p0"],
        "$return": {
          "$let": {
            "from": { "$get": "from", "$from": { "$var": "__p0" } },
            "to": { "$get": "to", "$from": { "$var": "__p0" } }
          },
          "$in": { "$call": "add", "$args": [{ "$var": "from" }, { "$var": "to" }] }
        }
      },
      "args": [{ "from": 1, "to": 2, "extra": 99 }],
      "expected": 3
    },
    {
      "description": "non-object argument (number) is rejected",
      "body": {
        "$params": [{ "$fields": ["a"] }],
        "$return": { "$call": "isNull", "$args": [{ "$var": "a" }] }
      },
      "args": [5],
      "error": "expected a plain object, received number"
    },
    {
      "description": "missing object-pattern argument is rejected",
      "body": {
        "$params": [{ "$fields": ["a", "b"] }],
        "$return": { "$call": "isNull", "$args": [{ "$var": "b" }] }
      },
      "error": "Missing object-pattern argument at parameter position 1"
    },
    {
      "description": "null object-pattern argument is rejected",
      "body": {
        "$params": [{ "$fields": ["a"] }],
        "$return": { "$call": "isNull", "$args": [{ "$var": "a" }] }
      },
      "args": [null],
      "error": "expected a plain object, received null"
    },
    {
      "description": "array object-pattern argument is rejected",
      "body": {
        "$params": [{ "$fields": ["a"] }],
        "$return": { "$call": "isNull", "$args": [{ "$var": "a" }] }
      },
      "args": [[1, 2, 3]],
      "error": "expected a plain object, received array"
    },
    {
      "description": "string object-pattern argument is rejected",
      "body": { "$params": [{ "$fields": ["a"] }], "$return": { "$var": "a" } },
      "args": ["text"],
      "error": "expected a plain object, received string"
    },
    {
      "description": "boolean object-pattern argument is rejected",
      "body": { "$params": [{ "$fields": ["a"] }], "$return": { "$var": "a" } },
      "args": [false],
      "error": "expected a plain object, received boolean"
    },
    {
      "description": "mixed positional and pattern slots",
      "body": {
        "$params": ["label", "__p1"],
        "$return": {
          "$let": {
            "x": { "$get": "x", "$from": { "$var": "__p1" } },
            "y": { "$get": "y", "$from": { "$var": "__p1" } }
          },
          "$in": {
            "label": { "$var": "label" },
            "sum": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] }
          }
        }
      },
      "args": ["p", { "x": 1, "y": 2 }],
      "expected": { "label": "p", "sum": 3 }
    },
    {
      "description": "pattern slot followed by a rest parameter",
      "body": {
        "$params": ["__p0", "...rest"],
        "$return": {
          "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
          "$in": { "x": { "$var": "x" }, "rest": { "$var": "rest" } }
        }
      },
      "args": [{ "x": 1 }, 2, 3],
      "expected": { "x": 1, "rest": [2, 3] }
    },
    {
      "description": "multiple pattern slots each destructure their own argument",
      "body": {
        "$params": ["__p0", "__p1"],
        "$return": {
          "$let": {
            "a": { "$get": "a", "$from": { "$var": "__p0" } },
            "b": { "$get": "b", "$from": { "$var": "__p1" } }
          },
          "$in": { "$call": "add", "$args": [{ "$var": "a" }, { "$var": "b" }] }
        }
      },
      "args": [{ "a": 1 }, { "b": 2 }],
      "expected": 3
    },
    {
      "description": "fields are visible to lazy locals",
      "body": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "n": { "$get": "n", "$from": { "$var": "__p0" } } },
          "$in": {
            "$let": { "twice": { "$call": "mul", "$args": [{ "$var": "n" }, 2] } },
            "$in": { "$var": "twice" }
          }
        }
      },
      "args": [{ "n": 21 }],
      "expected": 42
    },
    {
      "description": "fields are visible inside a nested inline function call",
      "body": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
          "$in": {
            "$call": {
              "$params": ["y"],
              "$return": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] }
            },
            "$args": [5]
          }
        }
      },
      "args": [{ "x": 10 }],
      "expected": 15
    },
    {
      "description": "an inner parameter shadows an outer field of the same name",
      "body": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
          "$in": { "$call": { "$params": ["x"], "$return": { "$var": "x" } }, "$args": [99] }
        }
      },
      "args": [{ "x": 1 }],
      "expected": 99
    },
    {
      "description": "arity counts a pattern slot as one parameter",
      "body": {
        "$return": {
          "$let": {
            "fn": {
              "$params": ["__p0"],
              "$return": {
                "$let": {
                  "from": { "$get": "from", "$from": { "$var": "__p0" } },
                  "to": { "$get": "to", "$from": { "$var": "__p0" } }
                },
                "$in": { "$var": "from" }
              }
            }
          },
          "$in": { "$call": "arity", "$args": [{ "$var": "fn" }] }
        }
      },
      "expected": 1
    },
    {
      "description": "arity counts positional plus pattern slots",
      "body": {
        "$return": {
          "$let": {
            "fn": {
              "$params": ["a", "__p1"],
              "$return": {
                "$let": {
                  "x": { "$get": "x", "$from": { "$var": "__p1" } },
                  "y": { "$get": "y", "$from": { "$var": "__p1" } }
                },
                "$in": { "$var": "a" }
              }
            }
          },
          "$in": { "$call": "arity", "$args": [{ "$var": "fn" }] }
        }
      },
      "expected": 2
    },
    {
      "description": "arity excludes the rest parameter after a pattern slot",
      "body": {
        "$return": {
          "$let": {
            "fn": {
              "$params": ["__p0", "...rest"],
              "$return": {
                "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
                "$in": { "$var": "x" }
              }
            }
          },
          "$in": { "$call": "arity", "$args": [{ "$var": "fn" }] }
        }
      },
      "expected": 1
    }
  ]
}
