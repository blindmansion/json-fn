{
  "description": "Function values hash under jfn:value:v1 as the ordinary values they are: the body subtree encodes byte-identical to the normalized source body, the capture record is plain object data under canonical key ordering, and an empty record is omitted",
  "cases": [
    {
      "name": "a body with no free variables carries no record: the value encodes identically to its source body",
      "value": { "$params": ["y"], "$return": { "$call": "mul", "$args": [{ "$var": "y" }, 2] } },
      "canonical": "{\"$params\":[\"y\"],\"$return\":{\"$args\":[{\"$var\":\"y\"},2],\"$call\":\"mul\"}}",
      "valueHash": "jfn:value:v1:sha256:6a0b0a40a4e5cff338f2bbfa6b19917db571f26bd796a656194dce324fcff3ac"
    },
    {
      "name": "curried add: the inner source body, with x free",
      "value": {
        "$params": ["y"],
        "$return": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] }
      },
      "canonical": "{\"$params\":[\"y\"],\"$return\":{\"$args\":[{\"$var\":\"x\"},{\"$var\":\"y\"}],\"$call\":\"add\"}}",
      "valueHash": "jfn:value:v1:sha256:750f950d0e413beee9a7fa65c191f7151e76e08a58722a90d50aeb954d3961cf"
    },
    {
      "name": "simple value capture: the same body applied with x = 10; the $params and $return subtrees encode byte-identical to the source-body vector",
      "value": {
        "$params": ["y"],
        "$return": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] },
        "$captures": { "x": 10 }
      },
      "canonical": "{\"$captures\":{\"x\":10},\"$params\":[\"y\"],\"$return\":{\"$args\":[{\"$var\":\"x\"},{\"$var\":\"y\"}],\"$call\":\"add\"}}",
      "valueHash": "jfn:value:v1:sha256:27ba1fae2171ddf7fe0ae67b2cebb3ccd158d34bd7a67073225bbf9de8ee4ad1"
    },
    {
      "name": "a captured value with call-shaped keys is inert record data and hashes as the exact structure it is",
      "value": {
        "$return": { "$var": "x" },
        "$captures": { "x": { "$call": "add", "$args": [1, 2] } }
      },
      "canonical": "{\"$captures\":{\"x\":{\"$args\":[1,2],\"$call\":\"add\"}},\"$return\":{\"$var\":\"x\"}}",
      "valueHash": "jfn:value:v1:sha256:da4c47a372ba076698d89a11d9451dd6c1a3721f880152da7424bd76c01b001c"
    },
    {
      "name": "nested closure: a record entry that is itself a record-carrying function value",
      "value": {
        "$params": ["y"],
        "$return": { "$call": "f", "$args": [{ "$var": "y" }] },
        "$captures": {
          "f": {
            "$params": ["y"],
            "$return": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] },
            "$captures": { "x": 10 }
          }
        }
      },
      "canonical": "{\"$captures\":{\"f\":{\"$captures\":{\"x\":10},\"$params\":[\"y\"],\"$return\":{\"$args\":[{\"$var\":\"x\"},{\"$var\":\"y\"}],\"$call\":\"add\"}}},\"$params\":[\"y\"],\"$return\":{\"$args\":[{\"$var\":\"y\"}],\"$call\":\"f\"}}",
      "valueHash": "jfn:value:v1:sha256:2059f33751e3ec1c57e825b5a949725896edb41e2a7a69e5cb6d0d229574aeaa"
    },
    {
      "name": "self-recursive escape: an open-body self entry beside a captured value; open bodies carry no records of their own",
      "value": {
        "$params": ["x"],
        "$return": {
          "$if": { "$call": "lte", "$args": [{ "$var": "x" }, 0] },
          "$then": { "$var": "base" },
          "$else": { "$call": "go", "$args": [{ "$call": "sub", "$args": [{ "$var": "x" }, 1] }] }
        },
        "$captures": {
          "base": 42,
          "go": {
            "$params": ["x"],
            "$return": {
              "$if": { "$call": "lte", "$args": [{ "$var": "x" }, 0] },
              "$then": { "$var": "base" },
              "$else": {
                "$call": "go",
                "$args": [{ "$call": "sub", "$args": [{ "$var": "x" }, 1] }]
              }
            }
          }
        }
      },
      "canonical": "{\"$captures\":{\"base\":42,\"go\":{\"$params\":[\"x\"],\"$return\":{\"$else\":{\"$args\":[{\"$args\":[{\"$var\":\"x\"},1],\"$call\":\"sub\"}],\"$call\":\"go\"},\"$if\":{\"$args\":[{\"$var\":\"x\"},0],\"$call\":\"lte\"},\"$then\":{\"$var\":\"base\"}}}},\"$params\":[\"x\"],\"$return\":{\"$else\":{\"$args\":[{\"$args\":[{\"$var\":\"x\"},1],\"$call\":\"sub\"}],\"$call\":\"go\"},\"$if\":{\"$args\":[{\"$var\":\"x\"},0],\"$call\":\"lte\"},\"$then\":{\"$var\":\"base\"}}}",
      "valueHash": "jfn:value:v1:sha256:706676a4e3ece84c7a68e40a6c0fef4a177e25fe977f545a2deefa094e4c7208"
    },
    {
      "name": "mutual group: one open-body entry per member reached in call position, plus the group's one captured value",
      "value": {
        "$params": ["n"],
        "$return": {
          "$if": { "$call": "eq", "$args": [{ "$var": "n" }, 0] },
          "$then": true,
          "$else": {
            "$call": "isOdd",
            "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }]
          }
        },
        "$captures": {
          "isEven": {
            "$params": ["n"],
            "$return": {
              "$if": { "$call": "eq", "$args": [{ "$var": "n" }, 0] },
              "$then": true,
              "$else": {
                "$call": "isOdd",
                "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }]
              }
            }
          },
          "isOdd": {
            "$params": ["n"],
            "$return": {
              "$if": { "$call": "gt", "$args": [{ "$var": "n" }, { "$var": "limit" }] },
              "$then": false,
              "$else": {
                "$if": { "$call": "eq", "$args": [{ "$var": "n" }, 0] },
                "$then": false,
                "$else": {
                  "$call": "isEven",
                  "$args": [{ "$call": "sub", "$args": [{ "$var": "n" }, 1] }]
                }
              }
            }
          },
          "limit": 100
        }
      },
      "canonical": "{\"$captures\":{\"isEven\":{\"$params\":[\"n\"],\"$return\":{\"$else\":{\"$args\":[{\"$args\":[{\"$var\":\"n\"},1],\"$call\":\"sub\"}],\"$call\":\"isOdd\"},\"$if\":{\"$args\":[{\"$var\":\"n\"},0],\"$call\":\"eq\"},\"$then\":true}},\"isOdd\":{\"$params\":[\"n\"],\"$return\":{\"$else\":{\"$else\":{\"$args\":[{\"$args\":[{\"$var\":\"n\"},1],\"$call\":\"sub\"}],\"$call\":\"isEven\"},\"$if\":{\"$args\":[{\"$var\":\"n\"},0],\"$call\":\"eq\"},\"$then\":false},\"$if\":{\"$args\":[{\"$var\":\"n\"},{\"$var\":\"limit\"}],\"$call\":\"gt\"},\"$then\":false}},\"limit\":100},\"$params\":[\"n\"],\"$return\":{\"$else\":{\"$args\":[{\"$args\":[{\"$var\":\"n\"},1],\"$call\":\"sub\"}],\"$call\":\"isOdd\"},\"$if\":{\"$args\":[{\"$var\":\"n\"},0],\"$call\":\"eq\"},\"$then\":true}}",
      "valueHash": "jfn:value:v1:sha256:48e55e185aaf7f2499bf565c04a6dc2b32ea598e4923263e8a84109873c83659"
    },
    {
      "name": "the record scopes over parameter defaults: a $default expression reading a record entry rides the value unrewritten",
      "value": {
        "$params": ["score", { "$param": "boost", "$default": { "$var": "bonus" } }],
        "$return": { "$call": "add", "$args": [{ "$var": "score" }, { "$var": "boost" }] },
        "$captures": { "bonus": 5 }
      },
      "canonical": "{\"$captures\":{\"bonus\":5},\"$params\":[\"score\",{\"$default\":{\"$var\":\"bonus\"},\"$param\":\"boost\"}],\"$return\":{\"$args\":[{\"$var\":\"score\"},{\"$var\":\"boost\"}],\"$call\":\"add\"}}",
      "valueHash": "jfn:value:v1:sha256:ef29da853e0c14737330b5dbf5d0f863793bb448c1537daaaa084ac24e6bc612"
    },
    {
      "name": "typed slots and a return annotation are part of the value's bytes and participate in its address",
      "value": {
        "$params": [{ "$param": "amount", "$type": { "type": "number" } }],
        "$returns": { "type": "number" },
        "$return": { "$call": "mul", "$args": [{ "$var": "amount" }, { "$var": "rate" }] },
        "$captures": { "rate": 0.2 }
      },
      "canonical": "{\"$captures\":{\"rate\":0.2},\"$params\":[{\"$param\":\"amount\",\"$type\":{\"type\":\"number\"}}],\"$return\":{\"$args\":[{\"$var\":\"amount\"},{\"$var\":\"rate\"}],\"$call\":\"mul\"},\"$returns\":{\"type\":\"number\"}}",
      "valueHash": "jfn:value:v1:sha256:0a4f7a5b23df408ea186d6aa3a883403ad0c74fec6e8a9897486b1a7ae48bca7"
    }
  ]
}
