{
  "$schema": "../../builtin.schema.json",
  "builtin": "pure",
  "description": "Build a completed task carrying any JSON value.",
  "cases": [
    {
      "description": "builds a tagged pure task",
      "args": [42],
      "outcome": { "returns": { "@task": "pure", "value": 42 } }
    },
    {
      "description": "wraps an object value",
      "args": [{ "a": 1, "b": [2, 3] }],
      "outcome": { "returns": { "@task": "pure", "value": { "a": 1, "b": [2, 3] } } }
    }
  ]
}
