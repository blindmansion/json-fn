{
  "$schema": "../../builtin.schema.json",
  "builtin": "reduceIndexed",
  "description": "Fold arrays with callbacks that also receive each index.",
  "cases": [
    {
      "description": "passes each accumulator, value, and index",
      "args": [
        {
          "$callback": {
            "steps": [
              { "args": [0, 10, 0], "outcome": { "returns": 0 } },
              { "args": [0, 20, 1], "outcome": { "returns": 1 } },
              { "args": [1, 30, 2], "outcome": { "returns": 3 } }
            ]
          }
        },
        0,
        [10, 20, 30]
      ],
      "outcome": { "returns": 3 },
      "observations": { "meter": { "charged": 3 } }
    }
  ]
}
