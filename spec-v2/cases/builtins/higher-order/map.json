{
  "$schema": "../../builtin.schema.json",
  "builtin": "map",
  "description": "Transform array elements with unary callbacks.",
  "cases": [
    {
      "description": "passes each value without an index",
      "args": [
        {
          "$callback": {
            "steps": [
              { "args": [1], "outcome": { "returns": 2 } },
              { "args": [2], "outcome": { "returns": 4 } },
              { "args": [3], "outcome": { "returns": 6 } }
            ]
          }
        },
        [1, 2, 3]
      ],
      "outcome": { "returns": [2, 4, 6] },
      "observations": { "meter": { "charged": 3 } }
    }
  ]
}
