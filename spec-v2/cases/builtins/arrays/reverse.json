{
  "$schema": "../../builtin.schema.json",
  "builtin": "reverse",
  "description": "Return a reversed copy of an array.",
  "cases": [
    {
      "description": "reverses array order",
      "args": [[1, 2, 3, 4, 5]],
      "outcome": { "returns": [5, 4, 3, 2, 1] }
    },
    {
      "description": "returns an empty array for empty input",
      "args": [[]],
      "outcome": { "returns": [] }
    },
    {
      "description": "leaves a single-element array unchanged",
      "args": [[42]],
      "outcome": { "returns": [42] }
    },
    {
      "description": "works with mixed element types",
      "args": [["a", 1, true, null]],
      "outcome": { "returns": [null, true, 1, "a"] }
    },
    {
      "description": "rejects a non-array argument",
      "args": ["abc"],
      "outcome": { "throws": { "messageIncludes": "argument must be an array" } }
    }
  ]
}
