{
  "$schema": "../../builtin.schema.json",
  "builtin": "unique",
  "description": "Keep first occurrences of structurally distinct array values.",
  "cases": [
    {
      "description": "preserves first-occurrence order",
      "args": [[3, 1, 3, 2, 1]],
      "outcome": { "returns": [3, 1, 2] }
    },
    {
      "description": "uses structural equality",
      "args": [[{ "a": 1 }, { "a": 1 }, [1, 2], [1, 2], { "a": 2 }]],
      "outcome": { "returns": [{ "a": 1 }, [1, 2], { "a": 2 }] }
    },
    {
      "description": "rejects a non-array argument",
      "args": ["abc"],
      "outcome": { "throws": { "messageIncludes": "argument must be an array" } }
    }
  ]
}
