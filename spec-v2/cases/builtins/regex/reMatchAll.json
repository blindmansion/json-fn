{
  "$schema": "../../builtin.schema.json",
  "builtin": "reMatchAll",
  "description": "Return all non-overlapping regex match objects.",
  "cases": [
    {
      "description": "finds every digit run",
      "args": ["\\d+", "a1b22c333"],
      "outcome": {
        "returns": [
          { "match": "1", "index": 1, "groups": [], "named": {} },
          { "match": "22", "index": 3, "groups": [], "named": {} },
          { "match": "333", "index": 6, "groups": [], "named": {} }
        ]
      },
      "observations": { "meter": { "charged": 15 } }
    },
    {
      "description": "returns an empty array when there are no matches",
      "args": ["\\d+", "abcdef"],
      "outcome": { "returns": [] }
    },
    {
      "description": "returns capture groups for every match",
      "args": ["(\\w+)=(\\w+)", "a=1 b=2"],
      "outcome": {
        "returns": [
          { "match": "a=1", "index": 0, "groups": ["a", "1"], "named": {} },
          { "match": "b=2", "index": 4, "groups": ["b", "2"], "named": {} }
        ]
      }
    }
  ]
}
