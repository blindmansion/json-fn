{
  "$schema": "../../builtin.schema.json",
  "builtin": "not",
  "description": "Return the logical negation of a boolean.",
  "cases": [
    { "description": "negates true", "args": [true], "outcome": { "returns": false } },
    { "description": "negates false", "args": [false], "outcome": { "returns": true } },
    {
      "description": "rejects null",
      "args": [null],
      "outcome": { "throws": { "messageIncludes": "argument must be a boolean" } }
    },
    {
      "description": "rejects a number",
      "args": [0],
      "outcome": { "throws": { "messageIncludes": "argument must be a boolean" } }
    },
    {
      "description": "rejects a string",
      "args": [""],
      "outcome": { "throws": { "messageIncludes": "argument must be a boolean" } }
    }
  ]
}
