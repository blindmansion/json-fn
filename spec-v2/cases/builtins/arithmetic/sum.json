{
  "$schema": "../../builtin.schema.json",
  "builtin": "sum",
  "description": "Sum an array of numbers.",
  "cases": [
    {
      "description": "adds integer elements",
      "args": [[1, 2, 3, 4]],
      "outcome": { "returns": 10 }
    },
    {
      "description": "adds decimal and negative elements",
      "args": [[1.5, -2, 3.25]],
      "outcome": { "returns": 2.75 }
    },
    {
      "description": "returns zero for an empty array",
      "args": [[]],
      "outcome": { "returns": 0 }
    },
    {
      "description": "rejects a non-array argument",
      "args": [42],
      "outcome": { "throws": { "messageIncludes": "argument must be an array" } }
    },
    {
      "description": "rejects a non-number element",
      "args": [[1, "2", 3]],
      "outcome": { "throws": { "messageIncludes": "array elements must be numbers" } }
    },
    {
      "description": "rejects a non-finite result",
      "args": [[1e308, 1e308]],
      "outcome": { "throws": { "messageIncludes": "result must be a finite number" } }
    }
  ]
}
