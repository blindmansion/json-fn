{
  "$schema": "../../builtin.schema.json",
  "builtin": "argmin",
  "description": "Return the index of the first smallest number.",
  "cases": [
    {
      "description": "returns the first smallest index",
      "args": [[3, -2, 4, -2]],
      "outcome": { "returns": 1 }
    },
    {
      "description": "supports decimal and negative values",
      "args": [[-1.5, -3.25, 0]],
      "outcome": { "returns": 1 }
    },
    {
      "description": "returns null for an empty array",
      "args": [[]],
      "outcome": { "returns": null }
    },
    {
      "description": "rejects a non-array argument",
      "args": [42],
      "outcome": { "throws": { "messageIncludes": "argument must be an array" } }
    }
  ]
}
