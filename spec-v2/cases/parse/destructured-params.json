{
  "$schema": "../parse.schema.json",
  "description": "destructured (object-pattern) parameters — $fields (plans/destructured-params.md)",
  "cases": [
    {
      "description": "single field pattern",
      "source": "({ x }) => x",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
          "$in": { "$var": "x" }
        }
      }
    },
    {
      "description": "two field pattern",
      "source": "({ from, to }) => sub(to, from)",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": {
            "from": { "$get": "from", "$from": { "$var": "__p0" } },
            "to": { "$get": "to", "$from": { "$var": "__p0" } }
          },
          "$in": { "$call": "sub", "$args": [{ "$var": "to" }, { "$var": "from" }] }
        }
      }
    },
    {
      "description": "optional and defaulted fields",
      "source": "({ required, label?, count = 0 }) => count",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": {
            "required": { "$get": "required", "$from": { "$var": "__p0" } },
            "label": { "$get": "label", "$from": { "$var": "__p0" }, "$else": null },
            "count": { "$get": "count", "$from": { "$var": "__p0" }, "$else": 0 }
          },
          "$in": { "$var": "count" }
        }
      }
    },
    {
      "description": "positional param followed by a pattern slot",
      "source": "(label, { x, y }) => x + y",
      "expected": {
        "$params": ["label", "__p1"],
        "$return": {
          "$let": {
            "x": { "$get": "x", "$from": { "$var": "__p1" } },
            "y": { "$get": "y", "$from": { "$var": "__p1" } }
          },
          "$in": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] }
        }
      }
    },
    {
      "description": "pattern slot followed by a rest parameter",
      "source": "({ x }, ...rest) => rest",
      "expected": {
        "$params": ["__p0", "...rest"],
        "$return": {
          "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
          "$in": { "$var": "rest" }
        }
      }
    },
    {
      "description": "multiple pattern slots",
      "source": "({ a }, { b }) => a + b",
      "expected": {
        "$params": ["__p0", "__p1"],
        "$return": {
          "$let": {
            "a": { "$get": "a", "$from": { "$var": "__p0" } },
            "b": { "$get": "b", "$from": { "$var": "__p1" } }
          },
          "$in": { "$call": "add", "$args": [{ "$var": "a" }, { "$var": "b" }] }
        }
      }
    },
    {
      "description": "trailing comma inside a pattern normalizes away",
      "source": "({ x, y, }) => x",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": {
            "x": { "$get": "x", "$from": { "$var": "__p0" } },
            "y": { "$get": "y", "$from": { "$var": "__p0" } }
          },
          "$in": { "$var": "x" }
        }
      }
    },
    {
      "description": "pattern with a trailing where clause",
      "source": "({ n }) => doubled where {\n  doubled: n * 2\n}",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "n": { "$get": "n", "$from": { "$var": "__p0" } } },
          "$in": {
            "$let": { "doubled": { "$call": "mul", "$args": [{ "$var": "n" }, 2] } },
            "$in": { "$var": "doubled" }
          }
        }
      }
    },
    { "description": "empty pattern is rejected", "source": "({}) => 1", "error": true },
    {
      "description": "field rename is not supported",
      "source": "({ from: f }) => f",
      "error": true
    },
    {
      "description": "nested pattern is not supported",
      "source": "({ a: { b } }) => b",
      "error": true
    },
    { "description": "rest pattern is not supported", "source": "(...{ x }) => x", "error": true },
    { "description": "non-identifier field is rejected", "source": "({ 1 }) => 1", "error": true }
  ]
}
