{
  "$schema": "../parse.schema.json",
  "description": "destructured (object-pattern) parameters: shorthand sugar lowering to a plain __p<i> slot plus body-top strict-read projections",
  "cases": [
    {
      "description": "single field pattern",
      "source": "({ x }) => x",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
          "$in": { "$var": "x" }
        }
      }
    },
    {
      "description": "two field pattern",
      "source": "({ from, to }) => sub(to, from)",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": {
            "from": { "$get": "from", "$from": { "$var": "__p0" } },
            "to": { "$get": "to", "$from": { "$var": "__p0" } }
          },
          "$in": { "$call": "sub", "$args": [{ "$var": "to" }, { "$var": "from" }] }
        }
      }
    },
    {
      "description": "optional and defaulted fields",
      "source": "({ required, label?, count = 0 }) => count",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": {
            "required": { "$get": "required", "$from": { "$var": "__p0" } },
            "label": { "$get": "label", "$from": { "$var": "__p0" }, "$else": null },
            "count": { "$get": "count", "$from": { "$var": "__p0" }, "$else": 0 }
          },
          "$in": { "$var": "count" }
        }
      }
    },
    {
      "description": "positional param followed by a pattern slot",
      "source": "(label, { x, y }) => x + y",
      "expected": {
        "$params": ["label", "__p1"],
        "$return": {
          "$let": {
            "x": { "$get": "x", "$from": { "$var": "__p1" } },
            "y": { "$get": "y", "$from": { "$var": "__p1" } }
          },
          "$in": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] }
        }
      }
    },
    {
      "description": "pattern slot followed by a rest parameter",
      "source": "({ x }, ...rest) => rest",
      "expected": {
        "$params": ["__p0", "...rest"],
        "$return": {
          "$let": { "x": { "$get": "x", "$from": { "$var": "__p0" } } },
          "$in": { "$var": "rest" }
        }
      }
    },
    {
      "description": "multiple pattern slots",
      "source": "({ a }, { b }) => a + b",
      "expected": {
        "$params": ["__p0", "__p1"],
        "$return": {
          "$let": {
            "a": { "$get": "a", "$from": { "$var": "__p0" } },
            "b": { "$get": "b", "$from": { "$var": "__p1" } }
          },
          "$in": { "$call": "add", "$args": [{ "$var": "a" }, { "$var": "b" }] }
        }
      }
    },
    {
      "description": "trailing comma inside a pattern normalizes away",
      "source": "({ x, y, }) => x",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": {
            "x": { "$get": "x", "$from": { "$var": "__p0" } },
            "y": { "$get": "y", "$from": { "$var": "__p0" } }
          },
          "$in": { "$var": "x" }
        }
      }
    },
    {
      "description": "pattern with a trailing where clause",
      "source": "({ n }) => doubled where {\n  doubled: n * 2\n}",
      "expected": {
        "$params": ["__p0"],
        "$return": {
          "$let": { "n": { "$get": "n", "$from": { "$var": "__p0" } } },
          "$in": {
            "$let": { "doubled": { "$call": "mul", "$args": [{ "$var": "n" }, 2] } },
            "$in": { "$var": "doubled" }
          }
        }
      }
    },
    {
      "description": "annotated pattern slot carries the annotation as the slot's type",
      "comment": "The printer folds this canonical form back to the pattern: the slot's $type prints as the pattern's annotation, and bare, $else: null, and $else: e projections print as f, f?, and f = e.",
      "source": "({ from, via?, weight = 1 }: Leg) -> integer => weight",
      "expected": {
        "$params": [{ "$param": "__p0", "$type": { "$ref": "#/$defs/Leg" } }],
        "$returns": { "type": "integer" },
        "$return": {
          "$let": {
            "from": { "$get": "from", "$from": { "$var": "__p0" } },
            "via": { "$get": "via", "$from": { "$var": "__p0" }, "$else": null },
            "weight": { "$get": "weight", "$from": { "$var": "__p0" }, "$else": 1 }
          },
          "$in": { "$var": "weight" }
        }
      }
    },
    { "description": "empty pattern is rejected", "source": "({}) => 1", "error": true },
    {
      "description": "field rename is not supported",
      "source": "({ from: f }) => f",
      "error": true
    },
    {
      "description": "nested pattern is not supported",
      "source": "({ a: { b } }) => b",
      "error": true
    },
    { "description": "rest pattern is not supported", "source": "(...{ x }) => x", "error": true },
    { "description": "non-identifier field is rejected", "source": "({ 1 }) => 1", "error": true },
    {
      "description": "a pattern field duplicating a positional parameter is rejected",
      "comment": "Uniqueness of the names bound by one parameter list — positional parameters, pattern fields, and the rest parameter — is a parse rule; the lowering never has to give the collision a meaning.",
      "source": "({ x }, x) => x",
      "error": true
    },
    {
      "description": "a field name duplicated across two patterns is rejected",
      "source": "({ x }, { x }) => x",
      "error": true
    },
    {
      "description": "a pattern field duplicating the rest parameter is rejected",
      "source": "({ xs }, ...xs) => xs",
      "error": true
    },
    {
      "description": "a field cannot combine ? and =",
      "source": "({ x? = 1 }) => x",
      "error": true
    },
    {
      "description": "a whole pattern cannot be optional",
      "source": "({ x }?) => x",
      "error": true
    },
    {
      "description": "a whole pattern cannot take a default",
      "source": "({ x } = 1) => x",
      "error": true
    },
    {
      "description": "the reserved __p<digits> scheme is not a valid binder",
      "comment": "The reservation is what makes fold-back unambiguous: a __p<i> slot in canonical JSON is lowering output or indistinguishable from it, because the shorthand surface can never author the name.",
      "source": "(__p0) => 1",
      "error": true
    },
    {
      "description": "the reserved __p<digits> scheme is not a valid reference",
      "source": "(x) => __p1",
      "error": true
    },
    {
      "description": "the reserved __p<digits> scheme is not a valid where-binding name",
      "source": "x where { __p2: 1 }",
      "error": true
    }
  ]
}
