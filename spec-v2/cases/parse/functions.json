{
  "$schema": "../parse.schema.json",
  "description": "function literals and local bindings (shorthand spec section 8)",
  "cases": [
    {
      "description": "simple function literal",
      "source": "(a, b) => add(a, b)",
      "expected": {
        "$params": ["a", "b"],
        "$return": { "$call": "add", "$args": [{ "$var": "a" }, { "$var": "b" }] }
      }
    },
    {
      "description": "where bindings",
      "source": "(x, y) => doubled where {\n  sum:     add(x, y),\n  doubled: mul(sum, 2)\n}",
      "expected": {
        "$params": ["x", "y"],
        "$return": {
          "$let": {
            "sum": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] },
            "doubled": { "$call": "mul", "$args": [{ "$var": "sum" }, 2] }
          },
          "$in": { "$var": "doubled" }
        }
      }
    },
    {
      "description": "brace after arrow is a data object",
      "source": "(state) => { output: boardSection(state, \"\"), exitCode: 0 }",
      "expected": {
        "$params": ["state"],
        "$return": {
          "output": { "$call": "boardSection", "$args": [{ "$var": "state" }, ""] },
          "exitCode": 0
        }
      }
    },
    { "description": "no params", "source": "() => 1", "expected": { "$return": 1 } },
    {
      "description": "rest params",
      "source": "(first, ...rest) => rest",
      "expected": { "$params": ["first", "...rest"], "$return": { "$var": "rest" } }
    },
    {
      "description": "optional and defaulted params",
      "source": "(name, title?, punctuation = \"!\") => punctuation",
      "expected": {
        "$params": [
          "name",
          { "$param": "title", "$optional": true },
          { "$param": "punctuation", "$default": "!" }
        ],
        "$return": { "$var": "punctuation" }
      }
    },
    {
      "description": "typed optional and defaulted params",
      "source": "(name: string, title?: string, punctuation: string = \"!\") -> string => punctuation",
      "expected": {
        "$params": [
          { "$param": "name", "$type": { "type": "string" } },
          { "$param": "title", "$optional": true, "$type": { "type": "string" } },
          { "$param": "punctuation", "$default": "!", "$type": { "type": "string" } }
        ],
        "$returns": { "type": "string" },
        "$return": { "$var": "punctuation" }
      }
    },
    {
      "description": "optional function-type slot",
      "source": "(callback: (string, integer?) -> boolean) -> boolean => callback(\"x\")",
      "expected": {
        "$params": [
          {
            "$param": "callback",
            "$type": {
              "$fnType": {
                "required": [{ "type": "string" }],
                "optional": [{ "type": "integer" }],
                "returns": { "type": "boolean" }
              }
            }
          }
        ],
        "$returns": { "type": "boolean" },
        "$return": { "$call": "callback", "$args": ["x"] }
      }
    },
    {
      "description": "typed lambda with a return annotation",
      "source": "(x: number) -> number => x",
      "expected": {
        "$params": [{ "$param": "x", "$type": { "type": "number" } }],
        "$returns": { "type": "number" },
        "$return": { "$var": "x" }
      }
    },
    {
      "description": "typed lambda with a curried function-type return annotation",
      "source": "(x: number) -> (number) -> number => (y) => x",
      "expected": {
        "$params": [{ "$param": "x", "$type": { "type": "number" } }],
        "$returns": {
          "$fnType": {
            "required": [{ "type": "number" }],
            "optional": [],
            "returns": { "type": "number" }
          }
        },
        "$return": { "$params": ["y"], "$return": { "$var": "x" } }
      }
    },
    {
      "description": "missing typed-lambda return type reports the annotation position",
      "source": "(x: number) -> => x",
      "error": { "messageIncludes": "expected a type", "at": { "line": 1, "column": 16 } }
    },
    {
      "description": "invalid star typed-lambda return type reports the annotation position",
      "source": "(x: number) -> * => x",
      "error": { "messageIncludes": "expected a type", "at": { "line": 1, "column": 16 } }
    },
    {
      "description": "invalid union typed-lambda return type reports the annotation position",
      "source": "(x: number) -> | => x",
      "error": { "messageIncludes": "expected a type", "at": { "line": 1, "column": 16 } }
    },
    {
      "description": "bare Task return annotation lowers to an erased task type",
      "source": "() -> Task => pure(null)",
      "expected": {
        "$returns": { "$taskType": true },
        "$return": { "$call": "pure", "$args": [null] }
      }
    },
    {
      "description": "indexed Task return annotation preserves its completion type",
      "source": "() -> Task<string | null> => pure(null)",
      "expected": {
        "$returns": { "$taskType": { "type": ["string", "null"] } },
        "$return": { "$call": "pure", "$args": [null] }
      }
    },
    {
      "description": "general user-facing type application is rejected",
      "source": "(x: Box<string>) => x",
      "error": "only the built-in Task<A> type constructor accepts a type argument"
    },
    {
      "description": "required param after optional is rejected",
      "source": "(first?, second) => second",
      "error": true
    },
    {
      "description": "required function-type slot after optional is rejected",
      "source": "(callback: (string?, integer) -> boolean) -> boolean => true",
      "error": true
    },
    {
      "description": "nested closure",
      "source": "(x) => (y) => x + y",
      "expected": {
        "$params": ["x"],
        "$return": {
          "$params": ["y"],
          "$return": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] }
        }
      }
    },
    {
      "description": "partially annotated parameter list is accepted",
      "comment": "Annotations may be present on some slots and absent on others; a partially annotated body also prints partially, so the printer never has to invent or drop an annotation.",
      "source": "(x: integer, y) => x + y",
      "expected": {
        "$params": [{ "$param": "x", "$type": { "type": "integer" } }, "y"],
        "$return": { "$call": "add", "$args": [{ "$var": "x" }, { "$var": "y" }] }
      }
    },
    {
      "description": "return annotation without parameter annotations is accepted",
      "source": "(x) -> integer => x",
      "expected": {
        "$params": ["x"],
        "$returns": { "type": "integer" },
        "$return": { "$var": "x" }
      }
    },
    {
      "description": "combining ? and = on one parameter is rejected",
      "source": "(value? = 1) => value",
      "error": true
    },
    {
      "description": "a printed function value's record rendering parses as ordinary local bindings",
      "comment": "The rendering is audit output for values: parsing it yields a body-top eager $let of literal values — semantically faithful, since the record is a flat group of evaluated bindings callable by name — but not the canonical value shape, which carries $captures. The round-trip law parse(print(node)) = normalize(node) is scoped to programs, and programs never contain records.",
      "source": "(x) => if x <= 0 then base else go(x - 1) where {\n  base: 42,\n  go: (x) => if x <= 0 then base else go(x - 1)\n}",
      "expected": {
        "$params": ["x"],
        "$return": {
          "$let": {
            "base": 42,
            "go": {
              "$params": ["x"],
              "$return": {
                "$if": { "$call": "lte", "$args": [{ "$var": "x" }, 0] },
                "$then": { "$var": "base" },
                "$else": {
                  "$call": "go",
                  "$args": [{ "$call": "sub", "$args": [{ "$var": "x" }, 1] }]
                }
              }
            }
          },
          "$in": {
            "$if": { "$call": "lte", "$args": [{ "$var": "x" }, 0] },
            "$then": { "$var": "base" },
            "$else": { "$call": "go", "$args": [{ "$call": "sub", "$args": [{ "$var": "x" }, 1] }] }
          }
        }
      }
    },
    {
      "description": "an expression-shaped record entry renders under raw quoting and parses back as quoted data",
      "comment": "A captured value whose keys look like code prints under inferred-$raw quoting, so a record rendering never reads as code.",
      "source": "() => x where { x: { \"$var\": \"state\" } }",
      "expected": {
        "$return": { "$let": { "x": { "$raw": { "$var": "state" } } }, "$in": { "$var": "x" } }
      }
    }
  ]
}
