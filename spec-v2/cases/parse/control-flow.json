{
  "$schema": "../parse.schema.json",
  "description": "control flow (shorthand spec section 7)",
  "cases": [
    {
      "description": "if / then / else",
      "source": "if x > 0 then \"positive\" else \"non-positive\"",
      "expected": {
        "$if": { "$call": "gt", "$args": [{ "$var": "x" }, 0] },
        "$then": "positive",
        "$else": "non-positive"
      }
    },
    {
      "description": "cond form",
      "source": "cond {\n  n < 0:  \"negative\",\n  n == 0: \"zero\",\n  else:   \"positive\"\n}",
      "expected": {
        "$cond": [
          [{ "$call": "lt", "$args": [{ "$var": "n" }, 0] }, "negative"],
          [{ "$call": "eq", "$args": [{ "$var": "n" }, 0] }, "zero"]
        ],
        "$else": "positive"
      }
    },
    {
      "description": "nested object expressions remain distinct from colon arm separators",
      "source": "cond {\n  state == { ready: true }: { result: { ok: true } },\n  else: { result: { ok: false } }\n}",
      "expected": {
        "$cond": [
          [
            { "$call": "eq", "$args": [{ "$var": "state" }, { "ready": true }] },
            { "result": { "ok": true } }
          ]
        ],
        "$else": { "result": { "ok": false } }
      }
    },
    {
      "description": "a parenthesized cond guard is not parsed as a typed lambda",
      "source": "cond { (a > b): a, else: b }",
      "expected": {
        "$cond": [
          [{ "$call": "gt", "$args": [{ "$var": "a" }, { "$var": "b" }] }, { "$var": "a" }]
        ],
        "$else": { "$var": "b" }
      }
    },
    {
      "description": "match form",
      "source": "match cmd {\n  \"show\":  showResult(state),\n  \"reset\": resetResult(),\n  else:     moveResult(state, argv)\n}",
      "expected": {
        "$match": { "$var": "cmd" },
        "$cases": [
          ["show", { "$call": "showResult", "$args": [{ "$var": "state" }] }],
          ["reset", { "$call": "resetResult", "$args": [] }]
        ],
        "$else": { "$call": "moveResult", "$args": [{ "$var": "state" }, { "$var": "argv" }] }
      }
    },
    {
      "description": "old cond arrow arms are rejected",
      "source": "cond { true -> 1 }",
      "error": true
    },
    {
      "description": "old match arrow arms are rejected",
      "source": "match value { 1 -> \"one\", else -> \"other\" }",
      "error": true
    }
  ]
}
