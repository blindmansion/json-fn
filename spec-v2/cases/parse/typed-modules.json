{
  "$schema": "../parse.schema.json",
  "description": "typed modules (type syntax spec section 8)",
  "mode": "module",
  "cases": [
    {
      "description": "named types and typed function bindings",
      "source": "type N = integer\ntype Box = { value: N }\nid: (x: N) -> N => x\nunbox: ({ value }: Box) -> N => value",
      "expected": {
        "$types": {
          "N": { "type": "integer" },
          "Box": {
            "type": "object",
            "properties": { "value": { "$ref": "#/$defs/N" } },
            "required": ["value"],
            "additionalProperties": false
          }
        },
        "id": {
          "$params": [{ "$param": "x", "$type": { "$ref": "#/$defs/N" } }],
          "$returns": { "$ref": "#/$defs/N" },
          "$return": { "$var": "x" }
        },
        "unbox": {
          "$params": [{ "$param": "__p0", "$type": { "$ref": "#/$defs/Box" } }],
          "$returns": { "$ref": "#/$defs/N" },
          "$return": {
            "$let": { "value": { "$get": "value", "$from": { "$var": "__p0" } } },
            "$in": { "$var": "value" }
          }
        }
      }
    },
    {
      "description": "Task is reserved and cannot be declared as a module type name",
      "source": "type Task = integer\nmain: (x: Task) -> Task => x",
      "error": "'Task' is reserved for the built-in Task<A> type constructor"
    }
  ]
}
