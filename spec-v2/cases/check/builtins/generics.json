{
  "$schema": "../../check.schema.json",
  "description": "standard builtins: generic collections",
  "builtins": "standard",
  "cases": [
    {
      "description": "head of a nonempty tuple widens its elements without null",
      "expression": { "$call": "head", "$args": [[1, 2, 3]] },
      "expected": { "type": { "type": "integer" }, "diagnostics": [] }
    },
    {
      "description": "head of an empty tuple simplifies to null",
      "expression": { "$call": "head", "$args": [[]] },
      "expected": { "type": { "type": "null" }, "diagnostics": [] }
    },
    {
      "description": "head and last drop null for declared nonempty arrays",
      "module": {
        "head": {
          "$params": ["xs"],
          "$sig": {
            "required": [{ "type": "array", "items": { "type": "integer" }, "minItems": 1 }],
            "optional": [],
            "returns": { "type": "integer" }
          },
          "$return": { "$call": "head", "$args": [{ "$var": "xs" }] }
        },
        "last": {
          "$params": ["xs"],
          "$sig": {
            "required": [{ "type": "array", "items": { "type": "integer" }, "minItems": 1 }],
            "optional": [],
            "returns": { "type": "integer" }
          },
          "$return": { "$call": "last", "$args": [{ "$var": "xs" }] }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "head of a possibly empty array retains null",
      "module": {
        "f": {
          "$params": ["xs"],
          "$sig": {
            "required": [{ "type": "array", "items": { "type": "integer" } }],
            "optional": [],
            "returns": { "type": "integer" }
          },
          "$return": { "$call": "head", "$args": [{ "$var": "xs" }] }
        }
      },
      "expected": {
        "diagnostics": [
          { "path": ["f", "$return"], "severity": "error", "messageIncludes": "not assignable" }
        ]
      }
    },
    {
      "description": "concat preserves element type",
      "expression": {
        "$call": "concat",
        "$args": [
          [1, 2],
          [3, 4]
        ]
      },
      "expected": { "type": { "type": "array", "items": { "type": "integer" } }, "diagnostics": [] }
    },
    {
      "description": "setAt preserves element type",
      "expression": { "$call": "setAt", "$args": [[1, 2, 3], 0, 9] },
      "expected": { "type": { "type": "array", "items": { "type": "integer" } }, "diagnostics": [] }
    },
    {
      "description": "tail and reverse preserve element type",
      "expression": {
        "$call": "concat",
        "$args": [
          { "$call": "tail", "$args": [[1, 2, 3]] },
          { "$call": "reverse", "$args": [[4, 5]] }
        ]
      },
      "expected": { "type": { "type": "array", "items": { "type": "integer" } }, "diagnostics": [] }
    },
    {
      "description": "flatten unwraps one array level",
      "expression": {
        "$call": "flatten",
        "$args": [
          {
            "$call": "map",
            "$args": [
              { "$params": ["n"], "$return": { "$call": "range", "$args": [{ "$var": "n" }] } },
              [1, 2, 3]
            ]
          }
        ]
      },
      "expected": { "type": { "type": "array", "items": { "type": "integer" } }, "diagnostics": [] }
    },
    {
      "description": "chunk preserves element type",
      "expression": { "$call": "chunk", "$args": [[1, 2, 3], 2] },
      "expected": {
        "type": { "type": "array", "items": { "type": "array", "items": { "type": "integer" } } },
        "diagnostics": []
      }
    },
    {
      "description": "frequencies returns integer counts",
      "expression": { "$call": "frequencies", "$args": [[1, "1", true, null]] },
      "expected": {
        "type": { "type": "object", "additionalProperties": { "type": "integer" } },
        "diagnostics": []
      }
    },
    {
      "description": "array slice preserves element type",
      "expression": { "$call": "slice", "$args": [[1, 2, 3], 1, 2] },
      "expected": { "type": { "type": "array", "items": { "type": "integer" } }, "diagnostics": [] }
    },
    {
      "description": "string slice returns string",
      "expression": { "$call": "slice", "$args": ["hello", 1, 3] },
      "expected": { "type": { "type": "string" }, "diagnostics": [] }
    },
    {
      "description": "take and drop preserve element type",
      "expression": {
        "$call": "concat",
        "$args": [
          { "$call": "take", "$args": [[1, 2, 3], 2] },
          { "$call": "drop", "$args": [[1, 2, 3], 2] }
        ]
      },
      "expected": { "type": { "type": "array", "items": { "type": "integer" } }, "diagnostics": [] }
    },
    {
      "description": "take requires an integer count",
      "expression": { "$call": "take", "$args": [[1, 2, 3], 1.5] },
      "expected": {
        "type": { "type": "array", "items": { "type": "integer" } },
        "diagnostics": [
          { "path": ["$args[1]"], "severity": "error", "messageIncludes": "not assignable" }
        ]
      }
    },
    {
      "description": "zip preserves both element types in pair tuples",
      "expression": {
        "$call": "zip",
        "$args": [
          [1, 2],
          ["a", "b"]
        ]
      },
      "expected": {
        "type": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "integer" }, { "type": "string" }],
            "items": false,
            "minItems": 2
          }
        },
        "diagnostics": []
      }
    },
    {
      "description": "zip rejects a non-array second argument",
      "expression": { "$call": "zip", "$args": [[1, 2], "ab"] },
      "expected": {
        "type": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "integer" }, true],
            "items": false,
            "minItems": 2
          }
        },
        "diagnostics": [
          { "path": ["$args[1]"], "severity": "error", "messageIncludes": "not assignable" }
        ]
      }
    },
    {
      "description": "unique preserves element type",
      "expression": { "$call": "unique", "$args": [[1, 2, 1]] },
      "expected": { "type": { "type": "array", "items": { "type": "integer" } }, "diagnostics": [] }
    },
    {
      "description": "array repeat preserves element type",
      "expression": { "$call": "repeat", "$args": [[1, 2], 2] },
      "expected": { "type": { "type": "array", "items": { "type": "integer" } }, "diagnostics": [] }
    },
    {
      "description": "string repeat selects its overload",
      "expression": { "$call": "repeat", "$args": ["ab", 2] },
      "expected": { "type": { "type": "string" }, "diagnostics": [] }
    },
    {
      "description": "includes selects array and string overloads",
      "expression": {
        "$call": "and",
        "$args": [
          { "$call": "includes", "$args": [[1, 2, 3], 2] },
          { "$call": "includes", "$args": ["hi", "h"] }
        ]
      },
      "expected": { "type": { "type": "boolean" }, "diagnostics": [] }
    }
  ]
}
