{
  "$schema": "../../check.schema.json",
  "description": "branch-arm checking, control-flow unions, and predicate narrowing through branches",
  "builtins": "none",
  "cases": [
    {
      "description": "$if: arms that both fit the expected type check clean",
      "module": {
        "f": {
          "$params": [],
          "$returns": { "type": "integer" },
          "$return": { "$if": true, "$then": 1, "$else": 2 }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "$if: a mismatching arm is pinpointed to that arm, not the whole $return",
      "module": {
        "f": {
          "$params": [],
          "$returns": { "type": "integer" },
          "$return": { "$if": true, "$then": 1, "$else": "x" }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return", "$else"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" },
            "actual": { "const": "x" }
          }
        ]
      }
    },
    {
      "description": "$if: arms recurse into composite literals (no literal-union widening)",
      "module": {
        "f": {
          "$params": [],
          "$returns": {
            "type": "object",
            "properties": { "a": { "type": "integer" } },
            "required": ["a"],
            "additionalProperties": false
          },
          "$return": { "$if": true, "$then": { "a": 1 }, "$else": { "a": "x" } }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return", "$else", "a"],
            "severity": "error",
            "messageIncludes": "not assignable"
          }
        ]
      }
    },
    {
      "description": "$if: narrowing from the condition threads into the checked arm",
      "builtins": "standard",
      "module": {
        "f": {
          "$params": [
            { "$param": "x", "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$if": { "$call": "neq", "$args": [{ "$var": "x" }, null] },
            "$then": { "$var": "x" },
            "$else": ""
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "$if: isInteger permits an integer-only call from number | string",
      "builtins": "standard",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "value",
              "$type": { "anyOf": [{ "type": "number" }, { "type": "string" }] }
            }
          ],
          "$returns": { "type": "array", "items": { "type": "integer" } },
          "$return": {
            "$if": { "$call": "isInteger", "$args": [{ "$var": "value" }] },
            "$then": { "$call": "range", "$args": [{ "$var": "value" }] },
            "$else": []
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "$if: short-circuit tails inherit equality null guards",
      "builtins": "standard",
      "module": {
        "viaAnd": {
          "$params": [
            { "$param": "value", "$type": { "anyOf": [{ "type": "integer" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "integer" },
          "$return": {
            "$if": {
              "$and": [
                { "$call": "neq", "$args": [{ "$var": "value" }, null] },
                { "$call": "gt", "$args": [{ "$var": "value" }, 0] }
              ]
            },
            "$then": { "$var": "value" },
            "$else": 0
          }
        },
        "viaOr": {
          "$params": [
            { "$param": "value", "$type": { "anyOf": [{ "type": "integer" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "integer" },
          "$return": {
            "$if": {
              "$or": [
                { "$call": "eq", "$args": [{ "$var": "value" }, null] },
                { "$call": "gt", "$args": [{ "$var": "value" }, 0] }
              ]
            },
            "$then": 1,
            "$else": 0
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "$if: isInteger false leaves a bare number neither string nor integer",
      "builtins": "standard",
      "module": {
        "asString": {
          "$params": [{ "$param": "value", "$type": { "type": "number" } }],
          "$returns": { "type": "string" },
          "$return": {
            "$if": { "$call": "isInteger", "$args": [{ "$var": "value" }] },
            "$then": "",
            "$else": { "$call": "upper", "$args": [{ "$var": "value" }] }
          }
        },
        "asInteger": {
          "$params": [{ "$param": "value", "$type": { "type": "number" } }],
          "$returns": { "type": "array", "items": { "type": "integer" } },
          "$return": {
            "$if": { "$call": "isInteger", "$args": [{ "$var": "value" }] },
            "$then": [],
            "$else": { "$call": "range", "$args": [{ "$var": "value" }] }
          }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["asString", "$return", "$else", "$args[0]"],
            "severity": "error",
            "messageIncludes": "not assignable"
          },
          {
            "path": ["asInteger", "$return", "$else", "$args[0]"],
            "severity": "error",
            "messageIncludes": "not assignable"
          }
        ]
      }
    },
    {
      "description": "$if: isInteger partitions integral and fractional enum members for calls",
      "builtins": "standard",
      "module": {
        "fractionalOnly": {
          "$params": [{ "$param": "value", "$type": { "const": 1.5 } }],
          "$returns": { "type": "array", "items": { "type": "integer" } },
          "$return": []
        },
        "f": {
          "$params": [{ "$param": "value", "$type": { "enum": [1, 1.5] } }],
          "$returns": { "type": "array", "items": { "type": "integer" } },
          "$return": {
            "$if": { "$call": "isInteger", "$args": [{ "$var": "value" }] },
            "$then": { "$call": "range", "$args": [{ "$var": "value" }] },
            "$else": { "$call": "fractionalOnly", "$args": [{ "$var": "value" }] }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "$if: a shadowed isInteger does not authorize an integer-only call",
      "builtins": "standard",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "value",
              "$type": { "anyOf": [{ "type": "number" }, { "type": "string" }] }
            },
            {
              "$param": "isInteger",
              "$type": {
                "$fnType": { "required": [true], "optional": [], "returns": { "type": "boolean" } }
              }
            }
          ],
          "$returns": { "type": "array", "items": { "type": "integer" } },
          "$return": {
            "$if": { "$call": "isInteger", "$args": [{ "$var": "value" }] },
            "$then": { "$call": "range", "$args": [{ "$var": "value" }] },
            "$else": []
          }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return", "$then", "$args[0]"],
            "severity": "error",
            "messageIncludes": "not assignable"
          }
        ]
      }
    },
    {
      "description": "$cond: a mismatching arm is pinpointed to that arm",
      "module": {
        "f": {
          "$params": [],
          "$returns": { "type": "integer" },
          "$return": {
            "$cond": [
              [true, 1],
              [false, "x"]
            ],
            "$else": 3
          }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return", "$cond[1][1]"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" }
          }
        ]
      }
    },
    {
      "description": "$cond: a cond over literal results fits a string return",
      "module": {
        "label": {
          "$params": [{ "$param": "flag", "$type": { "type": "boolean" } }],
          "$returns": { "type": "string" },
          "$return": { "$cond": [[{ "$var": "flag" }, "a"]], "$else": "b" }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "$cond: a negated guard narrows the else arm",
      "comment": "End-to-end version of the local direct-synth control-flow-union unit tests.",
      "builtins": "standard",
      "module": {
        "f": {
          "$params": [
            { "$param": "x", "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$cond": [[{ "$call": "isNull", "$args": [{ "$var": "x" }] }, "d"]],
            "$else": { "$var": "x" }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "$match: a mismatching case arm is pinpointed to that arm",
      "module": {
        "f": {
          "$params": [{ "$param": "p", "$type": { "enum": ["a", "b"] } }],
          "$returns": { "type": "integer" },
          "$return": {
            "$match": { "$var": "p" },
            "$cases": [
              ["a", 1],
              ["b", "x"]
            ]
          }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return", "$cases[1][1]"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" }
          }
        ]
      }
    },
    {
      "description": "$match: exhaustiveness lint still fires in checked position",
      "module": {
        "f": {
          "$params": [{ "$param": "p", "$type": { "enum": ["a", "b"] } }],
          "$returns": { "type": "integer" },
          "$return": { "$match": { "$var": "p" }, "$cases": [["a", 1]] }
        }
      },
      "expected": {
        "diagnostics": [
          { "path": ["f", "$return"], "severity": "error", "messageIncludes": "Non-exhaustive" }
        ]
      }
    },
    {
      "description": "$if widens literal branch results before joining them",
      "comment": "End-to-end version of the local direct-synth control-flow-union unit tests.",
      "expression": { "$if": true, "$then": 1, "$else": "x" },
      "expected": {
        "type": { "anyOf": [{ "type": "integer" }, { "type": "string" }] },
        "diagnostics": []
      }
    },
    {
      "description": "$if joins same-primitive literal arms to the widened primitive",
      "comment": "End-to-end version of the local direct-synth control-flow-union unit tests.",
      "expression": { "$if": true, "$then": 10, "$else": 20 },
      "expected": { "type": { "type": "integer" }, "diagnostics": [] }
    },
    {
      "description": "$and: non-boolean operands are static errors at each operand",
      "comment": "Every $and/$or operand is a boolean position: its type must be assignable to boolean.",
      "expression": { "$and": [1, 2] },
      "expected": {
        "diagnostics": [
          {
            "path": ["$and[0]"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "boolean" },
            "actual": { "const": 1 }
          },
          {
            "path": ["$and[1]"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "boolean" },
            "actual": { "const": 2 }
          }
        ]
      }
    },
    {
      "description": "$or: a non-boolean operand is a static error at that operand",
      "expression": { "$or": [false, "x"] },
      "expected": {
        "diagnostics": [
          {
            "path": ["$or[1]"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "boolean" },
            "actual": { "const": "x" }
          }
        ]
      }
    },
    {
      "description": "$and: boolean operands synthesize a boolean result",
      "comment": "The result of $and/$or is always a boolean; literal operand types are not folded into a literal result, matching the $if posture of widening literal branch results.",
      "expression": { "$and": [true, false] },
      "expected": { "type": { "type": "boolean" }, "diagnostics": [] }
    },
    {
      "description": "$or: boolean operands synthesize a boolean result",
      "expression": { "$or": [false, true] },
      "expected": { "type": { "type": "boolean" }, "diagnostics": [] }
    },
    {
      "description": "$or: a nullable operand is a static error (|| defaulting is gone)",
      "comment": "The v1 `x || default` idiom is a static error at the condition: write `x ?? default` when the value is an access and absence is the case, or an explicit `x != null` conditional when null is.",
      "module": {
        "f": {
          "$params": [
            { "$param": "x", "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "boolean" },
          "$return": { "$or": [{ "$var": "x" }, false] }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return", "$or[0]"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "boolean" },
            "actual": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
          }
        ]
      }
    },
    {
      "description": "$and: an any-typed operand is admitted at a boolean position",
      "comment": "any is unknown evidence, not a rejection; the runtime boolean validation is the fail-closed backstop. In a checked program where no any reaches a boolean position, the runtime error is unreachable.",
      "module": {
        "f": {
          "$params": [{ "$param": "x", "$type": true }],
          "$returns": { "type": "boolean" },
          "$return": { "$and": [{ "$var": "x" }, true] }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "$if: a non-boolean condition is a static error at the condition",
      "comment": "A condition's type must be assignable to boolean; there is no truthiness. Write an explicit comparison — s != \"\" — for the emptiness check this shape suggests.",
      "module": {
        "f": {
          "$params": [{ "$param": "s", "$type": { "type": "string" } }],
          "$returns": { "type": "integer" },
          "$return": { "$if": { "$var": "s" }, "$then": 1, "$else": 0 }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return", "$if"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "boolean" },
            "actual": { "type": "string" }
          }
        ]
      }
    },
    {
      "description": "$if: a nullable boolean condition is a static error",
      "comment": "Assignability at the condition is exact: boolean | null does not fit boolean. Narrow the null away first (x != null) or compare explicitly (x == true).",
      "module": {
        "f": {
          "$params": [
            { "$param": "x", "$type": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "integer" },
          "$return": { "$if": { "$var": "x" }, "$then": 1, "$else": 0 }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return", "$if"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "boolean" },
            "actual": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] }
          }
        ]
      }
    },
    {
      "description": "$cond: each arm condition is a boolean position",
      "comment": "The arm's condition slot carries the same boolean requirement as $if, reported at the condition's own path.",
      "module": {
        "f": {
          "$params": [{ "$param": "n", "$type": { "type": "integer" } }],
          "$returns": { "type": "integer" },
          "$return": { "$cond": [[{ "$var": "n" }, 1]], "$else": 0 }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return", "$cond[0][0]"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "boolean" },
            "actual": { "type": "integer" }
          }
        ]
      }
    },
    {
      "description": "$if: an any-typed condition is admitted at the boolean position",
      "comment": "The same posture as the $and operand: any is unknown evidence, and the runtime boolean validation is the fail-closed backstop.",
      "module": {
        "f": {
          "$params": [{ "$param": "x", "$type": true }],
          "$returns": { "type": "integer" },
          "$return": { "$if": { "$var": "x" }, "$then": 1, "$else": 0 }
        }
      },
      "expected": { "diagnostics": [] }
    }
  ]
}
