{
  "$schema": "../../check.schema.json",
  "description": "flow narrowing: named boolean guard bindings",
  "comment": "End-to-end forms of the named-guard fact-map rows: a bare local bound to a recognized guard expression adopts the binding's facts, aliases are followed, and a binding that yields no fact leaves the local narrowed as a boolean subject (narrowing.md form 1).",
  "builtins": "standard",
  "cases": [
    {
      "description": "a boolean guard local adopts its binding's facts",
      "module": {
        "f": {
          "$params": [
            { "$param": "target", "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$let": { "empty": { "$call": "isNull", "$args": [{ "$var": "target" }] } },
            "$in": { "$if": { "$var": "empty" }, "$then": "", "$else": { "$var": "target" } }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a named integer guard adopts its binding's facts",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "target",
              "$type": { "anyOf": [{ "type": "number" }, { "type": "string" }] }
            }
          ],
          "$returns": { "type": "integer" },
          "$return": {
            "$let": { "integral": { "$call": "isInteger", "$args": [{ "$var": "target" }] } },
            "$in": { "$if": { "$var": "integral" }, "$then": { "$var": "target" }, "$else": 0 }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "guard aliases are followed (ok: not(empty), empty: isNull(target))",
      "module": {
        "f": {
          "$params": [
            { "$param": "target", "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$let": {
              "empty": { "$call": "isNull", "$args": [{ "$var": "target" }] },
              "ok": { "$call": "not", "$args": [{ "$var": "empty" }] }
            },
            "$in": { "$if": { "$var": "ok" }, "$then": { "$var": "target" }, "$else": "" }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a guard local whose binding yields no fact narrows as a boolean subject",
      "comment": "length(xs) > 0 is a plain comparison, not a recognized guard form, so the binding contributes no fact about xs; the bare local present still narrows as a boolean subject — true in the then-branch — which is observable against the const-true return.",
      "module": {
        "f": {
          "$params": [
            { "$param": "xs", "$type": { "type": "array", "items": { "type": "integer" } } }
          ],
          "$returns": { "const": true },
          "$return": {
            "$let": {
              "present": {
                "$call": "gt",
                "$args": [{ "$call": "length", "$args": [{ "$var": "xs" }] }, 0]
              }
            },
            "$in": { "$if": { "$var": "present" }, "$then": { "$var": "present" }, "$else": true }
          }
        }
      },
      "expected": { "diagnostics": [] }
    }
  ]
}
