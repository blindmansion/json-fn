{
  "$schema": "../../check.schema.json",
  "description": "flow narrowing: boolean-subject conditions",
  "comment": "End-to-end forms of narrowing.md form 1 (boolean subject), the replacement for the deleted truthiness form: a subject used directly as a condition is necessarily boolean-typed, and the split is an exact partition — boolean pins to true in the then-branch and false in the else-branch. A field-path condition over a union base is the boolean discriminant. The narrowing is observable as a clean check that would otherwise fail.",
  "builtins": "none",
  "cases": [
    {
      "description": "boolean: the then-branch pins the condition to true",
      "module": {
        "f": {
          "$params": [{ "$param": "x", "$type": { "type": "boolean" } }],
          "$returns": { "const": true },
          "$return": { "$if": { "$var": "x" }, "$then": { "$var": "x" }, "$else": true }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "boolean: the else-branch pins the condition to false",
      "module": {
        "f": {
          "$params": [{ "$param": "x", "$type": { "type": "boolean" } }],
          "$returns": { "const": false },
          "$return": { "$if": { "$var": "x" }, "$then": false, "$else": { "$var": "x" } }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a boolean field-path condition narrows the path itself",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "u",
              "$type": {
                "type": "object",
                "properties": { "active": { "type": "boolean" } },
                "required": ["active"]
              }
            }
          ],
          "$returns": { "const": true },
          "$return": {
            "$if": { "$get": "active", "$from": { "$var": "u" } },
            "$then": { "$get": "active", "$from": { "$var": "u" } },
            "$else": true
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a boolean-discriminant path then-branch keeps the true arm of the base",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "r",
              "$type": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": { "ok": { "const": true }, "output": { "type": "string" } },
                    "required": ["ok", "output"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": { "ok": { "const": false }, "error": { "type": "string" } },
                    "required": ["ok", "error"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$if": { "$get": "ok", "$from": { "$var": "r" } },
            "$then": { "$get": "output", "$from": { "$var": "r" } },
            "$else": ""
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a boolean-discriminant path else-branch keeps the false arm of the base",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "r",
              "$type": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": { "ok": { "const": true }, "output": { "type": "string" } },
                    "required": ["ok", "output"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": { "ok": { "const": false }, "error": { "type": "string" } },
                    "required": ["ok", "error"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$if": { "$get": "ok", "$from": { "$var": "r" } },
            "$then": "",
            "$else": { "$get": "error", "$from": { "$var": "r" } }
          }
        }
      },
      "expected": { "diagnostics": [] }
    }
  ]
}
