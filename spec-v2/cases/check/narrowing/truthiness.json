{
  "$schema": "../../check.schema.json",
  "description": "flow narrowing: truthiness conditions",
  "comment": "End-to-end forms of the truthiness fact-map rows in typescript/test/check/narrowing.test.ts. Each case runs a complete module or expression through the public entry points; the narrowing is observable as a clean check that would otherwise fail, or as an exact inferred type.",
  "builtins": "none",
  "cases": [
    {
      "description": "T | null: the then-branch keeps the non-null arm",
      "module": {
        "f": {
          "$params": [
            { "$param": "x", "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "string" },
          "$return": { "$if": { "$var": "x" }, "$then": { "$var": "x" }, "$else": "" }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "T | null: the else-branch keeps null plus the falsy slice of T",
      "module": {
        "f": {
          "$params": [
            { "$param": "x", "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
          ],
          "$returns": { "anyOf": [{ "const": "" }, { "type": "null" }] },
          "$return": { "$if": { "$var": "x" }, "$then": "", "$else": { "$var": "x" } }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "number | null: the else-branch drops down to the falsy 0 and null",
      "module": {
        "f": {
          "$params": [
            { "$param": "x", "$type": { "anyOf": [{ "type": "number" }, { "type": "null" }] } }
          ],
          "$returns": { "anyOf": [{ "const": 0 }, { "type": "null" }] },
          "$return": { "$if": { "$var": "x" }, "$then": 0, "$else": { "$var": "x" } }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "boolean: the then-branch pins the condition to true",
      "module": {
        "f": {
          "$params": [{ "$param": "x", "$type": { "type": "boolean" } }],
          "$returns": { "const": true },
          "$return": { "$if": { "$var": "x" }, "$then": { "$var": "x" }, "$else": true }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "boolean: the else-branch pins the condition to false",
      "module": {
        "f": {
          "$params": [{ "$param": "x", "$type": { "type": "boolean" } }],
          "$returns": { "const": false },
          "$return": { "$if": { "$var": "x" }, "$then": false, "$else": { "$var": "x" } }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a field-path condition narrows the path itself",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "u",
              "$type": {
                "type": "object",
                "properties": { "active": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
                "required": ["active"]
              }
            }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$if": { "$get": "active", "$from": { "$var": "u" } },
            "$then": { "$get": "active", "$from": { "$var": "u" } },
            "$else": ""
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a boolean-discriminant path then-branch keeps the truthy arm of the base",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "r",
              "$type": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": { "ok": { "const": true }, "output": { "type": "string" } },
                    "required": ["ok", "output"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": { "ok": { "const": false }, "error": { "type": "string" } },
                    "required": ["ok", "error"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$if": { "$get": "ok", "$from": { "$var": "r" } },
            "$then": { "$get": "output", "$from": { "$var": "r" } },
            "$else": ""
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a boolean-discriminant path else-branch keeps the falsy arm of the base",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "r",
              "$type": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": { "ok": { "const": true }, "output": { "type": "string" } },
                    "required": ["ok", "output"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": { "ok": { "const": false }, "error": { "type": "string" } },
                    "required": ["ok", "error"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$if": { "$get": "ok", "$from": { "$var": "r" } },
            "$then": "",
            "$else": { "$get": "error", "$from": { "$var": "r" } }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "always-truthy discriminants leave the dead else-branch sound",
      "comment": "Every arm's tag is a nonempty-string const, so no arm admits a falsy discriminant: the else branch is dead and its base narrows to never, which is assignable to the integer return.",
      "module": {
        "f": {
          "$params": [
            {
              "$param": "s",
              "$type": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": { "tag": { "const": "a" }, "r": { "type": "integer" } },
                    "required": ["tag", "r"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": { "tag": { "const": "b" }, "side": { "type": "string" } },
                    "required": ["tag", "side"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          ],
          "$returns": { "type": "integer" },
          "$return": {
            "$if": { "$get": "tag", "$from": { "$var": "s" } },
            "$then": 1,
            "$else": { "$var": "s" }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "truthiness narrowing is visible in the inferred type of an expression",
      "comment": "The then-arm local is narrowed to string, so the branch union collapses to string instead of retaining the null arm.",
      "expression": {
        "$let": {
          "x": { "$as": null, "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
        },
        "$in": { "$if": { "$var": "x" }, "$then": { "$var": "x" }, "$else": "fallback" }
      },
      "expected": { "type": { "type": "string" }, "diagnostics": [] }
    }
  ]
}
