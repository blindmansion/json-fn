{
  "$schema": "../../check.schema.json",
  "description": "module checking: declarations, signatures, and recovery",
  "builtins": "none",
  "cases": [
    {
      "description": "a typed module whose body matches its signature checks clean",
      "module": { "main": { "$params": [], "$returns": { "type": "integer" }, "$return": 1 } },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a return value outside the declared return type is a hard error",
      "module": {
        "main": { "$params": [], "$returns": { "type": "integer" }, "$return": "wrong" }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["main", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" },
            "actual": { "const": "wrong" }
          }
        ]
      }
    },
    {
      "description": "a module-level function without a signature is rejected by default",
      "module": { "main": { "$params": [], "$return": 1 } },
      "expected": {
        "diagnostics": [
          {
            "path": ["main"],
            "severity": "error",
            "messageIncludes": "module-level function must declare a signature"
          }
        ]
      }
    },
    {
      "description": "nested $let function bindings also require signatures",
      "module": {
        "main": {
          "$params": [],
          "$returns": true,
          "$return": {
            "$let": { "helper": { "$params": ["x"], "$return": { "$var": "x" } } },
            "$in": { "$call": "helper", "$args": [1] }
          }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["main", "$return", "$let", "helper"],
            "severity": "error",
            "messageIncludes": "function binding \"helper\" must declare a signature (typed parameters and return)"
          },
          {
            "path": ["main", "$return", "$in"],
            "severity": "info",
            "messageIncludes": "expression degraded to `any` because the callee has no known function type."
          }
        ]
      }
    },
    {
      "description": "checking recovers and reports independent errors across functions",
      "module": {
        "f": { "$params": [], "$returns": { "type": "integer" }, "$return": true },
        "g": { "$params": [], "$returns": { "type": "string" }, "$return": 0 }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" },
            "actual": { "const": true }
          },
          {
            "path": ["g", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "string" },
            "actual": { "const": 0 }
          }
        ]
      }
    }
  ]
}
