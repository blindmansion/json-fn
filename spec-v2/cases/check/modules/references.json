{
  "$schema": "../../check.schema.json",
  "description": "module checking: dangling $ref hard errors",
  "builtins": "none",
  "cases": [
    {
      "description": "a $ref to an undeclared type in a return annotation is an error, not a silent top",
      "module": {
        "f": { "$params": [], "$returns": { "$ref": "#/$defs/Reprot" }, "$return": true }
      },
      "expected": {
        "diagnostics": [
          { "path": ["f", "$returns"], "severity": "error", "messageIncludes": "Reprot" }
        ]
      }
    },
    {
      "description": "dangling refs in required and optional slot types are both reported",
      "module": {
        "f": {
          "$params": [
            { "$param": "requiredValue", "$type": { "$ref": "#/$defs/MissingRequired" } },
            {
              "$param": "optionalValue",
              "$optional": true,
              "$type": { "$ref": "#/$defs/MissingOptional" }
            }
          ],
          "$returns": true,
          "$return": true
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["f", "$params[0]", "$type"],
            "severity": "error",
            "messageIncludes": "MissingRequired"
          },
          {
            "path": ["f", "$params[1]", "$type"],
            "severity": "error",
            "messageIncludes": "MissingOptional"
          }
        ]
      }
    },
    {
      "description": "an intentional `type X = any` alias still checks clean",
      "module": {
        "$types": { "X": true },
        "g": { "$params": [], "$returns": { "$ref": "#/$defs/X" }, "$return": 1 }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "a dangling $ref inside a $types body is reported at the def",
      "module": {
        "$types": {
          "User": {
            "type": "object",
            "properties": { "id": { "$ref": "#/$defs/Missing" } },
            "required": ["id"]
          }
        },
        "main": { "$params": [], "$returns": { "type": "integer" }, "$return": 1 }
      },
      "expected": {
        "diagnostics": [
          { "path": ["$types", "User"], "severity": "error", "messageIncludes": "Missing" }
        ]
      }
    },
    {
      "description": "refs are covered inside arrays, unions, and $fnType leaves",
      "module": {
        "f": {
          "$params": [
            { "$param": "xs", "$type": { "type": "array", "items": { "$ref": "#/$defs/Foo" } } },
            {
              "$param": "cb",
              "$type": {
                "$fnType": { "required": [], "optional": [], "returns": { "$ref": "#/$defs/Bar" } }
              }
            }
          ],
          "$returns": { "anyOf": [{ "$ref": "#/$defs/Baz" }, { "type": "null" }] },
          "$return": 1
        }
      },
      "expected": {
        "diagnostics": [
          { "path": ["f", "$params[0]", "$type"], "severity": "error", "messageIncludes": "Foo" },
          { "path": ["f", "$params[1]", "$type"], "severity": "error", "messageIncludes": "Bar" },
          { "path": ["f", "$returns"], "severity": "error", "messageIncludes": "Baz" }
        ]
      }
    },
    {
      "description": "a nested $let function's annotations are covered too",
      "module": {
        "main": {
          "$params": [],
          "$returns": { "type": "integer" },
          "$return": {
            "$let": {
              "helper": {
                "$params": [{ "$param": "x", "$type": { "$ref": "#/$defs/Qux" } }],
                "$returns": { "type": "integer" },
                "$return": { "$var": "x" }
              }
            },
            "$in": { "$call": "helper", "$args": [1] }
          }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["main", "$return", "$let", "helper", "$params[0]", "$type"],
            "severity": "error",
            "messageIncludes": "Qux"
          },
          {
            "path": ["main", "$return", "$let", "helper", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" },
            "actual": { "$ref": "#/$defs/Qux" }
          }
        ]
      }
    }
  ]
}
