{
  "$schema": "../../check.schema.json",
  "description": "per-slot parameter and return types, parameter binding, and descriptor validation",
  "builtins": "none",
  "cases": [
    {
      "description": "every normalized parameter kind binds from its aligned signature schema",
      "module": {
        "all": {
          "$params": [
            { "$param": "required", "$type": { "type": "integer" } },
            {
              "$param": "__p1",
              "$type": {
                "type": "object",
                "properties": {
                  "requiredField": { "type": "string" },
                  "optionalField": { "type": "integer" },
                  "defaultedField": { "type": "boolean" }
                },
                "required": ["requiredField"],
                "additionalProperties": false
              }
            },
            { "$param": "optional", "$optional": true, "$type": { "type": "string" } },
            { "$param": "defaulted", "$default": 0, "$type": { "type": "integer" } },
            { "$param": "...rest", "$type": { "type": "array", "items": { "type": "boolean" } } }
          ],
          "$returns": {
            "type": "object",
            "properties": {
              "required": { "type": "integer" },
              "requiredField": { "type": "string" },
              "optionalField": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
              "defaultedField": { "type": "boolean" },
              "optional": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
              "defaulted": { "type": "integer" },
              "rest": { "type": "array", "items": { "type": "boolean" } }
            },
            "required": [
              "required",
              "requiredField",
              "optionalField",
              "defaultedField",
              "optional",
              "defaulted",
              "rest"
            ],
            "additionalProperties": false
          },
          "$return": {
            "$let": {
              "requiredField": { "$get": "requiredField", "$from": { "$var": "__p1" } },
              "optionalField": {
                "$get": "optionalField",
                "$from": { "$var": "__p1" },
                "$else": null
              },
              "defaultedField": {
                "$get": "defaultedField",
                "$from": { "$var": "__p1" },
                "$else": false
              }
            },
            "$in": {
              "required": { "$var": "required" },
              "requiredField": { "$var": "requiredField" },
              "optionalField": { "$var": "optionalField" },
              "defaultedField": { "$var": "defaultedField" },
              "optional": { "$var": "optional" },
              "defaulted": { "$var": "defaulted" },
              "rest": { "$var": "rest" }
            }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "parameter defaults can reference the complete parameter scope",
      "module": {
        "scopedDefault": {
          "$params": [
            { "$param": "seed", "$type": { "type": "integer" } },
            { "$param": "fallback", "$default": { "$var": "seed" }, "$type": { "type": "integer" } }
          ],
          "$returns": { "type": "integer" },
          "$return": { "$var": "fallback" }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "object parameter patterns resolve refs before projecting field types",
      "module": {
        "$types": {
          "Input": {
            "type": "object",
            "properties": { "required": { "type": "integer" }, "optional": { "type": "string" } },
            "required": ["required"],
            "additionalProperties": false
          }
        },
        "read": {
          "$params": [{ "$param": "__p0", "$type": { "$ref": "#/$defs/Input" } }],
          "$returns": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "$return": {
            "$let": {
              "required": { "$get": "required", "$from": { "$var": "__p0" } },
              "optional": { "$get": "optional", "$from": { "$var": "__p0" }, "$else": null }
            },
            "$in": { "$var": "optional" }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "malformed parameters produce one path-specific diagnostic without body cascades",
      "comment": "A descriptor carrying only $param is invalid — the bare name string is the one canonical spelling of a plain required slot. The body is not checked after a parameter error, so the unresolved $var does not cascade.",
      "module": {
        "malformed": {
          "$params": [{ "$param": "value" }],
          "$returns": { "type": "string" },
          "$return": { "$var": "missing" }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["malformed", "$params[0]"],
            "severity": "error",
            "messageIncludes": "$params[0]: A parameter descriptor must carry $optional, $default, or $type"
          }
        ]
      }
    },
    {
      "description": "a named function missing its return annotation is a missing-annotation error",
      "comment": "A named function is fully annotated only when every slot carries $type and $returns is present. Present annotations are still used as declared; the requirement is not configurable.",
      "module": {
        "noReturn": {
          "$params": [{ "$param": "n", "$type": { "type": "integer" } }],
          "$return": { "$var": "n" }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["noReturn"],
            "severity": "error",
            "messageIncludes": "module-level function must declare a signature"
          }
        ]
      }
    },
    {
      "description": "a named function with one untyped slot is a missing-annotation error",
      "module": {
        "oneBare": {
          "$params": [{ "$param": "a", "$type": { "type": "integer" } }, "b"],
          "$returns": { "type": "integer" },
          "$return": { "$var": "a" }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["oneBare"],
            "severity": "error",
            "messageIncludes": "module-level function must declare a signature"
          }
        ]
      }
    },
    {
      "description": "parameter defaults are checked against their slot types before the return",
      "comment": "A $default expression is checked against the slot's $type even when no call omits the slot; each mismatch is reported at its exact path.",
      "module": {
        "badDefaults": {
          "$params": [
            { "$param": "count", "$type": { "type": "integer" } },
            { "$param": "fallback", "$default": "bad positional", "$type": { "type": "integer" } }
          ],
          "$returns": { "type": "integer" },
          "$return": "bad return"
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["badDefaults", "$params[1]", "$default"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" },
            "actual": { "const": "bad positional" }
          },
          {
            "path": ["badDefaults", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" },
            "actual": { "const": "bad return" }
          }
        ]
      }
    },
    {
      "description": "an optional positional binding includes null in its local type",
      "module": {
        "optional": {
          "$params": [{ "$param": "value", "$optional": true, "$type": { "type": "string" } }],
          "$returns": { "type": "string" },
          "$return": { "$var": "value" }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["optional", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "string" },
            "actual": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
          }
        ]
      }
    },
    {
      "description": "a defaulted positional binding keeps the bare slot type",
      "comment": "A defaulted slot always has a value — the default runs on omission — so unlike an optional slot its local type is the slot type itself, without null.",
      "module": {
        "defaulted": {
          "$params": [{ "$param": "value", "$default": "fallback", "$type": { "type": "string" } }],
          "$returns": { "type": "string" },
          "$return": { "$var": "value" }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "lowered pattern projections are checked as ordinary reads against the slot type",
      "comment": "An object pattern is sugar: its lowered projections are ordinary strict reads, so a field the slot schema leaves optional is a bare read of an optional field, rejected with the bare-read error. There is no separate field/schema agreement rule.",
      "module": {
        "$types": {
          "Input": {
            "type": "object",
            "properties": { "value": { "type": "integer" } },
            "required": [],
            "additionalProperties": false
          }
        },
        "lowered": {
          "$params": [{ "$param": "__p0", "$type": { "$ref": "#/$defs/Input" } }],
          "$returns": true,
          "$return": {
            "$let": { "value": { "$get": "value", "$from": { "$var": "__p0" } } },
            "$in": { "$var": "value" }
          }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["lowered", "$return", "$let", "value", "$get"],
            "severity": "error",
            "messageIncludes": "may be absent; add `?? default` or guard with `hasKey`"
          }
        ]
      }
    },
    {
      "description": "a parameter error stops scope-dependent work only for that body",
      "comment": "The malformed descriptor suppresses the broken body's unresolved-variable cascades, and the sibling body is still checked independently.",
      "module": {
        "broken": {
          "$params": [{ "$param": "value" }],
          "$returns": true,
          "$return": { "$array": [{ "$var": "value" }, { "$var": "independentlyMissing" }] }
        },
        "independent": { "$params": [], "$returns": { "type": "integer" }, "$return": "bad return" }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["broken", "$params[0]"],
            "severity": "error",
            "messageIncludes": "$params[0]: A parameter descriptor must carry $optional, $default, or $type"
          },
          {
            "path": ["independent", "$return"],
            "severity": "error",
            "messageIncludes": "not assignable",
            "expected": { "type": "integer" },
            "actual": { "const": "bad return" }
          }
        ]
      }
    }
  ]
}
