{
  "$schema": "../../check.schema.json",
  "description": "realistic chess-program fragments across coordinates, nullable pieces, local bindings, field paths, discriminants, and finite matches",
  "comment": "Realistic checker corpus. Cases intentionally include both focused coordinate checks and their aggregate module check, and model idiomatic authoring: bindings placed where strict $let can safely run them, and explicit boolean guards.",
  "builtins": "standard",
  "cases": [
    {
      "description": "rowOf: floor(idx / 8) : integer",
      "module": {
        "$types": { "Color": { "enum": ["w", "b"] } },
        "rowOf": {
          "$params": [{ "$param": "idx", "$type": { "type": "integer" } }],
          "$returns": { "type": "integer" },
          "$return": {
            "$call": "floor",
            "$args": [{ "$call": "div", "$args": [{ "$var": "idx" }, 8] }]
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "colOf: idx % 8 preserves integer",
      "module": {
        "$types": { "Color": { "enum": ["w", "b"] } },
        "colOf": {
          "$params": [{ "$param": "idx", "$type": { "type": "integer" } }],
          "$returns": { "type": "integer" },
          "$return": { "$call": "mod", "$args": [{ "$var": "idx" }, 8] }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "toIdx: row * 8 + col preserves integer through mul/add",
      "module": {
        "$types": { "Color": { "enum": ["w", "b"] } },
        "toIdx": {
          "$params": [
            { "$param": "row", "$type": { "type": "integer" } },
            { "$param": "col", "$type": { "type": "integer" } }
          ],
          "$returns": { "type": "integer" },
          "$return": {
            "$call": "add",
            "$args": [{ "$call": "mul", "$args": [{ "$var": "row" }, 8] }, { "$var": "col" }]
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "inBounds: a variadic $and of comparisons is boolean",
      "module": {
        "$types": { "Color": { "enum": ["w", "b"] } },
        "inBounds": {
          "$params": [
            { "$param": "row", "$type": { "type": "integer" } },
            { "$param": "col", "$type": { "type": "integer" } }
          ],
          "$returns": { "type": "boolean" },
          "$return": {
            "$and": [
              { "$call": "gte", "$args": [{ "$var": "row" }, 0] },
              { "$call": "lte", "$args": [{ "$var": "row" }, 7] },
              { "$call": "gte", "$args": [{ "$var": "col" }, 0] },
              { "$call": "lte", "$args": [{ "$var": "col" }, 7] }
            ]
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "otherColor: an if over string literals fits the Color enum",
      "module": {
        "$types": { "Color": { "enum": ["w", "b"] } },
        "otherColor": {
          "$params": [{ "$param": "color", "$type": { "$ref": "#/$defs/Color" } }],
          "$returns": { "$ref": "#/$defs/Color" },
          "$return": {
            "$if": { "$call": "eq", "$args": [{ "$var": "color" }, "w"] },
            "$then": "b",
            "$else": "w"
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "the whole coordinate layer checks together, cleanly",
      "module": {
        "$types": { "Color": { "enum": ["w", "b"] } },
        "rowOf": {
          "$params": [{ "$param": "idx", "$type": { "type": "integer" } }],
          "$returns": { "type": "integer" },
          "$return": {
            "$call": "floor",
            "$args": [{ "$call": "div", "$args": [{ "$var": "idx" }, 8] }]
          }
        },
        "colOf": {
          "$params": [{ "$param": "idx", "$type": { "type": "integer" } }],
          "$returns": { "type": "integer" },
          "$return": { "$call": "mod", "$args": [{ "$var": "idx" }, 8] }
        },
        "toIdx": {
          "$params": [
            { "$param": "row", "$type": { "type": "integer" } },
            { "$param": "col", "$type": { "type": "integer" } }
          ],
          "$returns": { "type": "integer" },
          "$return": {
            "$call": "add",
            "$args": [{ "$call": "mul", "$args": [{ "$var": "row" }, 8] }, { "$var": "col" }]
          }
        },
        "inBounds": {
          "$params": [
            { "$param": "row", "$type": { "type": "integer" } },
            { "$param": "col", "$type": { "type": "integer" } }
          ],
          "$returns": { "type": "boolean" },
          "$return": {
            "$and": [
              { "$call": "gte", "$args": [{ "$var": "row" }, 0] },
              { "$call": "lte", "$args": [{ "$var": "row" }, 7] },
              { "$call": "gte", "$args": [{ "$var": "col" }, 0] },
              { "$call": "lte", "$args": [{ "$var": "col" }, 7] }
            ]
          }
        },
        "otherColor": {
          "$params": [{ "$param": "color", "$type": { "$ref": "#/$defs/Color" } }],
          "$returns": { "$ref": "#/$defs/Color" },
          "$return": {
            "$if": { "$call": "eq", "$args": [{ "$var": "color" }, "w"] },
            "$then": "b",
            "$else": "w"
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "isNull accepts a Cell and yields boolean (the guard itself is fine)",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "isEmpty": {
          "$params": [{ "$param": "piece", "$type": { "$ref": "#/$defs/Cell" } }],
          "$returns": { "type": "boolean" },
          "$return": { "$call": "isNull", "$args": [{ "$var": "piece" }] }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "pieceColor: isNull(piece) narrows Cell to Piece in the else-branch",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "pieceColor": {
          "$params": [{ "$param": "piece", "$type": { "$ref": "#/$defs/Cell" } }],
          "$returns": { "anyOf": [{ "$ref": "#/$defs/Color" }, { "type": "null" }] },
          "$return": {
            "$if": { "$call": "isNull", "$args": [{ "$var": "piece" }] },
            "$then": null,
            "$else": {
              "$if": {
                "$call": "eq",
                "$args": [{ "$var": "piece" }, { "$call": "upper", "$args": [{ "$var": "piece" }] }]
              },
              "$then": "w",
              "$else": "b"
            }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "negative narrowing: eq(color, \"w\") excludes the literal on the else-branch",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "afterWhite": {
          "$params": [{ "$param": "color", "$type": { "$ref": "#/$defs/Color" } }],
          "$returns": { "$ref": "#/$defs/Color" },
          "$return": {
            "$if": { "$call": "eq", "$args": [{ "$var": "color" }, "w"] },
            "$then": "b",
            "$else": { "$var": "color" }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "narrowed var feeds a field projection: isNull(sq) guard unlocks sq.file",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "fileOf": {
          "$params": [
            {
              "$param": "sq",
              "$type": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": { "file": { "type": "integer" }, "rank": { "type": "integer" } },
                    "required": ["file", "rank"],
                    "additionalProperties": false
                  },
                  { "type": "null" }
                ]
              }
            }
          ],
          "$returns": { "type": "integer" },
          "$return": {
            "$if": { "$call": "isNull", "$args": [{ "$var": "sq" }] },
            "$then": 0,
            "$else": { "$get": "file", "$from": { "$var": "sq" } }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "makePiece: lower(type) widens the enum to string, losing assignability to Piece",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "makePiece": {
          "$params": [
            { "$param": "color", "$type": { "$ref": "#/$defs/Color" } },
            { "$param": "type", "$type": { "$ref": "#/$defs/PieceType" } }
          ],
          "$returns": { "$ref": "#/$defs/Piece" },
          "$return": {
            "$if": { "$call": "eq", "$args": [{ "$var": "color" }, "w"] },
            "$then": { "$var": "type" },
            "$else": { "$call": "lower", "$args": [{ "$var": "type" }] }
          }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["makePiece", "$return", "$else"],
            "severity": "error",
            "messageIncludes": "not assignable"
          }
        ]
      }
    },
    {
      "description": "a disjoint mismatch stays a hard error (the predicate discriminates)",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "bad": {
          "$params": [{ "$param": "color", "$type": { "$ref": "#/$defs/Color" } }],
          "$returns": { "$ref": "#/$defs/Color" },
          "$return": { "$call": "length", "$args": ["abc"] }
        }
      },
      "expected": {
        "diagnostics": [
          { "path": ["bad", "$return"], "severity": "error", "messageIncludes": "not assignable" }
        ]
      }
    },
    {
      "description": "pieceMoves: bindings over a nullable var live inside the guarded arm",
      "comment": "Strict $let runs every binding, so upper(piece)/lower(piece) belong inside the $else arm rather than above the null guard; the guard's fact (piece: Piece) is in scope for their initializers there.",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "pieceMoves": {
          "$params": [{ "$param": "piece", "$type": { "$ref": "#/$defs/Cell" } }],
          "$returns": { "type": "array", "items": { "type": "string" } },
          "$return": {
            "$if": { "$call": "isNull", "$args": [{ "$var": "piece" }] },
            "$then": [],
            "$else": {
              "$let": {
                "type": { "$call": "upper", "$args": [{ "$var": "piece" }] },
                "color": { "$call": "lower", "$args": [{ "$var": "piece" }] }
              },
              "$in": [{ "$var": "type" }, { "$var": "color" }]
            }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "slideDir: a $cond guarded by named boolean locals narrows the else-arm",
      "comment": "Named-guard composition per narrowing.md: not(ok) follows the alias chain ok -> not(empty) -> isNull(target), and the $cond $else accumulates every condition negated, so target is non-null there and upper(target) checks. Both bindings are boolean-typed (conditions are boolean positions) and strict-safe to evaluate unconditionally.",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "slideDir": {
          "$params": [{ "$param": "target", "$type": { "$ref": "#/$defs/Cell" } }],
          "$returns": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "$return": {
            "$let": {
              "empty": { "$call": "isNull", "$args": [{ "$var": "target" }] },
              "ok": { "$call": "not", "$args": [{ "$var": "empty" }] }
            },
            "$in": {
              "$cond": [
                [{ "$call": "not", "$args": [{ "$var": "ok" }] }, null],
                [{ "$var": "empty" }, null]
              ],
              "$else": { "$call": "upper", "$args": [{ "$var": "target" }] }
            }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "nullable local defaulted through an explicit neq-null guard",
      "comment": "The neq(h, null) conditional is fully typed under exact T | null narrowing: h is string on the then-arm even though its initializer is a call result, because the bare local is itself a narrowing subject.",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "localDefault": {
          "$params": [
            { "$param": "x", "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
          ],
          "$returns": { "type": "string" },
          "$return": {
            "$let": {
              "h": { "$call": "maybe", "$args": [{ "$var": "x" }] },
              "maybe": {
                "$params": [
                  {
                    "$param": "y",
                    "$type": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
                  }
                ],
                "$returns": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                "$return": { "$var": "y" }
              }
            },
            "$in": {
              "$if": { "$call": "neq", "$args": [{ "$var": "h" }, null] },
              "$then": { "$var": "h" },
              "$else": ""
            }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "parseMove: !isNull(from) && !isNull(to) narrows both before object construction",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "parseMove": {
          "$params": [
            { "$param": "from", "$type": { "$ref": "#/$defs/Cell" } },
            { "$param": "to", "$type": { "$ref": "#/$defs/Cell" } }
          ],
          "$returns": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "from": { "$ref": "#/$defs/Piece" },
                  "to": { "$ref": "#/$defs/Piece" }
                },
                "required": ["from", "to"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "$return": {
            "$if": {
              "$and": [
                { "$call": "not", "$args": [{ "$call": "isNull", "$args": [{ "$var": "from" }] }] },
                { "$call": "not", "$args": [{ "$call": "isNull", "$args": [{ "$var": "to" }] }] }
              ]
            },
            "$then": { "from": { "$var": "from" }, "to": { "$var": "to" } },
            "$else": null
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "per-arm divergence: a local re-synthesizes per fact set, with deduplicated diagnostics",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "divergent": {
          "$params": [
            { "$param": "p", "$type": { "$ref": "#/$defs/Color" } },
            { "$param": "q", "$type": { "$ref": "#/$defs/Cell" } }
          ],
          "$returns": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "const": "w" }],
            "items": false,
            "minItems": 2
          },
          "$return": {
            "$let": { "d": [{ "$call": "upper", "$args": [{ "$var": "q" }] }, { "$var": "p" }] },
            "$in": {
              "$match": { "$var": "p" },
              "$cases": [["w", { "$var": "d" }]],
              "$else": { "$var": "d" }
            }
          }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["divergent", "$return", "$in", "$else"],
            "severity": "error",
            "messageIncludes": "not assignable"
          },
          {
            "path": ["divergent", "$return", "$let", "d", "[0]", "$args[0]"],
            "severity": "error",
            "messageIncludes": "not assignable"
          }
        ]
      }
    },
    {
      "description": "fast path: a module with no narrowing is unaffected by the gate and deduplication",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "plain": {
          "$params": [{ "$param": "q", "$type": { "$ref": "#/$defs/Cell" } }],
          "$returns": { "type": "string" },
          "$return": { "$call": "upper", "$args": [{ "$var": "q" }] }
        }
      },
      "expected": {
        "diagnostics": [
          {
            "path": ["plain", "$return", "$args[0]"],
            "severity": "error",
            "messageIncludes": "not assignable"
          }
        ]
      }
    },
    {
      "description": "nullable field: isNull(move.from) narrows the path move.from to Piece in the else-arm",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "firstGlyph": {
          "$params": [
            {
              "$param": "move",
              "$type": {
                "type": "object",
                "properties": {
                  "from": { "$ref": "#/$defs/Cell" },
                  "to": { "$ref": "#/$defs/Cell" }
                },
                "required": ["from", "to"],
                "additionalProperties": false
              }
            }
          ],
          "$returns": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "$return": {
            "$if": {
              "$call": "isNull",
              "$args": [{ "$get": "from", "$from": { "$var": "move" } }]
            },
            "$then": null,
            "$else": {
              "$call": "upper",
              "$args": [{ "$get": "from", "$from": { "$var": "move" } }]
            }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "discriminated union: s.tag == lit narrows s to the matching arm",
      "module": {
        "$types": {
          "Shape": {
            "anyOf": [
              {
                "type": "object",
                "properties": { "tag": { "const": "circle" }, "r": { "type": "integer" } },
                "required": ["tag", "r"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": { "tag": { "const": "square" }, "side": { "type": "integer" } },
                "required": ["tag", "side"],
                "additionalProperties": false
              }
            ]
          }
        },
        "area": {
          "$params": [{ "$param": "s", "$type": { "$ref": "#/$defs/Shape" } }],
          "$returns": { "type": "integer" },
          "$return": {
            "$if": {
              "$call": "eq",
              "$args": [{ "$get": "tag", "$from": { "$var": "s" } }, "circle"]
            },
            "$then": { "$get": "r", "$from": { "$var": "s" } },
            "$else": { "$get": "side", "$from": { "$var": "s" } }
          }
        }
      },
      "expected": { "diagnostics": [] }
    },
    {
      "description": "disjoint field use stays a hard error even after path narrowing",
      "module": {
        "$types": {
          "Color": { "enum": ["w", "b"] },
          "Piece": { "enum": ["K", "Q", "R", "B", "N", "P", "k", "q", "r", "b", "n", "p"] },
          "PieceType": { "enum": ["P", "N", "B", "R", "Q", "K"] },
          "Cell": { "anyOf": [{ "$ref": "#/$defs/Piece" }, { "type": "null" }] }
        },
        "needInt": {
